    "./preloader": "./src/preloader/index.ts",
    "./telemetry": "./src/telemetry/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
