    "@types/react": "^19.2.14",
    "@types/three": "^0.180.0",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.8.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
