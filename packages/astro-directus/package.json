{
  "name": "@astro/directus",
  "version": "3.2.6",
  "description": "Directus Astro integration",
  "keywords": [
    "astro-integration",
    "withastro",
    "directus"
  ],
  "license": "MIT",
  "author": "Aldrin Azucena",
  "exports": {
    ".": "./dist/directus-astro.mjs",
    "./adapter": {
      "import": "./dist/adapters/index.ts",
      "default": "./dist/adapters/index.ts"
    },
    "./module": "./module.d.ts",
    "./visual-editor": {
      "import": "./dist/visual-editor/index.ts",
      "default": "./dist/visual-editor/index.ts"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "src/visual-editor",
    "src/adapters",
    "module.d.ts"
  ],
  "scripts": {
    "build": "rimraf dist && vite build",
    "postbuild": "pnpm copy:visual-editor && pnpm copy:adapters",
    "clean": "rimraf dist && rimraf .turbo && rimraf node_modules",
    "copy:visual-editor": "cp -r src/visual-editor dist/visual-editor",
    "copy:adapters": "cp -r src/adapters dist/adapters",
    "dev": "vite build --watch",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "history": "^5.3.0"
  },
  "devDependencies": {
    "@directus/sdk": "^19.1.0",
    "@directus/types": "^13.1.1",
    "@directus/visual-editing": "^1.1.0",
    "@repo/typescript-config": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/serialize-javascript": "^5.0.4",
    "astro": "^5.4.1",
    "http-proxy-middleware": "^3.0.5",
    "lodash-es": "^4.17.21",
    "serialize-javascript": "^6.0.2",
    "type-fest": "^4.36.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3"
  },
  "peerDependencies": {
    "astro": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0",
    "styled-components": "^6.1.15"
  },
  "engines": {
    "node": ">=18.14.1"
  },
  "publishConfig": {
    "access": "public"
  }
}