{
  "name": "@aazucena/visualizations",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./d3/*": "./src/d3/*.tsx",
    "./intelligence/*": "./src/intelligence/*.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aazucena/types": "workspace:*",
    "@aazucena/utils": "workspace:*",
    "@radix-ui/react-slot": "^1.5.0",
    "d3": "^7.9.2",
    "d3-axis": "^3.0.1",
    "d3-cloud": "^1.2.9",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "d3-time": "^3.1.1",
    "d3-zoom": "^3.0.1",
    "framer-motion": "^14.12.0",
    "react": "^19.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@aazucena/config": "workspace:*",
    "@types/d3": "^7.4.3",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.9.3"
  }
}
