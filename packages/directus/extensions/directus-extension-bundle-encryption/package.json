{
	"name": "directus-extension-bundle-encryption",
	"description": "The Encryption bundle extension provides end-to-end security through PGP (Pretty Good Privacy) alongside other encryption standards, ensuring sensitive data remains protected at rest and in transit.",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "endpoint",
				"name": "pgp",
				"source": "src/pgp/index.ts"
			},
			{
				"type": "module",
				"name": "encryption-module",
				"source": "src/encryption-module/index.ts"
			},
			{
				"type": "hook",
				"name": "pgp-hook",
				"source": "src/pgp-hook/index.ts"
			}
		],
		"host": "^10.10.0",
		"sandbox": {
			"enabled": true,
			"requestedScopes": {}
		}
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"devDependencies": {
		"@directus/api": "^23.1.3",
		"@directus/errors": "^1.0.1",
		"@directus/extensions": "^2.0.5",
		"@directus/extensions-sdk": "11.0.9",
		"@directus/types": "^12.2.2",
		"@types/express": "^5.0.0",
		"@types/node": "^22.13.10",
		"express": "^4.21.1",
		"openpgp": "^6.0.1",
		"typescript": "^5.8.2",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0"
	},
	"dependencies": {
		"vue-i18n": "^9.13.1"
	}
}
