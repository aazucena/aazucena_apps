{
  "name": "@aazucena/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "exports": {
    "./eslint/base.js": "./src/eslint/base.js",
    "./eslint/next.js": "./src/eslint/next.js",
    "./eslint/nextjs.js": "./src/eslint/nextjs.js",
    "./eslint/react.js": "./src/eslint/react.js",
    "./eslint/library.js": "./src/eslint/library.js",
    "./eslint/astro.js": "./src/eslint/astro.js",
    "./prettier/*": "./src/prettier/*",
    "./tsconfig/*": "./src/tsconfig/*",
    "./playwright/base": "./src/playwright/base.ts",
    "./playwright/factory": "./src/playwright/factory.ts",
    "./postcss/*": "./src/postcss/*",
    "./sentry/client": "./src/sentry/client.ts",
    "./sentry/server": "./src/sentry/server.ts",
    "./sentry/nextjs": "./src/sentry/nextjs.ts",
    "./vercel/*": "./src/vercel/*"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sentry/astro": "^10.28.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vercel/style-guide": "^6.0.0",
    "astro-eslint-parser": "^1.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.11.10",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
