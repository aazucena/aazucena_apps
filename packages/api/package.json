{
  "name": "@aazucena/api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./modules/*": "./src/modules/*.ts",
    "./controllers/*": "./src/controllers/*.ts",
    "./services/*": "./src/services/*.ts",
    "./validators/*": "./src/validators/*.ts",
    "./transformers/*": "./src/transformers/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aazucena/constants": "workspace:*",
    "@aazucena/types": "workspace:*",
    "@aazucena/utils": "workspace:*",
    "@ai-sdk/gateway": "^4.0.142",
    "@ai-sdk/react": "^4.0.173",
    "@clickhouse/client": "^1.25.0",
    "@clickhouse/client-web": "^0.3.1",
    "@tanstack/react-query": "^5.107.1",
    "ai": "^7.0.169",
    "qs": "^6.17.1",
    "socket.io-client": "^4.8.4",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aazucena/config": "workspace:*",
    "@types/qs": "^6.15.1",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}
