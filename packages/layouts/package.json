{
  "name": "@aazucena/layouts",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aazucena/ui": "workspace:*",
    "@aazucena/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^14.12.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@aazucena/config": "workspace:*",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "sideEffects": false
}
