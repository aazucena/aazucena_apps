# ==============================================================================
# AZUCENA_LYTICS // Analytics Dashboard Environment Variables
# ==============================================================================
# Deployed to: Vercel (apps/analytics project)
# ClickHouse:  Railway
# ==============================================================================

# === ClickHouse Database (Server-Side Only) ===
# Set CLICKHOUSE_HOST to your Railway ClickHouse HTTP URL in production
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics

# DASHBOARD VIEWER — read-only, used by all stats/query routes
# Must match the password set via: ALTER USER dashboard_viewer IDENTIFIED WITH sha256_password BY '...'
CLICKHOUSE_VIEWER_USER=dashboard_viewer
CLICKHOUSE_VIEWER_PASSWORD=

# TELEMETRY INGEST — write-only, used by /api/ingest and /api/webhooks/*
# Must match the password set via: ALTER USER telemetry_ingest IDENTIFIED WITH sha256_password BY '...'
CLICKHOUSE_INGEST_USER=telemetry_ingest
CLICKHOUSE_INGEST_PASSWORD=

# Admin credentials (Railway env vars only — never set on Vercel)
# Used for migrations only (scripts/03_rbac_security.sql, etc.)
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=

# === Ingestion Security ===
# Secret key validating ingest requests from Portfolio and internal self-telemetry.
# Must match:
#   → Portfolio: PUBLIC_INGESTION_SECRET_KEY (browser PageViewTracker)
#   → Portfolio: ANALYTICS_INGEST_SECRET (server-side Astro actions)
# Generate: openssl rand -hex 32
INGESTION_SECRET_KEY=

# === Self-Telemetry (Analytics Dashboard → itself) ===
# The dashboard tracks its own AI terminal usage by POSTing to its own /api/ingest.
# NEXT_PUBLIC_ANALYTICS_API_URL — base URL of this deployed dashboard (no trailing slash)
#   → used by TelemetryProvider (client-side) and IntegrityBadge
# ANALYTICS_SECRET_KEY — secret for the TelemetryProvider context (same value as INGESTION_SECRET_KEY)
# INTERNAL_INGEST_URL  — full URL to /api/ingest for server-side AI telemetry (onFinish callback)
#   → In production: https://your-analytics-domain.com/api/ingest
#   → In local dev:  http://localhost:3000/api/ingest
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:3000
ANALYTICS_SECRET_KEY=
INTERNAL_INGEST_URL=http://localhost:3000/api/ingest

# === Dashboard Auth ===
# Password-protect the dashboard login screen.
# ADMIN_PASSWORD — the password entered on the login overlay
# ADMIN_SECRET   — the session cookie value set after successful login
# Generate both: openssl rand -hex 32
ADMIN_SECRET=
ADMIN_PASSWORD=

# === Public Dashboard Config ===
# NEXT_PUBLIC_APP_VERSION — auto-injected from package.json at build time via next.config.ts
#   Do NOT set this in Vercel env vars — it will be overridden by the build anyway.
# NEXT_PUBLIC_WS_SERVER   — WebSocket server URL for live mode (optional)
NEXT_PUBLIC_WS_SERVER=http://localhost:3001

# === WebSocket Bridge (Optional — live mode) ===
# WS_URL            — internal URL the ingest route broadcasts events to
# WS_INTERNAL_SECRET — shared secret between /api/ingest and the WS server
WS_URL=
WS_INTERNAL_SECRET=

# === Vercel AI Gateway ===
# Route LLM calls through Vercel's AI Gateway for observability + model fallbacks.
# Get API key from: https://vercel.com/dashboard → AI Gateway
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=

# === LangChain / LangSmith (Optional) ===
# Enable tracing for LangChain/LangGraph pipelines.
# Get API key from: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aazucena-analytics

# === Vercel Log Drain (Traffic Center) ===
# Vercel POSTs HTTP access logs to /api/webhooks/vercel.
# Configure the drain in: Vercel Dashboard → portfolio project → Settings → Log Drains
# VERCEL_LOG_DRAIN_SECRET — HMAC-SHA1 secret to verify Vercel's x-vercel-signature header.
# Generate: openssl rand -hex 32
VERCEL_LOG_DRAIN_SECRET=

# === Webhook Secrets ===
# STRIPE_WEBHOOK_SECRET — from Stripe Dashboard → Webhooks → your endpoint
# KOFI_WEBHOOK_SECRET   — from Ko-fi → Settings → Webhooks → Verification Token
# SENTRY_WEBHOOK_SECRET — from Sentry → Settings → Integrations → Internal Integrations
STRIPE_WEBHOOK_SECRET=
KOFI_WEBHOOK_SECRET=
SENTRY_WEBHOOK_SECRET=

# === Plausible Analytics (Optional — self-hosted) ===
# ClickHouse connection for Plausible's own database (separate from the analytics DB)
PLAUSIBLE_CLICKHOUSE_HOST=http://aazucena-plausible-clickhouse:8123
PLAUSIBLE_CLICKHOUSE_DB=plausible_events_db
PLAUSIBLE_CLICKHOUSE_USER=default
PLAUSIBLE_CLICKHOUSE_PASSWORD=

# === Strapi CMS (Optional) ===
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# === Email (Resend) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aldrin Azucena <hello@aazucena.com>
