# === Database Connection (Server-Side Only) ===
# In local dev, Docker maps port 8123 to localhost
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics

# DASHBOARD VIEWER (Read-only for stats)
CLICKHOUSE_VIEWER_USER=dashboard_viewer
CLICKHOUSE_VIEWER_PASSWORD=viewer_secure_horizon_2026

# TELEMETRY INGEST (Write-only for events)
CLICKHOUSE_INGEST_USER=telemetry_ingest
CLICKHOUSE_INGEST_PASSWORD=ingest_secret_pulse_2026

# Legacy admin (only for migrations)
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=clickhouse
# === Security ===
# Optional: A shared secret key to validate requests coming from your Portfolio
# (You check this in your /api/ingest route)
INGESTION_SECRET_KEY=long_random_string_here
# === Public Config (Client-Side) ===
# URL for the UI to fetch its own internal stats API
PORT=8080
NEXT_PUBLIC_API_HOST=http://localhost:8080
NEXT_PUBLIC_API_ENDPOINT=/api

PLAUSIBLE_API_HOST=
PLAUSIBLE_API_TOKEN=

SENTRY_URL=https://sentry.io/
SENTRY_ORG=
SENTRY_AUTH_TOKEN=

PLAUSIBLE_CLICKHOUSE_HOST=http://aazucena-plausible-clickhouse:8123
PLAUSIBLE_CLICKHOUSE_DB=plausible_events_db
PLAUSIBLE_CLICKHOUSE_USER=default
PLAUSIBLE_CLICKHOUSE_PASSWORD=

WS_URL=

NEXT_PUBLIC_WS_SERVER=http://localhost:3001

WS_INTERNAL_SECRET=



# === Vercel AI Gateway ===

AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

AI_GATEWAY_API_KEY=your_vercel_gateway_api_key


# === LangChain / LangSmith ===

LANGCHAIN_TRACING_V2=true

LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

LANGCHAIN_API_KEY=ls__your_langsmith_api_key

LANGCHAIN_PROJECT=aazucena-analytics

# === Vercel Analytics Ingestion ===
VERCEL_API_TOKEN=your_vercel_api_token
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_team_id_if_applicable

# Vercel Log Drain (Web Analytics)
VERCEL_LOG_DRAIN_SECRET=your_vercel_log_drain_secret

# === Financial Webhooks ===
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_secret
KOFI_WEBHOOK_SECRET=your_kofi_verification_token

# === Strapi CMS ===
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token
