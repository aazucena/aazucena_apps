# === Database Connection (Server-Side Only) ===
# In local dev, Docker maps port 8123 to localhost
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=clickhouse
# === Security ===
# Optional: A shared secret key to validate requests coming from your Portfolio
# (You check this in your /api/ingest route)
INGESTION_SECRET_KEY=long_random_string_here
# === Public Config (Client-Side) ===
# URL for the UI to fetch its own internal stats API
PORT=8080
NEXT_PUBLIC_API_HOST=http://localhost:8080
NEXT_PUBLIC_API_ENDPOINT=/api