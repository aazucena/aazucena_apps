# Production Environment Variables for Railway Deployment
# Copy these to your Railway project's environment variables section

# ============================================================================
# STRAPI CONFIGURATION
# ============================================================================

# Node Environment
NODE_ENV=production

# Host and Port (Railway provides PORT automatically)
HOST=0.0.0.0
PORT=${PORT}

# App Keys (IMPORTANT: Generate new keys for production!)
# Generate with: openssl rand -base64 32
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme5
ADMIN_JWT_SECRET=changeme6
TRANSFER_TOKEN_SALT=changeme7
JWT_SECRET=changeme8

# ============================================================================
# DATABASE CONFIGURATION (Railway PostgreSQL)
# ============================================================================
# Railway provides these automatically when you add PostgreSQL service
DATABASE_CLIENT=postgres
DATABASE_HOST=${PGHOST}
DATABASE_PORT=${PGPORT}
DATABASE_NAME=${PGDATABASE}
DATABASE_USERNAME=${PGUSER}
DATABASE_PASSWORD=${PGPASSWORD}
DATABASE_SSL=true

# Connection Pool Settings
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

# ============================================================================
# CLOUDINARY CONFIGURATION
# ============================================================================
# Get from: https://cloudinary.com/console
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=

# ============================================================================
# CORS & SECURITY
# ============================================================================
# Your frontend URL (Vercel deployment)
ALLOWED_ORIGINS=https://your-domain.vercel.app,https://www.your-domain.com

# Admin Panel URL (optional, for custom domain)
ADMIN_URL=/admin

# ============================================================================
# OPTIONAL: SENTRY ERROR TRACKING
# ============================================================================
SENTRY_DSN=your_sentry_dsn

# ============================================================================
# OPTIONAL: REDIS (if using Railway Redis add-on)
# ============================================================================
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# ============================================================================
# STRAPI PLUGINS
# ============================================================================
# Documentation plugin
DOCUMENTATION_ENABLED=true

# GraphQL plugin
GRAPHQL_ENABLED=true
GRAPHQL_PLAYGROUND=false
GRAPHQL_DEPTH_LIMIT=10

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# MONITORING & LOGS
# ============================================================================
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info


# ============================================================================
# DATA TRANSFER CONFIGURATION
# ============================================================================
# Enable remote data transfer (required for strapi transfer command)
STRAPI_TRANSFER_REMOTE_ENABLED=true

# Transfer token (generated in Strapi admin: Settings > Transfer Tokens)
STRAPI_TRANSFER_TOKEN=

# Transfer URL (your Railway Strapi URL)
STRAPI_TRANSFER_URL=