# ==============================================================================
# Production-Optimized Multi-Stage Dockerfile for Strapi v5
# ==============================================================================
# Benefits:
# - Smaller image size (~300MB vs ~800MB for development)
# - Faster deployments (pre-built admin panel)
# - Security hardened (non-root user, minimal dependencies)
# - Optimized for Railway deployment via CircleCI
# ==============================================================================

# ==============================================================================
# Stage 1: Dependencies
# ==============================================================================
FROM node:22-alpine AS dependencies

LABEL maintainer="Aldrin Azucena"
LABEL description="Strapi v5 CMS - Dependencies Stage"

# Install build dependencies as root
RUN apk update && apk add --no-cache \
    build-base \
    gcc \
    autoconf \
    automake \
    zlib-dev \
    libpng-dev \
    nasm \
    bash \
    vips-dev \
    git \
    python3

# Install pnpm globally (pinned to match packageManager field)
RUN npm install -g pnpm@10.33.4 node-gyp

WORKDIR /app
RUN chown node:node /app

# Switch to non-root user
USER node

# Copy package files with correct ownership
COPY --chown=node:node package.json pnpm-lock.yaml ./

# Install ALL dependencies as node user
RUN pnpm config set fetch-retry-maxtimeout 600000 && \
    pnpm install --frozen-lockfile

# ==============================================================================
# Stage 2: Builder
# ==============================================================================
FROM node:22-alpine AS builder

LABEL description="Strapi v5 CMS - Build Stage"

# Install runtime dependencies needed for build
RUN apk update && apk add --no-cache vips-dev

# Install pnpm for build command (pinned)
RUN npm install -g pnpm@10.33.4

WORKDIR /app
RUN chown node:node /app

# Switch to node user
USER node

# Copy dependencies and source with correct ownership
COPY --chown=node:node --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node . .

# Build Strapi admin panel
ENV NODE_ENV=production
ENV NODE_OPTIONS=--max_old_space_size=4096
RUN pnpm build

# ==============================================================================
# Stage 3: Production Runtime
# ==============================================================================
FROM node:22-alpine AS production

LABEL description="Strapi v5 CMS - Production Runtime"
LABEL version="5.45.0"

# Install runtime dependencies (no build tools)
RUN apk update && apk add --no-cache \
    vips \
    vips-cpp \
    dumb-init

# Install pnpm globally (pinned)
RUN npm install -g pnpm@10.33.4

WORKDIR /app
RUN chown node:node /app

# Switch to node user for installation and runtime
USER node

# Copy package metadata (needed by pnpm prune)
COPY --chown=node:node package.json pnpm-lock.yaml ./

# Copy already-compiled node_modules from Stage 1 — avoids recompiling native
# modules (sharp, vips bindings) without build tools in this minimal stage.
# .pnpm/ virtual store lives inside node_modules, so pnpm prune works in-place.
COPY --chown=node:node --from=dependencies /app/node_modules ./node_modules

# Strip dev dependencies without recompiling (directory removal only)
RUN pnpm prune --prod

# Copy built application from builder stage
COPY --chown=node:node --from=builder /app/.strapi ./.strapi
COPY --chown=node:node --from=builder /app/public ./public
COPY --chown=node:node --from=builder /app/favicon.png ./favicon.png

# Copy COMPILED JavaScript files from dist/
COPY --chown=node:node --from=builder /app/dist/config ./config
COPY --chown=node:node --from=builder /app/dist/src ./src

# Copy database directory
COPY --chown=node:node --from=builder /app/database ./database

# Create uploads directory (now as node user)
RUN mkdir -p public/uploads

# Environment variables
ENV NODE_ENV=production
ENV NODE_OPTIONS=--max_old_space_size=4096

# Expose Strapi port
EXPOSE 1337

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:1337/_health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use dumb-init
ENTRYPOINT ["dumb-init", "--"]

# Start Strapi in production mode
CMD ["pnpm", "start"]
