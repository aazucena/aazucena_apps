# ==============================================================================
# Backend Environment Variables (Strapi CMS)
# ==============================================================================
# Deployed to: Railway
# Purpose: Server-side configuration for Strapi CMS
# Security: Never expose these variables to frontend
# Local Dev: Uses docker-compose.yml with default credentials
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Secrets (generate secure random strings for production)
# Generate with: openssl rand -base64 32
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database Configuration
# Local Development: Uses docker-compose.yml defaults (clickhouse/clickhouse/clickhouse)
# Production: Override with strong credentials
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# ClickHouse Connection (via host-mapped ports)
# Local Development: Uses docker-compose.yml defaults (strapi/strapi/strapi)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=analytics


# ⚠️ PRODUCTION WARNING:
# For production deployments, you MUST set strong passwords:
# DATABASE_PASSWORD=<strong_random_password>
# REDIS_PASSWORD=<strong_random_password>
# Generate with: openssl rand -base64 32

# Cloudinary Configuration (Optional - for media uploads)
# Sign up at https://cloudinary.com to get credentials
# CLOUDINARY_NAME=your_cloudinary_name
# CLOUDINARY_KEY=your_cloudinary_api_key
# CLOUDINARY_SECRET=your_cloudinary_api_secret

# Allowed Origins (CORS)
# ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

REDIS_HOST=redis
REDIS_PORT=6379
# Local Development: Empty password allowed
# Production: Set strong password (required)
REDIS_PASSWORD=

ICON_LIST=
ICON_PKG_MANAGER=npm
ICON_PUBLIC_DIR=./public/icons
ICON_SRC=icons

PLAUSIBLE_BASE_URL=http://localhost:8000
PLAUSIBLE_SECRET_KEY_BASE=

PLAUSIBLE_CLICKHOUSE_HOST=http://aazucena-plausible-clickhouse:8123
PLAUSIBLE_CLICKHOUSE_DB=plausible_events_db
PLAUSIBLE_CLICKHOUSE_USER=default
PLAUSIBLE_CLICKHOUSE_PASSWORD=

WS_PORT=3001
WS_INTERNAL_SECRET=
INGESTION_SECRET_KEY=

# === Vercel AI Gateway ===
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=

# === LangChain / LangSmith ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aazucena-intel-engine

VOYAGE_API_KEY=

ANTHROPIC_API_KEY=

VERCEL_OIDC_TOKEN=