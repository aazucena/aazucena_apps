{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "engineering",
        "consulting",
        "design",
        "ai",
        "analytics",
        "tutoring",
        "devops",
        "creative",
        "research"
      ]
    },
    "shortDescription": {
      "type": "text",
      "required": false
    },
    "description": {
      "type": "richtext"
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icons-field.icon",
      "options": {
        "outputFormat": "svg"
      }
    },
    "features": {
      "type": "customField",
      "customField": "plugin::strapi-plugin-sortable-list.sortable-list"
    },
    "price": {
      "type": "string"
    },
    "cta": {
      "type": "component",
      "component": "ui.cta-button",
      "repeatable": false
    },
    "sort": {
      "type": "integer",
      "default": 1,
      "min": 1
    }
  }
}
