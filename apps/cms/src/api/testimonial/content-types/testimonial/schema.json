{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "Client and colleague testimonials"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "author": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "authorTitle": {
      "type": "string",
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "company": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "content": {
      "type": "text",
      "required": true,
      "maxLength": 1000,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "rating": {
      "type": "integer",
      "required": true,
      "default": 5,
      "min": 1,
      "max": 5,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "relationship": {
      "type": "enumeration",
      "enum": [
        "Client",
        "Colleague",
        "Manager",
        "Mentee",
        "Collaborator",
        "Other"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "approvalStatus": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "approvedBy": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "approvedAt": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "rejectionReason": {
      "type": "text",
      "maxLength": 500,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "submittedAt": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "authorEmail": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "authorLinkedIn": {
      "type": "string",
      "maxLength": 255,
      "regex": "^https?://(www\\.)?linkedin\\.com/.*",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "contentEmbedding": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "aiSentiment": {
      "type": "enumeration",
      "enum": [
        "Very Positive",
        "Positive",
        "Neutral",
        "Negative",
        "Very Negative"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "aiTags": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "projectRelated": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "testimonials"
    }
  }
}
