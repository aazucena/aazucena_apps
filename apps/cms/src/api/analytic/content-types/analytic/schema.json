{
  "kind": "singleType",
  "collectionName": "analytics",
  "info": {
    "singularName": "analytic",
    "pluralName": "analytics",
    "displayName": "Analytics & Monitoring"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "googleAnalyticsEnabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "googleAnalyticsId": {
      "type": "string",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "googleAnalyticsEnabled"
            },
            false
          ]
        }
      },
      "maxLength": 50,
      "required": true,
      "regex": "^(G|UA|GTM)-.*"
    },
    "vercelAnalyticsEnabled": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "vercelSpeedInsightsEnabled": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "plausibleEnabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "plausibleDomain": {
      "type": "string",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "plausibleEnabled"
            },
            false
          ]
        }
      },
      "maxLength": 200,
      "required": true
    },
    "sentryEnabled": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
