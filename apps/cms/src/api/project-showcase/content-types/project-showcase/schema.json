{
  "kind": "singleType",
  "collectionName": "project_showcases",
  "info": {
    "singularName": "project-showcase",
    "pluralName": "project-showcases",
    "displayName": "Project Showcase Configuration"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "header": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.page-header",
      "repeatable": false
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Projects",
      "required": true
    },
    "searchPlaceholder": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Search projects by tech, title..."
    },
    "dragHintText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Drag to explore more projects",
      "maxLength": 100,
      "required": true
    },
    "viewMoreButtonLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "View More",
      "maxLength": 50,
      "required": true
    },
    "viewMoreButtonSubtitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Explore all projects",
      "maxLength": 100,
      "required": true
    },
    "maxProjectsDisplayed": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "default": 7,
      "min": 1,
      "max": 20
    },
    "projectsPerPage": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "default": 4,
      "min": 1,
      "max": 8
    },
    "listPagePath": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "default": "projects",
      "maxLength": 200,
      "required": false
    }
  }
}
