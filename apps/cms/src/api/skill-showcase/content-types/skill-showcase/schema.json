{
  "kind": "singleType",
  "collectionName": "skill_showcases",
  "info": {
    "singularName": "skill-showcase",
    "pluralName": "skill-showcases",
    "displayName": "Skill Showcase Configuration",
    "description": "Manages the skills list page and homepage section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "header": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.page-header",
      "repeatable": false
    },
    "highlyUsedThreshold": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "default": 3
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Skills",
      "required": true
    },
    "searchPlaceholder": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Search technologies (e.g. React, PostgreSQL)..."
    },
    "emptyMessage": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "No technologies found matching your criteria."
    },
    "taxonomyPagePath": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "skills"
    }
  }
}
