{
  "kind": "collectionType",
  "collectionName": "compositions",
  "info": {
    "singularName": "composition",
    "pluralName": "compositions",
    "displayName": "Composition",
    "description": "Music compositions and tracks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "audioFile": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["audios"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "coverArt": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "audioMetadata": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "media.audio-metadata",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "genres": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::music-genre.music-genre",
      "inversedBy": "compositions"
    },
    "releaseDate": {
      "type": "date",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "playCount": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "downloadCount": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isFreeDownload": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hasLyrics": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "lyrics": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "spotifyUrl": {
      "type": "string",
      "maxLength": 255,
      "regex": "^https?://open\\.spotify\\.com/.*",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "soundcloudUrl": {
      "type": "string",
      "maxLength": 255,
      "regex": "^https?://soundcloud\\.com/.*",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "youtubeUrl": {
      "type": "string",
      "maxLength": 255,
      "regex": "^https?://(www\\.)?youtube\\.com/.*",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "collaborators": {
      "type": "text",
      "maxLength": 255,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
