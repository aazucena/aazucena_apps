{
  "kind": "collectionType",
  "collectionName": "skill_categories",
  "info": {
    "singularName": "skill-category",
    "pluralName": "skill-categories",
    "displayName": "Skill Category",
    "description": "Categories for organizing skills (Frontend, Backend, etc.)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 50,
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9-]+$"
    },
    "label": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icons-field.icon",
      "options": {
        "selection": []
      }
    },
    "display": {
      "type": "enumeration",
      "required": false,
      "default": "visible",
      "enum": [
        "hidden",
        "visible"
      ]
    },
    "variant": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "cyan-blue",
        "purple-pink",
        "green-emerald",
        "blue-indigo",
        "yellow-orange",
        "pink-red",
        "teal-cyan",
        "orange-red",
        "violet-purple",
        "indigo-violet"
      ]
    },
    "skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::skill.skill",
      "mappedBy": "category"
    }
  }
}
