{
  "kind": "collectionType",
  "collectionName": "experiences",
  "info": {
    "singularName": "experience",
    "pluralName": "experiences",
    "displayName": "Experience",
    "description": "Work experience and employment history"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "company": {
      "type": "string",
      "required": true,
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "position": {
      "type": "string",
      "required": true,
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "companyLogo": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "ui.image-element",
      "repeatable": false
    },
    "industry": {
      "type": "enumeration",
      "enum": [
        "Technology",
        "Finance",
        "Healthcare",
        "Education",
        "Entertainment",
        "Retail",
        "Manufacturing",
        "Government",
        "Non-Profit",
        "Startup",
        "Other"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "companySize": {
      "type": "enumeration",
      "enum": [
        "Just getting started (1-10)",
        "A small but mighty team (11-50)",
        "A growing company (51-200)",
        "A mid-size organization (201-500)",
        "A large organization (501-1,000)",
        "A big enterprise (1,001-5,000)",
        "A global-scale enterprise (5,000+)"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "location": {
      "type": "string",
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "startDate": {
      "type": "date",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "endDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isCurrent": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "richtext",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "highlights": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "employmentType": {
      "type": "enumeration",
      "enum": [
        "Full-time",
        "Part-time",
        "Contract",
        "Freelance",
        "Internship",
        "Co-op"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "companyWebsite": {
      "type": "string",
      "maxLength": 255,
      "regex": "^https?://.*",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sort": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "skillsUsed": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::skill.skill",
      "inversedBy": "experiences"
    },
    "projectsCompleted": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project"
    },
    "achievements": {
      "type": "component",
      "repeatable": true,
      "component": "content.achievement",
      "min": 0,
      "max": 10,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
