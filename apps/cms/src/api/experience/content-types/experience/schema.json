{
  "kind": "collectionType",
  "collectionName": "experiences",
  "info": {
    "singularName": "experience",
    "pluralName": "experiences",
    "displayName": "Experience",
    "description": "Work experience and employment history"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "company": {
      "type": "string",
      "required": true,
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "position": {
      "type": "string",
      "required": true,
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "companyLogo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "companyLogoAlt": {
      "type": "string",
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "companyIndustry": {
      "type": "enumeration",
      "enum": [
        "Technology",
        "Finance",
        "Healthcare",
        "Education",
        "Entertainment",
        "Retail",
        "Manufacturing",
        "Government",
        "Non-Profit",
        "Startup",
        "Other"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "companySize": {
      "type": "enumeration",
      "enum": [
        "Employees 1-10",
        "Employees 11-50",
        "Employees 51-200",
        "Employees 201-500",
        "Employees 501-1000",
        "Employees 1001-5000",
        "Employees 5000+"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "location": {
      "type": "string",
      "maxLength": 150,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "startDate": {
      "type": "date",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "endDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isCurrent": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "richtext",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "highlights": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "employmentType": {
      "type": "enumeration",
      "enum": [
        "Full-time",
        "Part-time",
        "Contract",
        "Freelance",
        "Internship"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "companyWebsite": {
      "type": "string",
      "maxLength": 255,
      "regex": "^https?://.*",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "skillsUsed": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::skill.skill",
      "inversedBy": "experiences"
    },
    "projectsCompleted": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project"
    },
    "achievements": {
      "type": "component",
      "repeatable": true,
      "component": "content.achievement",
      "min": 0,
      "max": 10,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
