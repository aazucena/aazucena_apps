{
  "kind": "collectionType",
  "collectionName": "skills",
  "info": {
    "singularName": "skill",
    "pluralName": "skills",
    "displayName": "Skill",
    "description": "Technical skills and expertise"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 100,
      "required": true,
      "unique": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::skill-category.skill-category",
      "inversedBy": "skills"
    },
    "display": {
      "type": "enumeration",
      "required": true,
      "default": "standard",
      "enum": [
        "hidden",
        "standard",
        "featured",
        "core"
      ]
    },
    "proficiency": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "learning",
        "competent",
        "proficient",
        "expert"
      ]
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icons-field.icon",
      "options": {
        "selection": []
      }
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "yearsOfExperience": {
      "type": "decimal",
      "min": 0,
      "max": 50
    },
    "documentationUrl": {
      "type": "string",
      "maxLength": 2048,
      "regex": "^https?://[a-zA-Z0-9-.]+(\\\\.[a-zA-Z]{2,})?(/.*)?$"
    },
    "sort": {
      "type": "integer",
      "default": 0
    },
    "lastUsed": {
      "type": "date"
    },
    "experiences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::experience.experience",
      "mappedBy": "skillsUsed"
    },
    "education": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::education.education",
      "mappedBy": "skills"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "mappedBy": "techStack"
    }
  }
}
