{
  "kind": "collectionType",
  "collectionName": "knowledge_items",
  "info": {
    "singularName": "knowledge-item",
    "pluralName": "knowledge-items",
    "displayName": "Knowledge Item",
    "description": "Vectorized knowledge chunks for the Internal Knowledge Base"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "source": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "docs",
        "code",
        "user_upload",
        "telemetry_insight"
      ],
      "default": "docs"
    },
    "tags": {
      "type": "component",
      "component": "ui.tag",
      "repeatable": true
    },
    "metadata": {
      "type": "json"
    }
  }
}