{
  "kind": "singleType",
  "collectionName": "portfolios",
  "info": {
    "singularName": "portfolio",
    "pluralName": "portfolios",
    "displayName": "Portfolio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "maxLength": 100,
      "required": true
    },
    "occupation": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 200,
      "required": true
    },
    "profileImage": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "component": "ui.image-element",
      "repeatable": false
    },
    "resumeFile": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "bio": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "email": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true
    },
    "phone": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "customField": "plugin::strapi-phone-validator-5.phone",
      "options": {
        "country": "ca"
      }
    },
    "preferredContactMethod": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::advanced-fields.checkbox",
      "options": {
        "checkboxType": "multiple",
        "minChoices": 1,
        "maxChoices": 0,
        "layout": "vertical",
        "checkboxOptions": "email|Email\nphone|Phone\nsms|SMS\nsocial-media|Social Media\nlinkedin|LinkedIn\ngithub|Github\nchat|Work Chat (Slack / Microsoft Teams)\nvideo|Video Conferencing (Zoom / Jitsi / Google Meet / Teams)\nforms|Website Contact Forms\nmessenger|Messaging Apps (WhatsApp / Facebook Messenger / Telegram / Signal)",
        "defaultSelected": "email"
      },
      "required": true
    },
    "socialLinks": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "component": "shared.social-links",
      "repeatable": true,
      "required": true,
      "min": 0
    },
    "yearsOfExperience": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "min": 0,
      "max": 50
    },
    "location": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "maxLength": 100
    },
    "education": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "content.education",
      "repeatable": true,
      "required": false,
      "min": 0,
      "max": 10
    },
    "bioEmbedding": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "bioEmbeddingModel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "maxLength": 50
    },
    "bioEmbeddingGeneratedAt": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
