{
  "collectionName": "components_ui_cta_buttons",
  "info": {
    "displayName": "CTA Button",
    "icon": "cursor"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "maxLength": 50,
      "required": true
    },
    "url": {
      "type": "string",
      "maxLength": 255,
      "required": true,
      "regex": "^(https?://.*|/.*|#.*)"
    },
    "variant": {
      "type": "enumeration",
      "default": "primary",
      "enum": [
        "primary",
        "secondary",
        "outline",
        "ghost"
      ]
    },
    "size": {
      "type": "enumeration",
      "default": "md",
      "enum": [
        "sm",
        "md",
        "lg"
      ]
    },
    "openInNewTab": {
      "type": "boolean",
      "default": true
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icons-field.icon",
      "options": {
        "selection": []
      }
    }
  },
  "config": {}
}
