{
  "collectionName": "components_content_educations",
  "info": {
    "displayName": "Education",
    "icon": "pencil"
  },
  "options": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "diploma",
        "bachelor",
        "master",
        "doctorate",
        "certificate"
      ]
    },
    "degree": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "field": {
      "type": "string",
      "maxLength": 150,
      "required": true
    },
    "institution": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "graduationDate": {
      "type": "date",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "current"
            },
            false
          ]
        }
      }
    },
    "current": {
      "type": "boolean",
      "required": true
    },
    "location": {
      "type": "string",
      "maxLength": 200
    },
    "gpa": {
      "type": "decimal",
      "min": 0,
      "max": 5
    },
    "description": {
      "type": "richtext",
      "maxLength": 1000
    },
    "honors": {
      "type": "string",
      "maxLength": 200
    }
  },
  "config": {}
}
