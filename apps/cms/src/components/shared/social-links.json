{
  "collectionName": "components_shared_social_links",
  "info": {
    "displayName": "Social Links",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "platform": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "GitHub",
        "LinkedIn",
        "Twitter",
        "YouTube",
        "Instagram",
        "Other"
      ]
    },
    "url": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icons-field.icon",
      "options": {
        "preset": "icons"
      },
      "required": false,
      "displayName": "Platform Icon"
    },
    "text": {
      "type": "string",
      "required": false
    },
    "openInNewTab": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  },
  "config": {}
}
