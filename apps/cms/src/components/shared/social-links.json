{
  "collectionName": "components_shared_social_links",
  "info": {
    "displayName": "Social Links",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "platform": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "GitHub",
        "LinkedIn",
        "Twitter",
        "YouTube",
        "Instagram",
        "Facebook",
        "TikTok",
        "Discord",
        "Twitch",
        "Mastodon"
      ]
    },
    "url": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 500,
      "regex": "^https?://[a-zA-Z0-9-.]+(\\\\.[a-zA-Z]{2,})?(/.*)?$"
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icons-field.icon",
      "options": {
        "preset": "icons"
      },
      "displayName": "Platform Icon"
    },
    "text": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "openInNewTab": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  },
  "config": {}
}
