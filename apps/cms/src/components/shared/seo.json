{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 60,
      "required": true
    },
    "metaDescription": {
      "type": "string",
      "minLength": 50,
      "maxLength": 160,
      "required": true
    },
    "metaImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "openGraph": {
      "type": "component",
      "component": "shared.open-graph",
      "repeatable": false
    },
    "keywords": {
      "type": "text",
      "maxLength": 500,
      "regex": "^[a-zA-Z0-9, -]+$"
    },
    "metaRobots": {
      "type": "enumeration",
      "default": "index, follow",
      "enum": [
        "index, follow",
        "noindex, follow",
        "index, nofollow",
        "noindex, nofollow"
      ]
    },
    "metaViewport": {
      "type": "string",
      "default": "width=device-width, initial-scale=1.0",
      "maxLength": 200
    },
    "canonicalURL": {
      "type": "string",
      "maxLength": 500,
      "regex": "^https?://[a-zA-Z0-9-.]+(\\\\.[a-zA-Z]{2,})?(/.*)?$"
    },
    "structuredData": {
      "type": "json"
    },
    "twitterCard": {
      "type": "enumeration",
      "default": "summary_large_image",
      "enum": [
        "summary",
        "summary_large_image",
        "app",
        "player"
      ]
    }
  }
}
