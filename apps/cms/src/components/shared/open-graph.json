{
  "collectionName": "components_shared_open_graphs",
  "info": {
    "displayName": "Open Graph",
    "icon": "project-diagram"
  },
  "options": {},
  "attributes": {
    "ogTitle": {
      "type": "string",
      "maxLength": 70,
      "required": true
    },
    "ogDescription": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "ogUrl": {
      "type": "string",
      "maxLength": 500,
      "regex": "^https?://[a-zA-Z0-9-.]+(\\\\.[a-zA-Z]{2,})?(/.*)?$"
    },
    "ogType": {
      "type": "enumeration",
      "default": "website",
      "enum": [
        "website",
        "article",
        "profile"
      ]
    }
  }
}
