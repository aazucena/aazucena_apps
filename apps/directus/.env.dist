PREFIX=aazucena

#CACHE
CACHE_CONTAINER=${PREFIX}_cache

#DB
POSTGRES_CONTAINER=${PREFIX}_cms
POSTGRES_VERSION="13-master"
POSTGRES_USER=${PREFIX}_user
POSTGRES_PASSWORD=
POSTGRES_DB=${PREFIX}_db


#CMS
DIRECTUS_CONTAINER=${PREFIX}_directus
