# ==============================================================================
# Frontend Environment Variables (Astro Portfolio App)
# ==============================================================================
# Deployed to: Vercel
# Purpose: Client-side and SSR environment variables
# Security: Only PUBLIC_ prefixed vars are exposed to browser
# ==============================================================================

# Strapi CMS Configuration
# Get STRAPI_TOKEN from: http://localhost:1337/admin/settings/api-tokens
STRAPI_URL=http://localhost:1337
STRAPI_API_ENDPOINT=/api
STRAPI_TOKEN=

# Intel-Engine (RAG context for Rin assistant)
# Leave empty to disable RAG — Rin will fall back to CMS-only context.
# Set to your Railway intel-engine URL in production (e.g. https://intel-engine.up.railway.app)
INTEL_ENGINE_URL=
# Must match INTEL_ENGINE_API_KEY set on the intel-engine service.
# Leave empty in dev if INTEL_ENGINE_API_KEY is not set on intel-engine (open mode).
INTEL_ENGINE_API_KEY=

# Maintenance Mode
# Set to "true" to enable maintenance mode without touching the CMS.
# Overrides the CMS maintenance.enabled flag — useful for emergency deploys.
# Preview token (below) still bypasses this when set.
MAINTENANCE_MODE=false

# Preview Mode
# Allows bypassing maintenance mode — visit /api/preview?token=<value> to activate
# Generate with: openssl rand -hex 32
PREVIEW_TOKEN=

# reCAPTCHA v3 Configuration
# Get keys from: https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Analytics (optional)
# Vercel Analytics and Speed Insights are auto-detected if deployed on Vercel
# Google Analytics
PUBLIC_GOOGLE_ANALYTICS_ID=

# Plausible Analytics (self-hosted)
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_API_HOST=

# Sentry Error Tracking (optional)
# Get DSN from: https://sentry.io/settings/projects/
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
PUBLIC_SENTRY_PROJECT=
PUBLIC_SENTRY_ORG=

# AZUCENA_LYTICS Integration (optional)
# PUBLIC_ANALYTICS_API_URL  — analytics dashboard base URL, exposed to browser
#   → used by PageViewTracker (page views, interactions, errors) and IntegrityBadge (health status)
# PUBLIC_INGESTION_SECRET_KEY — ingest secret for client-side telemetry (PageViewTracker)
# ANALYTICS_INGEST_URL      — same analytics server, kept private for server-side Astro actions
# ANALYTICS_INGEST_SECRET   — ingest secret for server-side telemetry (form submission tracking)
#   Note: ANALYTICS_INGEST_URL and PUBLIC_ANALYTICS_API_URL typically point to the same host.
#   The split exists so the secret key never leaks into client bundles for server-only calls.
PUBLIC_ANALYTICS_API_URL=
PUBLIC_INGESTION_SECRET_KEY=
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=

# Intel-Engine / LangGraph Brain (optional)
# INTEL_ENGINE_URL         — Railway URL for the intel-engine service (server-side only)
# INTEL_ENGINE_API_KEY     — API key guard for intel-engine inbound requests (server-side only)
# PUBLIC_USE_BRAIN_ENDPOINT — set to "true" to route Rin's chat through /api/brain (LangGraph)
#   instead of /api/chat (direct AI SDK). When unset, direct AI SDK is used.
PUBLIC_USE_BRAIN_ENDPOINT=

# Rin Character (optional)
# PUBLIC_RIN_CHARACTER_SRC — path or URL to the Rin .riv Rive animation file.
#   When set, the animated Rive character replaces the static RinMark SVG in the
#   chat trigger and header. When unset, the SVG fallback is used automatically.
#   Example: PUBLIC_RIN_CHARACTER_SRC=/rin.riv  (place the file in apps/portfolio/public/)
PUBLIC_RIN_CHARACTER_SRC=

# Build Configuration
NODE_ENV=development
