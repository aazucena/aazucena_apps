# ==============================================================================
# Frontend Environment Variables (Astro Portfolio App)
# ==============================================================================
# Deployed to: Vercel
# Purpose: Client-side and SSR environment variables
# Security: Only PUBLIC_ prefixed vars are exposed to browser
# ==============================================================================

# Strapi CMS Configuration
# Get STRAPI_TOKEN from: http://localhost:1337/admin/settings/api-tokens
STRAPI_URL=http://localhost:1337
STRAPI_API_ENDPOINT=/api
STRAPI_TOKEN=

# Preview Mode
# Allows bypassing maintenance mode — visit /api/preview?token=<value> to activate
# Generate with: openssl rand -hex 32
PREVIEW_TOKEN=

# reCAPTCHA v3 Configuration
# Get keys from: https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Analytics (optional)
# Vercel Analytics and Speed Insights are auto-detected if deployed on Vercel
# Google Analytics
PUBLIC_GOOGLE_ANALYTICS_ID=

# Plausible Analytics (self-hosted)
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_API_HOST=

# Sentry Error Tracking (optional)
# Get DSN from: https://sentry.io/settings/projects/
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
PUBLIC_SENTRY_PROJECT=
PUBLIC_SENTRY_ORG=

PUBLIC_ANALYTICS_API_URL=
PUBLIC_INGESTION_SECRET_KEY=

# Build Configuration
NODE_ENV=development
