---
/**
 * DetailLayout - Reusable layout for all detail pages (blog, projects, experiences).
 * Provides consistent structure with flexible content via named slots.
 *
 * Structure:
 * 1. Gradient accent bar
 * 2. Hero header with breadcrumbs + watermark
 * 3. Table of contents (optional)
 * 4. Main content area with optional sidebar
 * 5. Detail navigation (prev/next)
 */
import { ReadingProgress, TableOfContents } from "@aazucena/ui";
import Breadcrumbs from "~/components/common/Breadcrumbs.astro";
import GradientAccent from "~/components/common/GradientAccent.astro";
import WatermarkBackground from "~/components/common/WatermarkBackground.astro";
import DetailNavigation from "~/components/common/DetailNavigation.astro";
import PageLayout from "~/layouts/PageLayout.astro";
import type { BreadcrumbItem } from "~/components/common/Breadcrumbs.astro";

interface Props {
  // SEO
  title: string;
  description: string;
  jsonLd: Record<string, any>;

  // Header
  breadcrumbs: BreadcrumbItem[];
  watermarkText: string;
  watermarkSize?: "small" | "medium" | "large" | "huge";

  // Layout
  maxWidth?: "4xl" | "5xl" | "7xl";
  hasSidebar?: boolean;

  // Navigation
  prevItem?: { slug: string; title: string } | null;
  nextItem?: { slug: string; title: string } | null;
  basePath: string;
  prevLabel?: string;
  nextLabel?: string;

  // Optional features
  showReadingProgress?: boolean;
  showTableOfContents?: boolean;
  tocSelector?: string;
}

const {
  title,
  description,
  jsonLd,
  breadcrumbs,
  watermarkText,
  watermarkSize = "medium",
  maxWidth = "5xl",
  hasSidebar = false,
  prevItem,
  nextItem,
  basePath,
  prevLabel = "Previous",
  nextLabel = "Next",
  showReadingProgress = true,
  showTableOfContents = true,
  tocSelector = "#detail-content",
} = Astro.props;

const containerClasses = {
  "4xl": "max-w-4xl",
  "5xl": "max-w-5xl",
  "7xl": "max-w-screen-xl",
};

const maxWidthClass = containerClasses[maxWidth];
---

<PageLayout title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    is:inline
  />
  {showReadingProgress && <ReadingProgress client:load />}

  <main class="bg-background min-h-screen">
    <GradientAccent variant="print-hidden" />

    <!-- Hero Header -->
    <header class="border-rule bg-panel relative overflow-hidden border-b py-10 md:py-14">
      <div
        class={`${maxWidthClass} mx-auto px-4 sm:px-6 lg:px-8 relative z-10`}
      >
        <Breadcrumbs items={breadcrumbs} />

        <!-- Header Content - Fully customizable via slot -->
        <slot name="header" />
      </div>

      <WatermarkBackground text={watermarkText} size={watermarkSize} />
    </header>

    {showTableOfContents && (
      <TableOfContents
        containerSelector={tocSelector}
        className="bg-panel dark:bg-panel border-rule dark:border-rule"
        client:idle
      />
    )}

    <!-- Main Content Area -->
    <div class={`${maxWidthClass} mx-auto px-4 sm:px-6 lg:px-8 py-16`}>
      <div
        class={
          hasSidebar ? "grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16" : ""
        }
      >
        <!-- Main Content -->
        <div
          id="detail-content"
          class={hasSidebar ? "lg:col-span-2 space-y-12" : "space-y-12"}
        >
          <slot name="content" />
        </div>

        <!-- Sidebar (optional) -->
        {hasSidebar && (
          <aside class="space-y-8">
            <slot name="sidebar" />
          </aside>
        )}
      </div>

      <!-- Detail Navigation -->
      <DetailNavigation
        prevItem={prevItem}
        nextItem={nextItem}
        basePath={basePath}
        prevLabel={prevLabel}
        nextLabel={nextLabel}
      />
    </div>
  </main>
</PageLayout>
