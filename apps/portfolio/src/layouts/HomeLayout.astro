---
import BaseLayout, { type Props as BaseLayoutProps } from "./BaseLayout.astro";

const props: BaseLayoutProps = Astro.props;
---

<BaseLayout {...props}>
  {/* The homepage is always dark: this wrapper binds its content to the dark tokens, whatever <html> says. */}
  <div class="dark bg-background text-foreground min-h-screen">
    <slot />
  </div>
</BaseLayout>
