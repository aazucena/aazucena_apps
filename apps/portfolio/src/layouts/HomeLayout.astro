---
import BaseLayout, { type Props as BaseLayoutProps } from "./BaseLayout.astro";

const props: BaseLayoutProps = Astro.props;
---

<BaseLayout {...props}>
  {/* The homepage is always dark: this wrapper only scopes the dark tokens (no background, so the scene shows), whatever <html> says. */}
  <div class="dark">
    <slot />
  </div>
</BaseLayout>
