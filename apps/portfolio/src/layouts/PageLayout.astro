---
import BaseLayout, { type Props as BaseLayoutProps } from "./BaseLayout.astro";
import Footer from "~/components/Footer.astro";
import { Navbar } from "~/components/ui/Navbar";
import { BackToTop } from "@aazucena/ui/back-to-top";
import { getPortfolio } from "@aazucena/api";
import { getWebsiteConfig } from "@aazucena/api";
import { getAllNavigations } from "@aazucena/api";

const props: BaseLayoutProps = Astro.props;

// Fetch data for layout (in parallel)
// Note: BaseLayout already fetches websiteConfig via getLayoutData()
// We fetch it again here to pass to Navbar/Footer (minor duplication for cleaner architecture)
const [portfolio, websiteConfig] = await Promise.all([
  getPortfolio(),
  getWebsiteConfig(),
]);

// Fetch navigation data
const { mainNav, footerNav } = await getAllNavigations();

const currentPath = Astro.url.pathname;
---

<BaseLayout {...props}>
  <Navbar
    siteName={websiteConfig.siteName}
    currentPath={currentPath}
    logoUrl={websiteConfig.faviconUrl || "/icon.svg"}
    navItems={mainNav.items}
    client:load
  />

  <div class="pt-20 md:pt-28">
    <slot />
  </div>

  <Footer
    siteName={websiteConfig.siteName}
    socialLinks={portfolio.socialLinks}
    availabilityStatus={portfolio.availabilityStatus}
    navigationSections={footerNav.items}
    footerBrandDescription={websiteConfig.footerBrandDescription}
    footerLocationTagline={websiteConfig.footerLocationTagline}
    footerBuiltWithLabel={websiteConfig.footerBuiltWithLabel}
    techStack={websiteConfig.techStack as import("@aazucena/types").TechStackItem[]}
  />
  <BackToTop client:load />
</BaseLayout>
