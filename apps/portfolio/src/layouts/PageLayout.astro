---
import BaseLayout, { type Props as BaseLayoutProps } from "./BaseLayout.astro";
import Footer from '~/components/Footer.astro';
import { Navbar } from '~/components/ui/Navbar';
import { BackToTop } from '~/components/ui/BackToTop';
import { getPortfolio } from '~/lib/api/portfolio';
import { getSiteConfig } from '~/lib/services/layout';

const props: BaseLayoutProps = Astro.props;

const siteConfig = getSiteConfig();

// Fetch data for layout
const portfolio = await getPortfolio();

const currentPath = Astro.url.pathname;
---

<BaseLayout {...props}>
  <Navbar 
    siteName={siteConfig.metadata.siteName} 
    currentPath={currentPath} 
    logoUrl={siteConfig.metadata.faviconUrl || '/icon.svg'}
    client:load 
  />
  
  <div class="pt-20 md:pt-28">
    <slot />
  </div>
  
  <Footer
    siteName={siteConfig.metadata.siteName}
    socialLinks={portfolio.socialLinks}
    availabilityStatus={portfolio.availabilityStatus}
  />
  <BackToTop client:load />
</BaseLayout>
