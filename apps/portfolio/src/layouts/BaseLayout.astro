---
import "../styles/globals.css";
import SEO from "~/components/SEO.astro";
import Favicon from "~/components/Favicon.astro";
import ResourceHints from "~/components/ResourceHints.astro";
import AnalyticsScripts from "~/components/AnalyticsScripts.astro";
import Preloader, { type PreloaderTheme } from "@/components/preloader";
import BrandIconLoader from "@/components/BrandIconLoader.astro";
import { getTheme as getPreloaderTheme } from "@/components/preloader/themes/registry";
import { getLayoutData } from "~/lib/services/layout";
import { formatPageTitle } from "~/config/site";
import PlausibleScript from "~/components/common/PlausibleScript.astro";
import PageViewTracker from "~/components/telemetry/PageViewTracker";

export interface Props {
  title?: string;
  description?: string;
}
const { title, description }: Props = Astro.props;

// Fetch all layout configuration from Strapi CMS in parallel
const { siteConfig, websiteConfig, preloaderConfig } = await getLayoutData();

// Detect if we're using CMS fallback configs (indicates CMS fetch failure)
const isCmsFallback = false;

// Get the preloader theme background to prevent white flash
const preloaderTheme: PreloaderTheme = preloaderConfig.theme || "default";
const preloaderThemeConfig = getPreloaderTheme(preloaderTheme);
const preloaderBackground = preloaderThemeConfig.colors.background;

// Extract brand logo URL (use CMS siteLogo if available, otherwise default to /icon.svg)
const brandLogoUrl = websiteConfig.siteLogoUrl || "/icon.svg";

// Build meta title using template
const pageTitle = formatPageTitle(title);

const pageDescription = description || websiteConfig.defaultSEO?.description;

// Detect page type for transition styles
const path = Astro.url.pathname;
const isHomepage = path === "/";
const isDetailPage = path.includes("[slug]") || /\/[^\/]+\/[^\/]+/.test(path); // e.g., /projects/foo, /blog/bar
const pageType = isHomepage ? "homepage" : isDetailPage ? "detail" : "list";

const themeStyles = {
  colorPrimaryLight: siteConfig.theme.colors.light.primary,
  colorSecondaryLight: siteConfig.theme.colors.light.secondary,
  colorAccentLight: siteConfig.theme.colors.light.accent,
  colorPrimaryDark: siteConfig.theme.colors.dark.primary,
  colorSecondaryDark: siteConfig.theme.colors.dark.secondary,
  colorAccentDark: siteConfig.theme.colors.dark.accent,
  fontSans: siteConfig.theme.fonts.sans,
  fontSerif: siteConfig.theme.fonts.serif,
  fontHeading: siteConfig.theme.fonts.heading,
  fontCode: siteConfig.theme.fonts.code,
};
---

<html
  lang="en"
  data-theme={siteConfig.theme.mode}
  class={isHomepage ? "homepage" : "content-page"}
  data-page-type={pageType}
>
  <head>
    <meta charset="utf-8" />

    {/* Resource Hints - DNS prefetch, preconnect, preload for performance */}
    <ResourceHints />

    {/* Favicon - Extracted component with fallback */}
    <Favicon url={websiteConfig.faviconUrl} />

    {/* SEO Meta Tags - Extracted to reusable component */}
    <SEO
      title={pageTitle}
      description={pageDescription!}
      canonical={websiteConfig.defaultSEO?.canonical}
      keywords={websiteConfig.defaultSEO?.keywords}
      robots={websiteConfig.defaultSEO?.robots}
      viewport={websiteConfig.defaultSEO?.viewport}
      twitterCard={websiteConfig.defaultSEO?.twitterCard}
      twitterSite={websiteConfig.twitterHandle}
      googleSiteVerificationId={websiteConfig.googleSiteVerificationId}
    />
    <PlausibleScript domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN} />
    <PageViewTracker client:load />

    {/* Theme Stylesheet - Static styles referencing dynamic CMS variables */}
    <link rel="stylesheet" href="/styles/theme.css" />

    {/* Font Optimization - Asynchronous loading for better performance */}
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=${siteConfig.theme.fonts.code.replace(" ", "+")}&family=${siteConfig.theme.fonts.sans.replace(" ", "+")}:wght@400;700&display=swap`}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href={`https://fonts.googleapis.com/css2?family=${siteConfig.theme.fonts.code.replace(" ", "+")}&family=${siteConfig.theme.fonts.sans.replace(" ", "+")}:wght@400;700&display=swap`}
      />
    </noscript>

    {/* Dynamic Theme Variables - Injected from CMS configuration */}
    <style is:inline define:vars={themeStyles}>
      /* Prevent white flash - match preloader background immediately */
      body {
        margin: 0;
        padding: 0;
      }

      /* Theme CSS Variables - DYNAMIC from CMS */
      :root {
        --color-primary: var(--colorPrimaryLight);
        --color-secondary: var(--colorSecondaryLight);
        --color-accent: var(--colorAccentLight);
        --font-sans:
          var(--fontSans), -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-serif: var(--fontSerif), Georgia, "Times New Roman", serif;
        --font-heading:
          var(--fontHeading), -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, sans-serif;
        --font-code:
          var(--fontCode), "SFMono-Regular", Consolas, "Liberation Mono", Menlo,
          Courier, monospace;
      }

      .dark {
        --color-primary: var(--colorPrimaryDark);
        --color-secondary: var(--colorSecondaryDark);
        --color-accent: var(--colorAccentDark);
      }
    </style>
  </head>

  <body style={{ background: preloaderBackground }}>
    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-to-main"> Skip to main content </a>
    <!-- Brand Icon Loader - Shows immediately (CSS-only, no JS required) -->
    <!-- Once hidden and removed, it won't reappear -->
    <!-- Note: transition:persist removed due to React 19 compatibility issues -->
    <BrandIconLoader
      logoUrl={brandLogoUrl}
      backgroundColor={preloaderBackground}
      isCmsFallback={isCmsFallback}
    />

    <!-- Preloader - Hydrates with React (client:only) -->
    <!-- Pass current path to enable homepage-specific behavior -->
    <!-- Preloader re-renders on navigation to check currentPath and apply show-once logic -->
    <Preloader
      {...preloaderConfig}
      currentPath={Astro.url.pathname}
      client:only="react"
    />

    <!-- Main content - hidden until preloader completes -->
    <main
      id="main-content"
      data-critical
      style="opacity: 0; transition: opacity 0.6s ease;"
    >
      <slot />
    </main>

    <!-- Analytics - Vercel Analytics + Speed Insights -->
    <AnalyticsScripts />

    <script is:inline>
      // Show main content when preloader completes
      document.addEventListener("preloader-complete", function () {
        const mainContent = document.querySelector("main[data-critical]");
        if (mainContent) {
          mainContent.style.opacity = "1";
          // Reset body background to allow CSS themes to take over
          document.body.style.background = "";
        }
      });

      // Fallback: if preloader doesn't complete within 10s, show content anyway
      setTimeout(function () {
        const mainContent = document.querySelector("main[data-critical]");
        if (mainContent && mainContent.style.opacity === "0") {
          console.warn(
            "[BaseLayout] Preloader timeout - forcing content display",
          );
          mainContent.style.opacity = "1";
        }
      }, 10000);
    </script>
  </body>
</html>
