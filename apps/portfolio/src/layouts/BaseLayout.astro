---
import '../styles/globals.css';
import { ViewTransitions } from 'astro:transitions';
import Preloader, { type PreloaderTheme } from '@/components/preloader';
import BrandIconLoader from '@/components/BrandIconLoader.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights  from "@vercel/speed-insights/astro";
import { getTheme as getPreloaderTheme } from '@/components/preloader/themes/registry';
import { getLayoutData } from '~/lib/api/layout-data';
import { DEFAULT_WEBSITE_CONFIG } from '~/lib/transformers/website-config';

export interface Props {
  title?: string;
  description?: string;
}
const { title, description }: Props = Astro.props;

// Fetch all layout configuration from Strapi CMS in parallel
const { preloaderConfig, websiteConfig, themeConfig, maintenance } = await getLayoutData();

// Detect if we're using CMS fallback configs (indicates CMS fetch failure)
const isCmsFallback = websiteConfig.siteName === DEFAULT_WEBSITE_CONFIG.siteName;

// Get the preloader theme background to prevent white flash
const preloaderTheme: PreloaderTheme = preloaderConfig.theme || 'default';
const preloaderThemeConfig = getPreloaderTheme(preloaderTheme);
const preloaderBackground = preloaderThemeConfig.colors.background;

// Extract brand logo URL (use CMS siteLogo if available, otherwise default to /icon.svg)
const brandLogoUrl = websiteConfig.siteLogo?.url || '/icon.svg';

// Build meta title using template
const pageTitle = title
  ? websiteConfig.metaTitleTemplate.replace('%s', title).replace('{siteName}', websiteConfig.siteName)
  : websiteConfig.seo.metaTitle;

const pageDescription = description || websiteConfig.seo.metaDescription;

// Detect page type for transition styles
const path = Astro.url.pathname;
const isHomepage = path === '/';
const isDetailPage = path.includes('[slug]') || /\/[^\/]+\/[^\/]+/.test(path); // e.g., /projects/foo, /blog/bar
const pageType = isHomepage ? 'homepage' : isDetailPage ? 'detail' : 'list';
---

<html lang="en" data-theme={themeConfig.mode} class={isHomepage ? 'homepage' : 'content-page'} data-page-type={pageType}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content={websiteConfig.seo.metaViewport} />
		<ViewTransitions />

		{/* Favicon */}
		{websiteConfig.favicon ? (
			<link rel="icon" href={websiteConfig.favicon} />
		) : (
			<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		)}

		{/* SEO Meta Tags */}
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		{websiteConfig.seo.keywords && (
			<meta name="keywords" content={websiteConfig.seo.keywords} />
		)}
		<meta name="robots" content={websiteConfig.seo.metaRobots} />

		{/* Canonical URL */}
		{websiteConfig.seo.canonicalURL && (
			<link rel="canonical" href={websiteConfig.seo.canonicalURL} />
		)}

		{/* Open Graph */}
		{websiteConfig.seo.openGraph && (
			<>
				<meta property="og:title" content={websiteConfig.seo.openGraph.ogTitle} />
				<meta property="og:description" content={websiteConfig.seo.openGraph.ogDescription} />
				<meta property="og:type" content={websiteConfig.seo.openGraph.ogType} />
				{websiteConfig.seo.openGraph.ogUrl && (
					<meta property="og:url" content={websiteConfig.seo.openGraph.ogUrl} />
				)}
				{websiteConfig.openGraphSiteName && (
					<meta property="og:site_name" content={websiteConfig.openGraphSiteName} />
				)}
			</>
		)}

		{/* Twitter Card */}
		<meta name="twitter:card" content={websiteConfig.seo.twitterCard} />
		{websiteConfig.twitterHandle && (
			<meta name="twitter:site" content={websiteConfig.twitterHandle} />
		)}

		{/* Google Site Verification */}
		{websiteConfig.googleSiteVerificationId && (
			<meta name="google-site-verification" content={websiteConfig.googleSiteVerificationId} />
		)}

		{/* Fonts - Dynamic from theme config */}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link href={`https://fonts.googleapis.com/css2?family=${themeConfig.fonts.code.replace(' ', '+')}&family=${themeConfig.fonts.sans.replace(' ', '+')}:wght@400;700&display=swap`} rel="stylesheet">

    <style is:inline define:vars={{
			colorPrimaryLight: themeConfig.colors.light.primary,
			colorSecondaryLight: themeConfig.colors.light.secondary,
			colorAccentLight: themeConfig.colors.light.accent,
			colorPrimaryDark: themeConfig.colors.dark.primary,
			colorSecondaryDark: themeConfig.colors.dark.secondary,
			colorAccentDark: themeConfig.colors.dark.accent,
			fontSans: themeConfig.fonts.sans,
			fontSerif: themeConfig.fonts.serif,
			fontHeading: themeConfig.fonts.heading,
			fontCode: themeConfig.fonts.code,
		}}>
      /* Prevent white flash - match preloader background immediately */
      body {
        margin: 0;
        padding: 0;
      }

			/* Theme CSS Variables */
			:root {
				--color-primary: var(--colorPrimaryLight);
				--color-secondary: var(--colorSecondaryLight);
				--color-accent: var(--colorAccentLight);
				--font-sans: var(--fontSans), sans-serif;
				--font-serif: var(--fontSerif), serif;
				--font-heading: var(--fontHeading), sans-serif;
				--font-code: var(--fontCode), monospace;
			}

			.dark {
				--color-primary: var(--colorPrimaryDark);
				--color-secondary: var(--colorSecondaryDark);
				--color-accent: var(--colorAccentDark);
			}

			/* Smooth page transitions */
			@view-transition {
				navigation: auto;
			}

			/* Homepage: Fixed dark theme for immersive experience */
			html.homepage {
				color-scheme: dark;
			}

			html.homepage body {
				background: #0f172a;
			}

			/* Content pages: Respect user theme preference */
			html.content-page {
				color-scheme: light dark;
			}

			/* Page transition animations */
			::view-transition-old(root),
			::view-transition-new(root) {
				animation-duration: 0.3s;
				animation-timing-function: ease-in-out;
			}

			/* Default fade transition */
			::view-transition-old(root) {
				animation-name: fade-out;
			}

			::view-transition-new(root) {
				animation-name: fade-in;
			}

			/* Homepage transitions (more dramatic) */
			html.homepage::view-transition-old(root) {
				animation-name: fade-out-scale;
			}

			html.homepage::view-transition-new(root) {
				animation-name: fade-in-scale;
			}

			/* Detail pages (subtle slide) */
			html.content-page[data-page-type="detail"]::view-transition-old(root) {
				animation-name: slide-out;
			}

			html.content-page[data-page-type="detail"]::view-transition-new(root) {
				animation-name: slide-in;
			}

			/* Animation keyframes */
			@keyframes fade-out {
				from { opacity: 1; }
				to { opacity: 0; }
			}

			@keyframes fade-in {
				from { opacity: 0; }
				to { opacity: 1; }
			}

			@keyframes fade-out-scale {
				from {
					opacity: 1;
					transform: scale(1);
				}
				to {
					opacity: 0;
					transform: scale(0.95);
				}
			}

			@keyframes fade-in-scale {
				from {
					opacity: 0;
					transform: scale(1.05);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}

			@keyframes slide-out {
				from {
					opacity: 1;
					transform: translateX(0);
				}
				to {
					opacity: 0;
					transform: translateX(-20px);
				}
			}

			@keyframes slide-in {
				from {
					opacity: 0;
					transform: translateX(20px);
				}
				to {
					opacity: 1;
					transform: translateX(0);
				}
			}

			/* Accessibility: Respect user's motion preferences */
			@media (prefers-reduced-motion: reduce) {
				/* Disable all animations for users with motion sensitivity */
				::view-transition-old(root),
				::view-transition-new(root) {
					animation: none !important;
					transition: none !important;
				}

				/* Instant transitions instead */
				::view-transition-old(root) {
					opacity: 0;
				}

				::view-transition-new(root) {
					opacity: 1;
				}

				/* Also disable decorative animations */
				* {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
			}

			/* Accessibility: Enhanced keyboard focus indicators */
			*:focus-visible {
				outline: 2px solid var(--color-accent);
				outline-offset: 2px;
				border-radius: 4px;
			}

			/* Remove focus styles for mouse users */
			*:focus:not(:focus-visible) {
				outline: none;
			}

			/* Accessibility: Skip to main content link */
			.skip-to-main {
				position: absolute;
				top: -40px;
				left: 0;
				background: var(--color-accent);
				color: white;
				padding: 8px 16px;
				text-decoration: none;
				z-index: 9999;
				border-radius: 0 0 4px 0;
				font-weight: 600;
			}

			.skip-to-main:focus {
				top: 0;
			}
    </style>
	</head>
	<body style={{ background: preloaderBackground }}>
		<!-- Skip to main content (accessibility) -->
		<a href="#main-content" class="skip-to-main">
			Skip to main content
		</a>
    <!-- Brand Icon Loader - Shows immediately (CSS-only, no JS required) -->
    <!-- transition:persist keeps the same DOM element across page navigations -->
    <!-- Once hidden and removed, it won't reappear -->
    <BrandIconLoader
      logoUrl={brandLogoUrl}
      backgroundColor={preloaderBackground}
      isCmsFallback={isCmsFallback}
      transition:persist="brand-loader"
    />

    <!-- Preloader - Hydrates with React (client:only) -->
    <!-- Pass current path to enable homepage-specific behavior -->
    <!-- Preloader re-renders on navigation to check currentPath and apply show-once logic -->
    <Preloader {...preloaderConfig} currentPath={Astro.url.pathname} client:only="react" />

    <!-- Main content - hidden until preloader completes -->
    <main id="main-content" data-critical style="opacity: 0; transition: opacity 0.6s ease;">
      <slot />
    </main>
    <Analytics />
    <SpeedInsights />

    <script is:inline>
      console.log('[BaseLayout DEBUG] Script starting');

      // Show main content when preloader completes
      document.addEventListener('preloader-complete', function() {
        console.log('[BaseLayout DEBUG] Received preloader-complete event');
        const mainContent = document.querySelector('main[data-critical]');
        if (mainContent) {
          console.log('[BaseLayout DEBUG] Setting main content opacity to 1');
          mainContent.style.opacity = '1';
          // Reset body background to allow CSS themes to take over
          document.body.style.background = '';
        } else {
          console.error('[BaseLayout DEBUG] Main content not found!');
        }
      });

      // Fallback: if preloader doesn't complete within 10s, show content anyway
      setTimeout(function() {
        const mainContent = document.querySelector('main[data-critical]');
        console.log('[BaseLayout DEBUG] Timeout check - opacity:', mainContent?.style.opacity);
        if (mainContent && mainContent.style.opacity === '0') {
          console.warn('[BaseLayout] Preloader timeout - forcing content display');
          mainContent.style.opacity = '1';
        }
      }, 10000);
    </script>
	</body>
</html>
