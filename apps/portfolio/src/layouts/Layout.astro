---
import '../styles/globals.css';
import Preloader from '@/components/preloader';
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
    <Preloader continueButton={false} cardClassName='shadow-none bg-transparent' client:load />
    <!-- Main content -->
    <main data-critical>
      <slot />
    </main>
	</body>
</html>
