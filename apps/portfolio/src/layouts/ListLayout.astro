---
import PageLayout from './PageLayout.astro';
import { pluralize } from '~/lib/utils/text';

export interface FilterConfig {
  id: string;
  label: string;
  options: string[];
}

interface Props {
  title: string;
  description: string;
  watermark?: string; // NEW: Background watermark text
  filters?: FilterConfig[];
  searchPlaceholder?: string;
  maxWidth?: '5xl' | '7xl' | 'full';
  ignoreMaxWidth?: boolean;
  layout?: 'timeline' | 'grid' | 'none';
  hasItems?: boolean;
  emptyMessage?: string;
}

const { 
  title, 
  description, 
  watermark,
  filters = [], 
  searchPlaceholder = "Search...", 
  maxWidth = '5xl',
  layout = 'none',
  hasItems = true,
  ignoreMaxWidth = false,
  emptyMessage = "No items to display."
} = Astro.props;

const containerClasses = {
  '5xl': 'max-w-5xl',
  '7xl': 'max-w-7xl',
  'full': 'max-w-full'
};

const maxWidthClass = containerClasses[maxWidth] || 'max-w-5xl';
---

<PageLayout title={title} description={description}>
  <div class="min-h-screen bg-white dark:bg-gray-950">
    <!-- Gradient Accent (visual bridge to homepage) -->
    <div class="h-1 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500" aria-hidden="true"></div>

    <!-- Header -->
    <div class="bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 relative overflow-hidden">
      <div class={`${maxWidthClass} mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 relative z-10`}>
        <h1 class="text-5xl md:text-7xl font-black text-gray-900 dark:text-white mb-6 tracking-tighter">
          {title}<span class="text-blue-600">.</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl font-medium leading-relaxed">
          {description}
        </p>
      </div>

      {watermark && (
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none opacity-[0.02] dark:opacity-[0.05] whitespace-nowrap z-0">
          <span class="text-[15rem] md:text-[25rem] font-black uppercase tracking-tighter">{watermark}</span>
        </div>
      )}
    </div>

    {hasItems ? (
      <>
        <!-- Filters Section -->
        <div class={`${!ignoreMaxWidth ? maxWidthClass : ''} mx-auto px-4 sm:px-6 lg:px-8 py-12`}>
          <div class="bg-white dark:bg-gray-900 rounded-[2rem] shadow-sm border border-gray-100 dark:border-gray-800 p-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
              <h2 class="text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em]">
                Filter Archive
              </h2>
              <div id="results-count" class="text-[10px] font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest">
                <!-- Results count injected here -->
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {filters.map(filter => (
                <div>
                  <label for={`${filter.id}-filter`} class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-3 ml-2">
                    {filter.label}
                  </label>
                  <select
                    id={`${filter.id}-filter`}
                    data-filter-id={filter.id}
                    class="list-filter-select w-full px-5 py-3 border border-gray-100 dark:border-gray-800 rounded-2xl shadow-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white outline-none transition-all cursor-pointer"
                  >
                    <option value="">All {pluralize(filter.label)}</option>
                    {filter.options.map(option => (
                      <option value={option}>{option}</option>
                    ))}
                  </select>
                </div>
              ))}

              <!-- Search Input -->
              <div class={filters.length === 0 ? 'md:col-span-2 lg:col-span-3' : (filters.length === 1 ? 'md:col-span-1 lg:col-span-2' : '')}>
                <label for="search-input" class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-3 ml-2">
                  Keywords
                </label>
                <input
                  type="text"
                  id="search-input"
                  placeholder={searchPlaceholder}
                  class="w-full px-5 py-3 border border-gray-100 dark:border-gray-800 rounded-2xl shadow-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 outline-none transition-all"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Content Area -->
        <div class={`${!ignoreMaxWidth ? maxWidthClass : ''} mx-auto px-4 sm:px-6 lg:px-8 pb-20`}>
          <div id="list-container" data-layout={layout} class={layout === 'timeline' ? 'relative space-y-12' : (layout === 'grid' ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8' : 'space-y-8')}>
            {layout === 'timeline' && (
              <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-gray-100 dark:bg-gray-800 transform md:-translate-x-1/2" aria-hidden="true"></div>
            )}
            
            <slot />
          </div>

          <!-- No Results Message -->
          <div id="no-results" class="hidden text-center py-20">
            <p class="text-gray-500 dark:text-gray-400 text-lg font-medium mb-8">
              No items found matching your filters.
            </p>
            <button
              id="clear-filters-btn"
              class="px-8 py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-blue-600 dark:hover:bg-blue-50 transition-all shadow-lg active:scale-95"
            >
              Reset Filters
            </button>
          </div>
        </div>
      </>
    ) : (
      <div class={`${!ignoreMaxWidth ? maxWidthClass : ''} mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center`}>
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gray-50 dark:bg-gray-900 text-gray-300 dark:text-gray-700 mb-8 border border-gray-100 dark:border-gray-800">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
        </div>
        <p class="text-2xl text-gray-400 dark:text-gray-600 font-bold tracking-tight">
          {emptyMessage}
        </p>
      </div>
    )}
  </div>

  <script>
    import { updateURL } from '~/lib/utils/url';
    import { en } from 'make-plural/plurals';

    const plurals = en;

    // Debounce utility
    function debounce(func: Function, delay: number = 300) {
      let timeoutId: any;
      return (...args: any[]) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => func(...args), delay);
      };
    }

    function initListFiltering() {
      const filterSelects = document.querySelectorAll('.list-filter-select') as NodeListOf<HTMLSelectElement>;
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const listItems = document.querySelectorAll('.item-card') as NodeListOf<HTMLElement>;
      const noResults = document.getElementById('no-results') as HTMLElement;
      const clearFiltersBtn = document.getElementById('clear-filters-btn') as HTMLButtonElement;
      const resultsCountDisplay = document.getElementById('results-count');
      const listContainer = document.getElementById('list-container');
      const layout = listContainer?.dataset.layout;

      if (!listItems.length && !filterSelects.length && !searchInput) return;

      function updateResultsCount(count: number) {
        if (!resultsCountDisplay) return;
        
        const category = plurals(count);
        const label = category === 'one' ? 'Entry' : 'Entries';
        resultsCountDisplay.textContent = `Displaying ${count} ${label}`;
      }

      function filterList(updateQuery = true) {
        const searchValue = searchInput?.value.toLowerCase() || '';

        if (updateQuery) {
          const params: Record<string, string> = {};
          filterSelects.forEach(select => {
            params[select.dataset.filterId!] = select.value;
          });
          if (searchInput) params.search = searchInput.value;
          updateURL(params);
        }

        let visibleCount = 0;

        listItems.forEach(item => {
          let isVisible = true;

          // Check each filter
          filterSelects.forEach(select => {
            const filterId = select.dataset.filterId!;
            const filterValue = select.value.toLowerCase();
            
            if (filterValue) {
              const datasetKey = 'filter' + filterId.charAt(0).toUpperCase() + filterId.slice(1);
              const itemValue = (item.dataset[datasetKey] || '').toLowerCase();
              
              const itemValues = itemValue.split(',').map(v => v.trim());
              if (!itemValues.includes(filterValue)) {
                isVisible = false;
              }
            }
          });

          // Check search
          if (isVisible && searchValue) {
            const itemSearch = (item.dataset.search || '').toLowerCase();
            if (!itemSearch.includes(searchValue)) {
              isVisible = false;
            }
          }

          // Use style.display to override any flex/grid display properties
          item.style.display = isVisible ? '' : 'none';
          
          if (isVisible) {
            // Update alternating classes for timeline layout
            if (layout === 'timeline') {
              const contentWrapper = item.querySelector('.timeline-content-wrapper');
              if (contentWrapper) {
                contentWrapper.classList.remove('md:mr-auto', 'md:pr-16', 'md:ml-auto', 'md:pl-16');
                
                if (visibleCount % 2 === 0) {
                  contentWrapper.classList.add('md:mr-auto', 'md:pr-16');
                } else {
                  contentWrapper.classList.add('md:ml-auto', 'md:pl-16');
                }
              }
            }
            visibleCount++;
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
        updateResultsCount(visibleCount);
      }

      // Initialize from URL
      function initFiltersFromURL() {
        const params = new URLSearchParams(window.location.search);
        
        filterSelects.forEach(select => {
          const value = params.get(select.dataset.filterId!);
          if (value) select.value = value;
        });

        if (searchInput) {
          const search = params.get('search');
          if (search) searchInput.value = search;
        }

        filterList(false);
      }

      // Event Listeners
      filterSelects.forEach(select => {
        select.addEventListener('change', () => filterList());
      });

      if (searchInput) {
        searchInput.addEventListener('input', debounce(() => filterList(), 300));
      }

      clearFiltersBtn?.addEventListener('click', () => {
        filterSelects.forEach(select => select.value = '');
        if (searchInput) searchInput.value = '';
        filterList();
      });

      initFiltersFromURL();
    }

    // Run on load and on Astro page changes
    document.addEventListener('DOMContentLoaded', initListFiltering);
    document.addEventListener('astro:after-swap', initListFiltering);
  </script>
</PageLayout>