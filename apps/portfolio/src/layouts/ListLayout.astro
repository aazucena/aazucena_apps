---
import PageLayout from "./PageLayout.astro";
import GradientAccent from "~/components/common/GradientAccent.astro";
import WatermarkBackground from "~/components/common/WatermarkBackground.astro";
import { pluralize } from "@aazucena/utils";

export interface FilterConfig {
  id: string;
  label: string;
  options: string[];
}

export interface SortOption {
  value: string;
  label: string;
}

export interface SortConfig {
  id: string;
  label: string;
  options: SortOption[];
}

interface Props {
  title: string;
  description: string;
  watermark?: string;
  filters?: FilterConfig[];
  sortOptions?: SortConfig[];
  searchPlaceholder?: string;
  maxWidth?: "5xl" | "7xl" | "full";
  ignoreMaxWidth?: boolean;
  layout?: "timeline" | "grid" | "none";
  hasItems?: boolean;
  emptyMessage?: string;
}

const {
  title,
  description,
  watermark,
  filters = [],
  sortOptions = [],
  searchPlaceholder = "Search...",
  maxWidth = "5xl",
  layout = "none",
  hasItems = true,
  ignoreMaxWidth = false,
  emptyMessage = "No items to display.",
} = Astro.props;

const containerClasses = {
  "5xl": "max-w-5xl",
  "7xl": "max-w-screen-xl",
  full: "max-w-full",
};

const maxWidthClass = containerClasses[maxWidth] || "max-w-5xl";

const totalSelects = filters.length + sortOptions.length;
const searchColSpan =
  totalSelects === 0
    ? "md:col-span-2 lg:col-span-3"
    : totalSelects === 1
      ? "md:col-span-1 lg:col-span-2"
      : "";
---

<PageLayout title={title} description={description}>
  <div class="bg-background min-h-screen">
    <GradientAccent />

    <!-- Header -->
    <div class="border-rule bg-panel relative overflow-hidden border-b">
      <div
        class={`${maxWidthClass} mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 relative z-10`}
      >
        <h1 class="text-foreground mb-6 text-5xl font-black tracking-tighter md:text-7xl">
          {title}
          <span class="text-signal">.</span>
        </h1>
        <p class="text-muted-foreground max-w-3xl text-xl leading-relaxed">
          {description}
        </p>
      </div>

      {watermark && <WatermarkBackground text={watermark} size="small" />}
    </div>

    {hasItems ? (
      <>
        {/* Filters Section */}
        <div
          class={`${!ignoreMaxWidth ? maxWidthClass : ""} mx-auto px-4 py-12 sm:px-6 lg:px-8`}
        >
          <div class="border-rule bg-panel rounded-card flex flex-col border">
            <div class="border-rule h-panel-header px-panel flex flex-col justify-between gap-2 border-b md:flex-row md:items-center">
              <h2 class="micro-label text-muted-foreground">
                Filter // Archive
              </h2>
              <div id="results-count" class="micro-label text-signal">
                {/* Results count injected here */}
              </div>
            </div>

            <div class="p-panel grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
              {filters.map((filter) => (
                <div>
                  <label
                    for={`${filter.id}-filter`}
                    class="micro-label text-muted-foreground mb-2 block"
                  >
                    {filter.label}
                  </label>
                  <select
                    id={`${filter.id}-filter`}
                    data-filter-id={filter.id}
                    class="list-filter-select border-rule-strong bg-background text-foreground h-control rounded-control focus-visible:outline-signal w-full cursor-pointer border px-3 text-sm focus-visible:outline-1 focus-visible:outline-offset-2"
                  >
                    <option value="">All {pluralize(filter.label)}</option>
                    {filter.options.map((option) => (
                      <option value={option}>{option}</option>
                    ))}
                  </select>
                </div>
              ))}

              {sortOptions.map((sort) => (
                <div>
                  <label
                    for={`${sort.id}-sort`}
                    class="micro-label text-muted-foreground mb-2 block"
                  >
                    {sort.label}
                  </label>
                  <select
                    id={`${sort.id}-sort`}
                    data-sort-id={sort.id}
                    class="list-sort-select border-rule-strong bg-background text-foreground h-control rounded-control focus-visible:outline-signal w-full cursor-pointer border px-3 text-sm focus-visible:outline-1 focus-visible:outline-offset-2"
                  >
                    <option value="">Default</option>
                    {sort.options.map((opt) => (
                      <option value={opt.value}>{opt.label}</option>
                    ))}
                  </select>
                </div>
              ))}

              {/* Search Input */}
              <div class={searchColSpan}>
                <label class="micro-label text-muted-foreground mb-2 block">
                  Keywords
                  <input
                    type="text"
                    id="search-input"
                    placeholder={searchPlaceholder}
                    class="border-rule-strong bg-background text-foreground placeholder:text-muted-foreground h-control rounded-control focus-visible:outline-signal mt-2 w-full border px-3 text-sm normal-case focus-visible:outline-1 focus-visible:outline-offset-2"
                  />
                </label>
              </div>
            </div>
          </div>
        </div>

        {/* Content Area */}
        <div
          class={`${!ignoreMaxWidth ? maxWidthClass : ""} mx-auto px-4 pb-20 sm:px-6 lg:px-8`}
        >
          <div
            id="list-container"
            data-layout={layout}
            class={
              layout === "timeline"
                ? "relative space-y-8"
                : layout === "grid"
                  ? "grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"
                  : "space-y-4"
            }
          >
            {layout === "timeline" && (
              <div
                class="bg-rule absolute top-0 bottom-0 left-[9px] w-px"
                aria-hidden="true"
              />
            )}

            <slot />
          </div>

          {/* No Results Message */}
          <div id="no-results" class="hidden py-20 text-center">
            <p class="text-muted-foreground mb-6 text-lg">
              No items found matching your filters.
            </p>
            <button
              id="clear-filters-btn"
              class="bg-signal text-signal-foreground h-control rounded-control micro-label hover:bg-signal/90 focus-visible:outline-signal px-6 transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
            >
              Reset Filters
            </button>
          </div>
        </div>
      </>
    ) : (
      <div
        class={`${!ignoreMaxWidth ? maxWidthClass : ""} mx-auto px-4 py-32 text-center sm:px-6 lg:px-8`}
      >
        <div class="mb-8 inline-flex h-20 w-20 items-center justify-center rounded-card border-rule bg-panel text-muted-foreground border">
          <svg
            class="h-10 w-10"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
            />
          </svg>
        </div>
        <p class="text-muted-foreground text-center text-2xl font-bold tracking-tight">
          {emptyMessage}
        </p>
      </div>
    )}
  </div>

  <script>
    import { updateURL } from "@aazucena/utils";
    import { en } from "make-plural/plurals";

    const plurals = en;

    // Debounce utility
    function debounce(func: Function, delay: number = 300) {
      let timeoutId: any;
      return (...args: any[]) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => func(...args), delay);
      };
    }

    function initListFiltering() {
      const filterSelects = document.querySelectorAll(
        ".list-filter-select",
      ) as NodeListOf<HTMLSelectElement>;
      const sortSelects = document.querySelectorAll(
        ".list-sort-select",
      ) as NodeListOf<HTMLSelectElement>;
      const searchInput = document.getElementById(
        "search-input",
      ) as HTMLInputElement;
      const listItems = document.querySelectorAll(
        ".item-card",
      ) as NodeListOf<HTMLElement>;
      const noResults = document.getElementById("no-results") as HTMLElement;
      const clearFiltersBtn = document.getElementById(
        "clear-filters-btn",
      ) as HTMLButtonElement;
      const resultsCountDisplay = document.getElementById("results-count");
      const listContainer = document.getElementById("list-container");
      const layout = listContainer?.dataset.layout;

      if (!listItems.length && !filterSelects.length && !searchInput) return;

      // Record original DOM order so "Default" sort can restore it
      listItems.forEach((item, i) => {
        item.dataset.originalIndex = String(i);
      });

      function updateResultsCount(count: number) {
        if (!resultsCountDisplay) return;

        const category = plurals(count);
        const label = category === "one" ? "Entry" : "Entries";
        resultsCountDisplay.textContent = `Displaying ${count} ${label}`;
      }

      function sortList() {
        if (!listContainer) return;

        let sortValue = "";
        sortSelects.forEach((s) => {
          if (s.value) sortValue = s.value;
        });

        const items = Array.from(
          listContainer.querySelectorAll(".item-card"),
        ) as HTMLElement[];

        items.sort((a, b) => {
          switch (sortValue) {
            case "title-asc":
              return (a.dataset.sortTitle || "").localeCompare(
                b.dataset.sortTitle || "",
              );
            case "title-desc":
              return (b.dataset.sortTitle || "").localeCompare(
                a.dataset.sortTitle || "",
              );
            case "date-asc":
              return (
                new Date(a.dataset.sortDate || "").getTime() -
                new Date(b.dataset.sortDate || "").getTime()
              );
            case "date-desc":
              return (
                new Date(b.dataset.sortDate || "").getTime() -
                new Date(a.dataset.sortDate || "").getTime()
              );
            default:
              return (
                parseInt(a.dataset.originalIndex || "0") -
                parseInt(b.dataset.originalIndex || "0")
              );
          }
        });

        items.forEach((item) => listContainer!.appendChild(item));
        filterList();
      }

      function filterList(updateQuery = true) {
        const searchValue = searchInput?.value.toLowerCase() || "";

        if (updateQuery) {
          const params: Record<string, string> = {};
          filterSelects.forEach((select) => {
            params[select.dataset.filterId!] = select.value;
          });
          sortSelects.forEach((select) => {
            params[`sort_${select.dataset.sortId}`] = select.value;
          });
          if (searchInput) params.search = searchInput.value;
          updateURL(params);
        }

        let visibleCount = 0;

        listItems.forEach((item) => {
          let isVisible = true;

          // Check each filter
          filterSelects.forEach((select) => {
            const filterId = select.dataset.filterId!;
            const filterValue = select.value.toLowerCase();

            if (filterValue) {
              const datasetKey =
                "filter" + filterId.charAt(0).toUpperCase() + filterId.slice(1);
              const itemValue = (item.dataset[datasetKey] || "").toLowerCase();

              const itemValues = itemValue.split(",").map((v) => v.trim());
              if (!itemValues.includes(filterValue)) {
                isVisible = false;
              }
            }
          });

          // Check search
          if (isVisible && searchValue) {
            const itemSearch = (item.dataset.search || "").toLowerCase();
            if (!itemSearch.includes(searchValue)) {
              isVisible = false;
            }
          }

          // Use style.display to override any flex/grid display properties
          item.style.display = isVisible ? "" : "none";

          if (isVisible) {
            // Update alternating classes for timeline layout
            if (layout === "timeline") {
              const contentWrapper = item.querySelector(
                ".timeline-content-wrapper",
              );
              if (contentWrapper) {
                contentWrapper.classList.remove(
                  "md:mr-auto",
                  "md:pr-16",
                  "md:ml-auto",
                  "md:pl-16",
                );

                if (visibleCount % 2 === 0) {
                  contentWrapper.classList.add("md:mr-auto", "md:pr-16");
                } else {
                  contentWrapper.classList.add("md:ml-auto", "md:pl-16");
                }
              }
            }
            visibleCount++;
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? "block" : "none";
        }
        updateResultsCount(visibleCount);
      }

      // Initialize from URL
      function initFiltersFromURL() {
        const params = new URLSearchParams(window.location.search);

        filterSelects.forEach((select) => {
          const value = params.get(select.dataset.filterId!);
          if (value) select.value = value;
        });

        sortSelects.forEach((select) => {
          const value = params.get(`sort_${select.dataset.sortId}`);
          if (value) select.value = value;
        });

        if (searchInput) {
          const search = params.get("search");
          if (search) searchInput.value = search;
        }

        if (sortSelects.length) sortList();
        else filterList(false);
      }

      // Event Listeners
      filterSelects.forEach((select) => {
        select.addEventListener("change", () => filterList());
      });

      sortSelects.forEach((select) => {
        select.addEventListener("change", () => sortList());
      });

      if (searchInput) {
        searchInput.addEventListener(
          "input",
          debounce(() => filterList(), 300),
        );
      }

      clearFiltersBtn?.addEventListener("click", () => {
        filterSelects.forEach((select) => (select.value = ""));
        sortSelects.forEach((select) => (select.value = ""));
        if (searchInput) searchInput.value = "";
        sortList();
      });

      initFiltersFromURL();
    }

    // Run on load and on Astro page changes
    document.addEventListener("DOMContentLoaded", initListFiltering);
    document.addEventListener("astro:after-swap", initListFiltering);
  </script>
</PageLayout>
