---
import PageLayout from "./PageLayout.astro";
import GradientAccent from "~/components/common/GradientAccent.astro";
import WatermarkBackground from "~/components/common/WatermarkBackground.astro";
import { pluralize } from "@aazucena/utils";

export interface FilterConfig {
  id: string;
  label: string;
  options: string[];
}

interface Props {
  title: string;
  description: string;
  watermark?: string; // NEW: Background watermark text
  filters?: FilterConfig[];
  searchPlaceholder?: string;
  maxWidth?: "5xl" | "7xl" | "full";
  ignoreMaxWidth?: boolean;
  layout?: "timeline" | "grid" | "none";
  hasItems?: boolean;
  emptyMessage?: string;
}

const {
  title,
  description,
  watermark,
  filters = [],
  searchPlaceholder = "Search...",
  maxWidth = "5xl",
  layout = "none",
  hasItems = true,
  ignoreMaxWidth = false,
  emptyMessage = "No items to display.",
} = Astro.props;

const containerClasses = {
  "5xl": "max-w-5xl",
  "7xl": "max-w-7xl",
  full: "max-w-full",
};

const maxWidthClass = containerClasses[maxWidth] || "max-w-5xl";
---

<PageLayout title={title} description={description}>
  <div class="min-h-screen bg-white dark:bg-gray-950">
    <GradientAccent />

    <!-- Header -->
    <div
      class="relative overflow-hidden border-b border-gray-100 bg-white dark:border-gray-800 dark:bg-gray-900"
    >
      <div
        class={`${maxWidthClass} mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 relative z-10`}
      >
        <h1
          class="mb-6 text-5xl font-black tracking-tighter text-gray-900 md:text-7xl dark:text-white"
        >
          {title}<span class="text-blue-600">.</span>
        </h1>
        <p
          class="max-w-3xl text-xl leading-relaxed font-medium text-gray-600 dark:text-gray-400"
        >
          {description}
        </p>
      </div>

      {watermark && <WatermarkBackground text={watermark} size="small" />}
    </div>

    {
      hasItems ? (
        <>
          {/* Filters Section */}
          <div
            class={`${!ignoreMaxWidth ? maxWidthClass : ""} mx-auto px-4 py-12 sm:px-6 lg:px-8`}
          >
            <div class="rounded-[2rem] border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900">
              <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-center">
                <h2 class="text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:text-gray-500">
                  Filter Archive
                </h2>
                <div
                  id="results-count"
                  class="text-[10px] font-black tracking-widest text-blue-600 uppercase dark:text-blue-400"
                >
                  {/* Results count injected here */}
                </div>
              </div>

              <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                {filters.map((filter) => (
                  <div>
                    <label
                      for={`${filter.id}-filter`}
                      class="mb-3 ml-2 block text-[10px] font-black tracking-widest text-gray-400 uppercase"
                    >
                      {filter.label}
                    </label>
                    <select
                      id={`${filter.id}-filter`}
                      data-filter-id={filter.id}
                      class="list-filter-select w-full cursor-pointer rounded-2xl border border-gray-100 bg-gray-50 px-5 py-3 text-gray-900 shadow-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
                    >
                      <option value="">All {pluralize(filter.label)}</option>
                      {filter.options.map((option) => (
                        <option value={option}>{option}</option>
                      ))}
                    </select>
                  </div>
                ))}

                {/* Search Input */}
                <div
                  class={
                    filters.length === 0
                      ? "md:col-span-2 lg:col-span-3"
                      : filters.length === 1
                        ? "md:col-span-1 lg:col-span-2"
                        : ""
                  }
                >
                  <label
                    for="search-input"
                    class="mb-3 ml-2 block text-[10px] font-black tracking-widest text-gray-400 uppercase"
                  >
                    Keywords
                  </label>
                  <input
                    type="text"
                    id="search-input"
                    placeholder={searchPlaceholder}
                    class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-5 py-3 text-gray-900 placeholder-gray-400 shadow-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white dark:placeholder-gray-500"
                  />
                </div>
              </div>
            </div>
          </div>

          {/* Content Area */}
          <div
            class={`${!ignoreMaxWidth ? maxWidthClass : ""} mx-auto px-4 pb-20 sm:px-6 lg:px-8`}
          >
            <div
              id="list-container"
              data-layout={layout}
              class={
                layout === "timeline"
                  ? "relative space-y-12"
                  : layout === "grid"
                    ? "grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
                    : "space-y-8"
              }
            >
              {layout === "timeline" && (
                <div
                  class="absolute top-0 bottom-0 left-0 w-px transform bg-gray-100 md:left-1/2 md:-translate-x-1/2 dark:bg-gray-800"
                  aria-hidden="true"
                />
              )}

              <slot />
            </div>

            {/* No Results Message */}
            <div id="no-results" class="hidden py-20 text-center">
              <p class="mb-8 text-lg font-medium text-gray-500 dark:text-gray-400">
                No items found matching your filters.
              </p>
              <button
                id="clear-filters-btn"
                class="rounded-2xl bg-gray-900 px-8 py-4 text-xs font-black tracking-widest text-white uppercase shadow-lg transition-all hover:bg-blue-600 active:scale-95 dark:bg-white dark:text-gray-900 dark:hover:bg-blue-50"
              >
                Reset Filters
              </button>
            </div>
          </div>
        </>
      ) : (
        <div
          class={`${!ignoreMaxWidth ? maxWidthClass : ""} mx-auto px-4 py-32 text-center sm:px-6 lg:px-8`}
        >
          <div class="mb-8 inline-flex h-20 w-20 items-center justify-center rounded-3xl border border-gray-100 bg-gray-50 text-gray-300 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-700">
            <svg
              class="h-10 w-10"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
              />
            </svg>
          </div>
          <p class="text-center text-2xl font-bold tracking-tight text-gray-400 dark:text-gray-600">
            {emptyMessage}
          </p>
        </div>
      )
    }
  </div>

  <script>
    import { updateURL } from "@aazucena/utils";
    import { en } from "make-plural/plurals";

    const plurals = en;

    // Debounce utility
    function debounce(func: Function, delay: number = 300) {
      let timeoutId: any;
      return (...args: any[]) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => func(...args), delay);
      };
    }

    function initListFiltering() {
      const filterSelects = document.querySelectorAll(
        ".list-filter-select",
      ) as NodeListOf<HTMLSelectElement>;
      const searchInput = document.getElementById(
        "search-input",
      ) as HTMLInputElement;
      const listItems = document.querySelectorAll(
        ".item-card",
      ) as NodeListOf<HTMLElement>;
      const noResults = document.getElementById("no-results") as HTMLElement;
      const clearFiltersBtn = document.getElementById(
        "clear-filters-btn",
      ) as HTMLButtonElement;
      const resultsCountDisplay = document.getElementById("results-count");
      const listContainer = document.getElementById("list-container");
      const layout = listContainer?.dataset.layout;

      if (!listItems.length && !filterSelects.length && !searchInput) return;

      function updateResultsCount(count: number) {
        if (!resultsCountDisplay) return;

        const category = plurals(count);
        const label = category === "one" ? "Entry" : "Entries";
        resultsCountDisplay.textContent = `Displaying ${count} ${label}`;
      }

      function filterList(updateQuery = true) {
        const searchValue = searchInput?.value.toLowerCase() || "";

        if (updateQuery) {
          const params: Record<string, string> = {};
          filterSelects.forEach((select) => {
            params[select.dataset.filterId!] = select.value;
          });
          if (searchInput) params.search = searchInput.value;
          updateURL(params);
        }

        let visibleCount = 0;

        listItems.forEach((item) => {
          let isVisible = true;

          // Check each filter
          filterSelects.forEach((select) => {
            const filterId = select.dataset.filterId!;
            const filterValue = select.value.toLowerCase();

            if (filterValue) {
              const datasetKey =
                "filter" + filterId.charAt(0).toUpperCase() + filterId.slice(1);
              const itemValue = (item.dataset[datasetKey] || "").toLowerCase();

              const itemValues = itemValue.split(",").map((v) => v.trim());
              if (!itemValues.includes(filterValue)) {
                isVisible = false;
              }
            }
          });

          // Check search
          if (isVisible && searchValue) {
            const itemSearch = (item.dataset.search || "").toLowerCase();
            if (!itemSearch.includes(searchValue)) {
              isVisible = false;
            }
          }

          // Use style.display to override any flex/grid display properties
          item.style.display = isVisible ? "" : "none";

          if (isVisible) {
            // Update alternating classes for timeline layout
            if (layout === "timeline") {
              const contentWrapper = item.querySelector(
                ".timeline-content-wrapper",
              );
              if (contentWrapper) {
                contentWrapper.classList.remove(
                  "md:mr-auto",
                  "md:pr-16",
                  "md:ml-auto",
                  "md:pl-16",
                );

                if (visibleCount % 2 === 0) {
                  contentWrapper.classList.add("md:mr-auto", "md:pr-16");
                } else {
                  contentWrapper.classList.add("md:ml-auto", "md:pl-16");
                }
              }
            }
            visibleCount++;
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? "block" : "none";
        }
        updateResultsCount(visibleCount);
      }

      // Initialize from URL
      function initFiltersFromURL() {
        const params = new URLSearchParams(window.location.search);

        filterSelects.forEach((select) => {
          const value = params.get(select.dataset.filterId!);
          if (value) select.value = value;
        });

        if (searchInput) {
          const search = params.get("search");
          if (search) searchInput.value = search;
        }

        filterList(false);
      }

      // Event Listeners
      filterSelects.forEach((select) => {
        select.addEventListener("change", () => filterList());
      });

      if (searchInput) {
        searchInput.addEventListener(
          "input",
          debounce(() => filterList(), 300),
        );
      }

      clearFiltersBtn?.addEventListener("click", () => {
        filterSelects.forEach((select) => (select.value = ""));
        if (searchInput) searchInput.value = "";
        filterList();
      });

      initFiltersFromURL();
    }

    // Run on load and on Astro page changes
    document.addEventListener("DOMContentLoaded", initListFiltering);
    document.addEventListener("astro:after-swap", initListFiltering);
  </script>
</PageLayout>
