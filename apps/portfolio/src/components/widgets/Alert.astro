---
import { Icon } from 'astro-icon/components';
import type { Alert as Props } from "~/types";
import { twMerge } from 'tailwind-merge';
const {
  variant = "info",
  title = await Astro.slots.render('title'),
} = Astro.props;  


const variantStyles = {
  info: 'text-blue-800 dark:text-blue-100',
  success: 'text-green-800 dark:text-green-100',
  warning: 'text-yellow-800 dark:text-yellow-100',
  error: 'text-red-800 dark:text-red-100',
};
const variantIcons = {
  info: 'info-circle',
  success: 'circle-check',
  warning: 'exclamation-circle',
  error: 'circle-x',
}
---

<section class={twMerge(variantStyles[variant], 'not-prose bg-slate-800 dark:bg-transparent')}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 text-md text-center font-medium">
    <span class="font-bold">
      <Icon name={`tabler:${variantIcons[variant]}`} class="w-5 h-5 inline-block align-text-bottom" />
    </span> 
    {title && <span class="text-white" set:html={title} />}
  </div>
</section>
