---
interface Props {
  label?: string;
  variant?: "green" | "blue" | "gray" | "yellow" | "red";
  animated?: boolean;
  size?: "sm" | "md";
  class?: string;
}

const {
  label,
  variant = "gray",
  animated = false,
  size = "md",
  class: className = "",
} = Astro.props;

// Mirrors the ui Badge status grammar: success mint, info signal, warning ◆, alert ▲.
const variantClasses = {
  green: "border-success/60 bg-success-subtle text-success",
  blue: "border-signal/60 bg-signal-faint text-signal",
  gray: "border-rule text-muted-foreground",
  yellow: "border-warning/60 bg-warning-subtle text-warning",
  red: "border-alert bg-transparent text-alert",
};

const markers = {
  yellow: "◆",
  red: "▲",
};
const marker = markers[variant as keyof typeof markers];

const sizeMap = {
  sm: "px-2 py-0.5 text-[10px]",
  md: "px-2.5 py-1 text-[11px]",
};
---

<span
  class:list={[
    "rounded-badge inline-flex items-center gap-1.5 border font-mono font-medium tracking-[0.2em] uppercase",
    variantClasses[variant],
    sizeMap[size],
    className,
  ]}
>
  {animated && (
    <div
      class="size-1.5 rounded-full bg-current motion-safe:animate-pulse"
      aria-hidden="true"
    />
  )}
  {marker && <span aria-hidden="true">{marker}</span>}
  {label}
</span>
