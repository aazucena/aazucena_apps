---
interface Props {
  value?: string;
  label?: string;
  description?: string;
}

const { value, label, description } = Astro.props;
---

<div class="border-rule bg-panel rounded-card p-panel flex flex-col items-center border text-center">
  <div class="text-signal mb-2 font-mono text-3xl font-semibold md:text-4xl">
    {value}
  </div>
  <div class="micro-label text-foreground mb-1">{label}</div>
  {description && (
    <div class="text-muted-foreground text-xs">{description}</div>
  )}
</div>
