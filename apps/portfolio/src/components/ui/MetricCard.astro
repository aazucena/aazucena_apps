---
interface Props {
  value?: string;
  label?: string;
  description?: string;
}

const { value, label, description } = Astro.props;
---

<div
  class="group flex flex-col items-center rounded-xl border border-gray-200 bg-white p-6 text-center shadow-sm transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800/50"
>
  <div
    class="mb-2 bg-gradient-to-br from-blue-600 to-purple-600 bg-clip-text text-3xl font-extrabold text-transparent transition-transform duration-300 group-hover:scale-105 md:text-4xl dark:from-blue-400 dark:to-cyan-400"
  >
    {value}
  </div>
  <div
    class="mb-1 text-sm font-bold tracking-wider text-gray-900 uppercase dark:text-white"
  >
    {label}
  </div>
  {
    description && (
      <div class="text-xs text-gray-500 dark:text-gray-400">{description}</div>
    )
  }
</div>
