---
import { ChangelogSections } from "~/components/ui/ChangelogSections";
import type { ChangelogEntry } from "~/components/ui/ChangelogSections";

interface Props {
  entries: ChangelogEntry[];
}

const { entries } = Astro.props;
---

<div class="relative mt-4">
  <div
    class="bg-rule-strong absolute top-0 left-2 h-full w-px"
    aria-hidden="true"
  ></div>

  <div class="space-y-10 pl-8 md:space-y-12 md:pl-10">
    {entries.map((entry) => (
      <div class="relative">
        <div class="absolute top-2 -left-8 flex w-4 items-center justify-center md:-left-10">
          <span class="relative flex h-2.5 w-2.5">
            {!entry.isPhase && (
              <span
                class="bg-signal/40 absolute inline-flex h-full w-full rounded-full motion-safe:animate-ping"
                aria-hidden="true"
              />
            )}
            <span
              class:list={[
                "bg-background relative inline-flex h-2.5 w-2.5 rounded-full border-2",
                entry.isPhase
                  ? "border-rule-strong ring-rule ring-4"
                  : "border-signal",
              ]}
            />
          </span>
        </div>

        <div class="mb-4 flex flex-wrap items-baseline gap-3">
          {entry.isPhase ? (
            <>
              <h2 class="text-foreground text-xl font-semibold tracking-tight">
                {entry.label}
              </h2>
              {entry.date && (
                <span class="text-muted-foreground font-mono text-xs">
                  {entry.date}
                </span>
              )}
            </>
          ) : (
            <h2 class="text-signal text-xl font-semibold tracking-tight">
              Latest
            </h2>
          )}
        </div>

        <ChangelogSections sections={entry.sections} client:visible />
      </div>
    ))}
  </div>
</div>
