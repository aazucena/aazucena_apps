---
import DefaultLoader from "~/components/common/loaders/DefaultLoader.astro";

---
<preloader>
  <div id="preloader" class="min-h-screen z-[1000] flex flex-col items-center justify-center">
    <slot>
      <DefaultLoader color="#4CAF50" />
    </slot>
  </div>
</preloader>
<style>
  #preloader {
    background: #fff;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    /* visibility: visible; */
    transition: opacity 2s linear;
  }
  #preloader.hidden {
    opacity: 0;
    /* visibility: hidden; */
    transition: opacity 2s linear;
  }
</style>
