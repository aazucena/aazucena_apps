                      </svg>
                    ) : tech.name === "Tailwind CSS" ? (
                      <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 256 154"
                        xmlns="http://www.w3.org/2000/svg"
                        preserveAspectRatio="xMidYMid"
                      >
                        <path d="M128 0C93.867 0 72.533 17.067 64 51.2 76.8 34.133 91.733 27.733 108.8 32c9.737 2.434 16.697 9.499 24.401 17.318C145.751 62.057 160.275 76.8 192 76.8c34.133 0 55.467-17.067 64-51.2-12.8 17.067-27.733 23.467-44.8 19.2-9.737-2.434-16.697-9.499-24.401-17.318C174.249 14.743 159.725 0 128 0ZM64 76.8C29.867 76.8 8.533 93.867 0 128c12.8-17.067 27.733-23.467 44.8-19.2 9.737 2.434 16.697 9.499 24.401 17.318C81.751 138.857 96.275 153.6 128 153.6c34.133 0 55.467-17.067 64-51.2-12.8 17.067-27.733 23.467-44.8 19.2-9.737-2.434-16.697-9.499-24.401-17.318C110.249 91.543 95.725 76.8 64 76.8Z" />
                      </svg>
                    ) : tech.name === "Vite" ? (
                      <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 256 257"
                        xmlns="http://www.w3.org/2000/svg"
                        preserveAspectRatio="xMidYMid"
                      >
                        <defs>
                          <linearGradient
                            x1="-.828%"
                            y1="7.652%"
                            x2="57.636%"
                            y2="78.411%"
                            id="a"
                          >
                            <stop stop-color="#41D1FF" offset="0%" />
                            <stop stop-color="#BD34FE" offset="100%" />
                          </linearGradient>
                          <linearGradient
                            x1="43.376%"
                            y1="2.242%"
                            x2="50.316%"
                            y2="89.03%"
                            id="b"
                          >
                            <stop stop-color="#FFEA83" offset="0%" />
                            <stop stop-color="#FFDD35" offset="8.333%" />
                            <stop stop-color="#FFA800" offset="100%" />
                          </linearGradient>
                        </defs>
                        <path
                          d="M255.153 37.938 134.897 252.976c-2.483 4.44-8.862 4.466-11.382.048L.875 37.958c-2.746-4.814 1.371-10.646 6.827-9.67l120.385 21.517a6.537 6.537 0 0 0 2.322-.004l117.867-21.483c5.438-.991 9.574 4.796 6.877 9.62Z"
                          fill="url(#a)"
                        />
                        <path
                          d="M185.432.063 96.44 17.501a3.268 3.268 0 0 0-2.634 3.014l-5.474 92.456a3.268 3.268 0 0 0 3.997 3.378l24.777-5.718c2.318-.535 4.413 1.507 3.936 3.838l-7.361 36.047c-.495 2.426 1.782 4.5 4.151 3.78l15.304-4.649c2.372-.72 4.652 1.36 4.15 3.788l-11.698 56.621c-.732 3.542 3.979 5.473 5.943 2.437l1.313-2.028 72.516-144.72c1.215-2.423-.88-5.186-3.54-4.672l-25.505 4.922c-2.396.462-4.435-1.77-3.759-4.114l16.646-57.705c.677-2.35-1.37-4.583-3.769-4.113Z"
                          fill="url(#b)"
                        />
                      </svg>
                    ) : (
                      <Globe size={20} />
                    )}
                  </span>
                ))
              : null
          }
        </div>
      </div>
    </div>
  </div>
</footer>
