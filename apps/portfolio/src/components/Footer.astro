---
import { 
  BrandGithub, 
  BrandLinkedin, 
  BrandTwitter, 
  BrandInstagram, 
  BrandYoutube,
  Globe,
  ArrowUpRight,
  Heart,
  Envelope
} from '@mynaui/icons-react';

interface SocialLink {
  platform: string;
  url: string;
  icon?: string;
  text?: string;
  openInNewTab: boolean;
}

interface Props {
  siteName: string;
  socialLinks?: SocialLink[];
}

const { siteName, socialLinks = [] } = Astro.props;
const currentYear = new Date().getFullYear();

// Platform icons component mapping
const getPlatformIcon = (platform: string) => {
  switch (platform) {
    case 'GitHub': return BrandGithub;
    case 'LinkedIn': return BrandLinkedin;
    case 'Twitter': return BrandTwitter;
    case 'Instagram': return BrandInstagram;
    case 'YouTube': return BrandYoutube;
    default: return Globe;
  }
};
---

<footer class="bg-white dark:bg-gray-950 border-t border-gray-100 dark:border-gray-900 relative overflow-hidden transition-colors duration-300">
  <!-- Background Watermark (Subtle) -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 pointer-events-none select-none opacity-[0.02] dark:opacity-[0.04] whitespace-nowrap z-0">
    <span class="text-[15rem] md:text-[20rem] font-black uppercase tracking-tighter italic">AZUCENA</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 lg:gap-12">
      
      <!-- Brand Section -->
      <div class="col-span-1 lg:col-span-1 space-y-8">
        <div>
          <h3 class="text-3xl font-black text-gray-900 dark:text-white tracking-tighter">
            {siteName}<span class="text-blue-600">.</span>
          </h3>
          <p class="mt-6 text-sm text-gray-500 dark:text-gray-400 leading-relaxed font-medium max-w-xs">
            Architecting high-performance digital systems with a focus on logic, scale, and human-centric design.
          </p>
        </div>
        
        <!-- Status Indicator -->
        <div class="inline-flex items-center gap-3 px-4 py-2 bg-gray-50 dark:bg-gray-900/50 rounded-full border border-gray-100 dark:border-gray-800 shadow-sm">
          <div class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </div>
          <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">Systems Operational</span>
        </div>
      </div>

      <!-- Sitemap -->
      <div class="space-y-8">
        <h4 class="text-[10px] font-black text-gray-900 dark:text-white uppercase tracking-[0.3em]">
          Explore
        </h4>
        <nav class="flex flex-col space-y-4">
          {[
            { label: 'Projects Portfolio', href: '/projects' },
            { label: 'Career Journey', href: '/experiences' },
            { label: 'Technical Expertise', href: '/skills' },
            { label: 'Technical Journal', href: '/blog' },
            { label: 'Biography', href: '/about' }
          ].map(link => (
            <a href={link.href} class="text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-bold group flex items-center gap-2">
              {link.label}
              <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-opacity" />
            </a>
          ))}
        </nav>
      </div>

      <!-- Legal & Social -->
      <div class="space-y-8">
        <h4 class="text-[10px] font-black text-gray-900 dark:text-white uppercase tracking-[0.3em]">
          Resources
        </h4>
        <nav class="flex flex-col space-y-4">
          <a href="/privacy" class="text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-bold group flex items-center gap-2">
            Privacy Framework
            <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-opacity" />
          </a>
          <a href="/terms" class="text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-bold group flex items-center gap-2">
            Terms of Service
            <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-opacity" />
          </a>
          <a href="/rss.xml" class="text-sm text-gray-500 dark:text-gray-400 hover:text-orange-500 transition-colors font-bold flex items-center gap-2 group">
            RSS Feed
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-8.18v4.831c10.555.062 19.121 8.505 19.183 19.001h4.817c-.062-13.209-7.118-23.77-24-23.832z"/></svg>
          </a>
          <a href="/sitemap-index.xml" class="text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-bold flex items-center gap-2 group">
            Sitemap
            <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-opacity" />
          </a>
        </nav>
      </div>

      <!-- Social Links -->
      <div class="space-y-8">
        <h4 class="text-[10px] font-black text-gray-900 dark:text-white uppercase tracking-[0.3em]">
          Connect
        </h4>
        <div class="flex flex-wrap gap-3">
          {socialLinks.map((link) => {
            const Icon = getPlatformIcon(link.platform);
            return (
              <a
                href={link.url}
                target={link.openInNewTab ? '_blank' : undefined}
                rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                class="w-12 h-12 rounded-[1.25rem] bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 flex items-center justify-center text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-white dark:hover:bg-gray-800 hover:shadow-xl hover:border-blue-500/20 transition-all duration-500"
                aria-label={link.text || link.platform}
              >
                <Icon size={20} />
              </a>
            )
          })}
          <a
            href="/contact"
            class="w-12 h-12 rounded-[1.25rem] bg-gray-900 dark:bg-white flex items-center justify-center text-white dark:text-gray-900 hover:bg-blue-600 dark:hover:bg-blue-50 transition-all duration-500 shadow-lg"
            aria-label="Contact"
          >
            <Envelope size={20} />
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright & Tech Stack -->
    <div class="mt-24 pt-12 border-t border-gray-100 dark:border-gray-900 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex flex-col items-center md:items-start gap-2">
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 dark:text-gray-600">
          © {currentYear} {siteName}
        </p>
        <p class="text-[9px] font-bold text-gray-300 dark:text-gray-700 uppercase tracking-widest">
          Engineered with precision in Canada
        </p>
      </div>
      
      <div class="flex items-center gap-6 text-gray-300 dark:text-gray-800">
        <span class="text-[9px] font-black uppercase tracking-[0.3em]">Built with</span>
        <div class="flex gap-5">
          <span class="hover:text-gray-600 dark:hover:text-gray-400 transition-colors cursor-default" title="Astro">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8.5 24c5 0 7.5-4 7.5-9 0-5.5-4.5-11-4.5-11C11 4 11 13 8.5 13c-2.5 0-2.5-9-5-9 0 0-4.5 5.5-4.5 11 0 5 2.5 9 7.5 9zM12 7s4.5 5.5 4.5 11c0 5-2.5 9-7.5 9-5 0-7.5-4-7.5-9 0-5.5 4.5-11 4.5-11 0 0 0 9 2.5 9 2.5 0 2.5-9 5-9z"/></svg>
          </span>
          <span class="hover:text-gray-600 dark:hover:text-gray-400 transition-colors cursor-default" title="React">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 18a6 6 0 100-12 6 6 0 000 12zM24 12c0 1-.8 2.7-2.5 4.8-1.2 1.4-2.6 2.8-3.9 3.9-2.1 1.7-3.8 2.5-4.8 2.5-1.2 0-2.9-.8-5-2.5-1.1-1.1-2.5-2.5-3.9-3.9C2.2 14.7 1.4 13 1.4 12c0-1.1.8-2.8 2.5-4.8 1.4-1.4 2.8-2.8 3.9-3.9 2.1-1.7 3.8-2.5 4.8-2.5 1.2 0 2.9.8 5 2.5 1.1 1.1 2.5 2.5 3.9 3.9 1.7 2.1 2.5 3.8 2.5 4.8z"/></svg>
          </span>
          <span class="hover:text-gray-600 dark:hover:text-gray-400 transition-colors cursor-default" title="Tailwind CSS">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"/></svg>
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>