---
import {
  ArrowUpRight,
  BrandGithub,
  BrandLinkedin,
  Instagram,
  Twitter,
  Youtube,
  Envelope,
  Globe,
  Kofi,
} from "@aazucena/icons";

import { getAvailabilityIndicator } from "@aazucena/utils";
import { toTitleCase } from "@aazucena/utils";
import type {
  NavigationItem,
  SocialLink,
  TechStackItem,
} from "@aazucena/types";
import { IntegrityBadge } from "./IntegrityBadge";

interface Props {
  siteName: string;
  socialLinks?: SocialLink[];
  availabilityStatus?: string;
  navigationSections: NavigationItem[]; // WRAPPER items containing grouped links
  footerBrandDescription?: string;
  footerLocationTagline?: string;
  footerBuiltWithLabel?: string;
  techStack?: TechStackItem[];
}

const {
  siteName,
  socialLinks = [],
  availabilityStatus = "Systems Operational",
  navigationSections,
  footerBrandDescription,
  footerLocationTagline,
  footerBuiltWithLabel = "Built with",
  techStack = [],
} = Astro.props;

// Filter for WRAPPER type items (footer sections)
// Note: WRAPPER items serve dual purposes:
// 1. Top-level WRAPPERs = section groupings (Explore, Resources)
// 2. Nested WRAPPERs = static/generated files (RSS, Sitemap) - not CMS content types
const footerSections = navigationSections.filter(
  (item) => item.type === "WRAPPER",
);

const isUtilityLink = (path?: string | null) =>
  !!path && (path.includes("rss.xml") || path.includes("sitemap"));

const utilityLinks = footerSections.flatMap(
  (section) => section.items?.filter((link) => isUtilityLink(link.path)) ?? [],
);

const currentYear = new Date().getFullYear();

// Get dynamic indicator styles
const indicator = getAvailabilityIndicator(availabilityStatus);

// Platform icons component mapping
const getPlatformIcon = (platform: string) => {
  switch (platform) {
    case "GitHub":
      return BrandGithub;
    case "LinkedIn":
      return BrandLinkedin;
    case "Twitter":
      return Twitter;
    case "Instagram":
      return Instagram;
    case "YouTube":
      return Youtube;
    case "Ko-fi":
      return Kofi;
    default:
      return Globe;
  }
};
---

<footer
  class="relative overflow-hidden border-t border-gray-100 bg-white transition-colors duration-300 dark:border-gray-900 dark:bg-gray-950"
>
  <!-- Background Watermark (Subtle) -->
  <div
    class="pointer-events-none absolute bottom-0 left-1/2 z-0 -translate-x-1/2 whitespace-nowrap opacity-[0.02] select-none dark:opacity-[0.04]"
  >
    <span
      class="text-[15rem] font-black tracking-tighter uppercase italic md:text-[20rem]"
      >AZUCENA</span
    >
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-12">
      <!-- Brand Section -->
      <div
        class="col-span-2 space-y-8 text-center md:col-span-1 md:text-left lg:col-span-1"
      >
        <div>
          <h3
            class="text-3xl font-black tracking-tighter text-gray-900 dark:text-white"
          >
            {toTitleCase(siteName)}<span class="text-blue-600">.</span>
          </h3>
          {
            footerBrandDescription && (
              <p class="mx-auto mt-6 max-w-xs text-sm leading-relaxed font-medium text-gray-500 md:mx-0 dark:text-gray-400">
                {footerBrandDescription}
              </p>
            )
          }
        </div>

        <!-- Status Indicator -->
        <div class="flex justify-center md:justify-start">
          <div
            class="inline-flex items-center gap-3 rounded-full border border-gray-100 bg-gray-50 px-4 py-2 shadow-sm dark:border-gray-800 dark:bg-gray-900/50"
          >
            <div class="relative flex h-2 w-2">
              {
                indicator.pulse && (
                  <span
                    class={`absolute inline-flex h-full w-full animate-ping rounded-full ${indicator.color} opacity-75`}
                  />
                )
              }
              <span
                class={`relative inline-flex rounded-full h-2 w-2 ${indicator.color}`}
              ></span>
            </div>
            <span class="text-xs font-bold text-gray-500 dark:text-gray-400"
              >{toTitleCase(availabilityStatus)}</span
            >
          </div>
        </div>
      </div>

      <!-- Dynamic Navigation Sections (from WRAPPER items) -->
      {
        footerSections.map((section) => {
          const visibleItems =
            section.items?.filter((link) => !isUtilityLink(link.path)) ?? [];
          if (visibleItems.length === 0) return null;
          return (
            <div class="space-y-6">
              <h4 class="text-sm font-bold text-gray-900 dark:text-white">
                {toTitleCase(section.title)}
              </h4>
              <nav class="flex flex-col items-start space-y-4">
                {visibleItems.map((link) => (
                  <a
                    href={link.path || undefined}
                    class="group flex items-center gap-2 text-sm font-bold text-gray-500 transition-colors hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400"
                    target={link.type === "EXTERNAL" ? "_blank" : undefined}
                    rel={
                      link.type === "EXTERNAL"
                        ? "noopener noreferrer"
                        : undefined
                    }
                  >
                    {link.title}
                    <ArrowUpRight
                      size={14}
                      className="opacity-0 transition-opacity group-hover:opacity-100"
                    />
                  </a>
                ))}
              </nav>
            </div>
          );
        })
      }

      <!-- Social Links -->
      <div class="col-span-2 space-y-8 text-center md:col-span-1 md:text-left">
        <h4 class="text-sm font-bold text-gray-900 dark:text-white">
          {toTitleCase("Connect")}
        </h4>
        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
          {
            socialLinks.map((link) => {
              const Icon = getPlatformIcon(link.platform);
              return (
                <a
                  href={link.url}
                  target={link.openInNewTab ? "_blank" : undefined}
                  rel={link.openInNewTab ? "noopener noreferrer" : undefined}
                  class="flex h-12 w-12 items-center justify-center rounded-[1.25rem] border border-gray-100 bg-gray-50 text-gray-500 transition-all duration-500 hover:border-blue-500/20 hover:bg-white hover:text-blue-600 hover:shadow-xl dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-blue-400"
                  aria-label={link.text || link.platform}
                >
                  <Icon size={20} />
                </a>
              );
            })
          }
          <a
            href="/contact"
            class="flex h-12 w-12 items-center justify-center rounded-[1.25rem] bg-gray-900 text-white shadow-lg transition-all duration-500 hover:bg-blue-600 dark:bg-white dark:text-gray-900 dark:hover:bg-blue-50"
            aria-label="Contact"
          >
            <Envelope size={20} />
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright & Tech Stack -->
    <div
      class="mt-24 flex flex-col items-center justify-between gap-8 border-t border-gray-100 pt-12 md:flex-row dark:border-gray-900"
    >
      <div class="flex flex-col items-center gap-4 md:items-start">
        <div class="flex flex-col items-center gap-2 md:items-start">
          <p class="text-xs font-bold text-gray-400 dark:text-gray-600">
            © {currentYear}
            {toTitleCase(siteName)}
          </p>
          {
            footerLocationTagline && (
              <p class="text-[10px] font-medium tracking-wide text-gray-300 dark:text-gray-700">
                {footerLocationTagline}
              </p>
            )
          }
        </div>
        {
          utilityLinks.length > 0 && (
            <div class="flex items-center gap-4">
              {utilityLinks.map((link) => (
                <a
                  href={link.path || undefined}
                  class="text-[10px] font-bold text-gray-300 transition-colors hover:text-gray-500 dark:text-gray-700 dark:hover:text-gray-400"
                  target={link.type === "EXTERNAL" ? "_blank" : undefined}
                  rel={
                    link.type === "EXTERNAL" ? "noopener noreferrer" : undefined
                  }
                >
                  {link.title}
                </a>
              ))}
            </div>
          )
        }
        <IntegrityBadge client:load />
      </div>

      <div class="flex items-center gap-6 text-gray-300 dark:text-gray-800">
        <span class="text-[10px] font-bold"
          >{toTitleCase(footerBuiltWithLabel)}</span
        >
        <div class="flex gap-5">
          {
            techStack.length > 0
              ? techStack.map((tech) => (
                  <span
                    class="cursor-default transition-colors hover:text-gray-600 dark:hover:text-gray-400"
                    title={tech.iconTitle}
                  >
                    {/* Inline SVG fallbacks for known tech */}
                    {tech.name === "Astro" ? (
                      <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 256 366"
                        xmlns="http://www.w3.org/2000/svg"
                        preserveAspectRatio="xMidYMid"
                      >
                        <path d="M182.022 9.147c2.982 3.702 4.502 8.697 7.543 18.687L256 246.074a276.467 276.467 0 0 0-79.426-26.891L133.318 73.008a5.63 5.63 0 0 0-10.802.017L79.784 219.11A276.453 276.453 0 0 0 0 246.04L66.76 27.783c3.051-9.972 4.577-14.959 7.559-18.654a24.541 24.541 0 0 1 9.946-7.358C88.67 0 93.885 0 104.314 0h47.683c10.443 0 15.664 0 20.074 1.774a24.545 24.545 0 0 1 9.95 7.373Z" />
                        <path
                          fill="#FF5D01"
                          d="M189.972 256.46c-10.952 9.364-32.812 15.751-57.992 15.751-30.904 0-56.807-9.621-63.68-22.56-2.458 7.415-3.009 15.903-3.009 21.324 0 0-1.619 26.623 16.898 45.14 0-9.615 7.795-17.41 17.41-17.41 16.48 0 16.46 14.378 16.446 26.043l-.001 1.041c0 17.705 10.82 32.883 26.21 39.28a35.685 35.685 0 0 1-3.588-15.647c0-16.886 9.913-23.173 21.435-30.48 9.167-5.814 19.353-12.274 26.372-26.043a49.143 49.143 0 0 0 3.5-36.425Z"
                        />
                      </svg>
                    ) : tech.name === "React" ? (
                      <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 256 228"
                        xmlns="http://www.w3.org/2000/svg"
                        preserveAspectRatio="xMidYMid"
