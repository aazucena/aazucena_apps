---
import {
ArrowUpRight,
BrandGithub,
BrandInstagram,
BrandLinkedin,
BrandTwitter,
BrandYoutube,
Envelope,
Globe
} from '@mynaui/icons-react';

import { getAvailabilityIndicator } from '~/lib/utils/availability';
import { toTitleCase } from '~/lib/utils/text';
import type { NavigationItem } from '~/lib/validators/navigation';
import { IntegrityBadge } from './telemetry/IntegrityBadge';

interface SocialLink {
  platform: string;
  url: string;
  icon?: string;
  text?: string;
  openInNewTab: boolean;
}

interface TechStackItem {
  name: string;
  iconTitle: string;
  iconUrl?: string;
  sort: number;
}

interface Props {
  siteName: string;
  socialLinks?: SocialLink[];
  availabilityStatus?: string;
  navigationSections: NavigationItem[]; // WRAPPER items containing grouped links
  footerBrandDescription?: string;
  footerLocationTagline?: string;
  footerBuiltWithLabel?: string;
  techStack?: TechStackItem[];
}

const {
  siteName,
  socialLinks = [],
  availabilityStatus = 'Systems Operational',
  navigationSections,
  footerBrandDescription,
  footerLocationTagline,
  footerBuiltWithLabel = 'Built with',
  techStack = [],
} = Astro.props;

// Filter for WRAPPER type items (footer sections)
// Note: WRAPPER items serve dual purposes:
// 1. Top-level WRAPPERs = section groupings (Explore, Resources)
// 2. Nested WRAPPERs = static/generated files (RSS, Sitemap) - not CMS content types
const footerSections = navigationSections.filter(item => item.type === 'WRAPPER');
const currentYear = new Date().getFullYear();

// Get dynamic indicator styles
const indicator = getAvailabilityIndicator(availabilityStatus);

// Platform icons component mapping
const getPlatformIcon = (platform: string) => {
  switch (platform) {
    case 'GitHub': return BrandGithub;
    case 'LinkedIn': return BrandLinkedin;
    case 'Twitter': return BrandTwitter;
    case 'Instagram': return BrandInstagram;
    case 'YouTube': return BrandYoutube;
    default: return Globe;
  }
};
---

<footer class="bg-white dark:bg-gray-950 border-t border-gray-100 dark:border-gray-900 relative overflow-hidden transition-colors duration-300">
  <!-- Background Watermark (Subtle) -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 pointer-events-none select-none opacity-[0.02] dark:opacity-[0.04] whitespace-nowrap z-0">
    <span class="text-[15rem] md:text-[20rem] font-black uppercase tracking-tighter italic">AZUCENA</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 lg:gap-12">
      
      <!-- Brand Section -->
      <div class="col-span-1 lg:col-span-1 space-y-8">
        <div>
          <h3 class="text-3xl font-black text-gray-900 dark:text-white tracking-tighter">
            {toTitleCase(siteName)}<span class="text-blue-600">.</span>
          </h3>
          {footerBrandDescription && (
            <p class="mt-6 text-sm text-gray-500 dark:text-gray-400 leading-relaxed font-medium max-w-xs">
              {footerBrandDescription}
            </p>
          )}
        </div>
        
        <!-- Status Indicator -->
        <div class="inline-flex items-center gap-3 px-4 py-2 bg-gray-50 dark:bg-gray-900/50 rounded-full border border-gray-100 dark:border-gray-800 shadow-sm">
          <div class="relative flex h-2 w-2">
            {indicator.pulse && (
              <span class={`animate-ping absolute inline-flex h-full w-full rounded-full ${indicator.color} opacity-75`}></span>
            )}
            <span class={`relative inline-flex rounded-full h-2 w-2 ${indicator.color}`}></span>
          </div>
          <span class="text-xs font-bold text-gray-500 dark:text-gray-400">{toTitleCase(availabilityStatus)}</span>
        </div>
      </div>

      <!-- Dynamic Navigation Sections (from WRAPPER items) -->
      {footerSections.map((section) => (
        <div class="space-y-8">
          <h4 class="text-sm font-bold text-gray-900 dark:text-white">
            {toTitleCase(section.title)}
          </h4>
          <nav class="flex flex-col space-y-4">
            {section.items?.map((link) => {
              const isRss = link.path?.includes('rss.xml');
              return (
                <a
                  href={link.path || undefined}
                  class={`text-sm text-gray-500 dark:text-gray-400 ${isRss ? 'hover:text-orange-500' : 'hover:text-blue-600 dark:hover:text-blue-400'} transition-colors font-bold flex items-center gap-2 group`}
                  target={link.type === 'EXTERNAL' ? '_blank' : undefined}
                  rel={link.type === 'EXTERNAL' ? 'noopener noreferrer' : undefined}
                >
                  {link.title}
                  {isRss ? (
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-8.18v4.831c10.555.062 19.121 8.505 19.183 19.001h4.817c-.062-13.209-7.118-23.77-24-23.832z"/></svg>
                  ) : (
                    <ArrowUpRight size={14} className="opacity-0 group-hover:opacity-100 transition-opacity" />
                  )}
                </a>
              );
            })}
          </nav>
        </div>
      ))}

      <!-- Social Links -->
      <div class="space-y-8">
        <h4 class="text-sm font-bold text-gray-900 dark:text-white">
          {toTitleCase('Connect')}
        </h4>
        <div class="flex flex-wrap gap-3">
          {socialLinks.map((link) => {
            const Icon = getPlatformIcon(link.platform);
            return (
              <a
                href={link.url}
                target={link.openInNewTab ? '_blank' : undefined}
                rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                class="w-12 h-12 rounded-[1.25rem] bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 flex items-center justify-center text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-white dark:hover:bg-gray-800 hover:shadow-xl hover:border-blue-500/20 transition-all duration-500"
                aria-label={link.text || link.platform}
              >
                <Icon size={20} />
              </a>
            )
          })}
          <a
            href="/contact"
            class="w-12 h-12 rounded-[1.25rem] bg-gray-900 dark:bg-white flex items-center justify-center text-white dark:text-gray-900 hover:bg-blue-600 dark:hover:bg-blue-50 transition-all duration-500 shadow-lg"
            aria-label="Contact"
          >
            <Envelope size={20} />
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright & Tech Stack -->
    <div class="mt-24 pt-12 border-t border-gray-100 dark:border-gray-900 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex flex-col items-center md:items-start gap-4">
        <div class="flex flex-col items-center md:items-start gap-2">
          <p class="text-xs font-bold text-gray-400 dark:text-gray-600">
            © {currentYear} {toTitleCase(siteName)}
          </p>
          {footerLocationTagline && (
            <p class="text-[10px] font-medium text-gray-300 dark:text-gray-700 tracking-wide">
              {footerLocationTagline}
            </p>
          )}
        </div>
        <IntegrityBadge client:load />
      </div>
      
      <div class="flex items-center gap-6 text-gray-300 dark:text-gray-800">
        <span class="text-[10px] font-bold">{toTitleCase(footerBuiltWithLabel)}</span>
        <div class="flex gap-5">
          {techStack.length > 0 ? (
            techStack.map((tech) => (
              <span
                class="hover:text-gray-600 dark:hover:text-gray-400 transition-colors cursor-default"
                title={tech.iconTitle}
              >
                {/* Inline SVG fallbacks for known tech */}
                {tech.name === 'Astro' ? (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 256 366" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid"><path d="M182.022 9.147c2.982 3.702 4.502 8.697 7.543 18.687L256 246.074a276.467 276.467 0 0 0-79.426-26.891L133.318 73.008a5.63 5.63 0 0 0-10.802.017L79.784 219.11A276.453 276.453 0 0 0 0 246.04L66.76 27.783c3.051-9.972 4.577-14.959 7.559-18.654a24.541 24.541 0 0 1 9.946-7.358C88.67 0 93.885 0 104.314 0h47.683c10.443 0 15.664 0 20.074 1.774a24.545 24.545 0 0 1 9.95 7.373Z"/><path fill="#FF5D01" d="M189.972 256.46c-10.952 9.364-32.812 15.751-57.992 15.751-30.904 0-56.807-9.621-63.68-22.56-2.458 7.415-3.009 15.903-3.009 21.324 0 0-1.619 26.623 16.898 45.14 0-9.615 7.795-17.41 17.41-17.41 16.48 0 16.46 14.378 16.446 26.043l-.001 1.041c0 17.705 10.82 32.883 26.21 39.28a35.685 35.685 0 0 1-3.588-15.647c0-16.886 9.913-23.173 21.435-30.48 9.167-5.814 19.353-12.274 26.372-26.043a49.143 49.143 0 0 0 3.5-36.425Z"/></svg>
                ) : tech.name === 'React' ? (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 256 228" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid"><path d="M210.483 73.824a171.49 171.49 0 0 0-8.24-2.597c.465-1.9.893-3.777 1.273-5.621 6.238-30.281 2.16-54.676-11.769-62.708-13.355-7.7-35.196.329-57.254 19.526a171.23 171.23 0 0 0-6.375 5.848 155.866 155.866 0 0 0-4.241-3.917C100.759 3.829 77.587-4.822 63.673 3.233 50.33 10.957 46.379 33.89 51.995 62.588a170.974 170.974 0 0 0 1.892 8.48c-3.28.932-6.445 1.924-9.474 2.98C17.309 83.498 0 98.307 0 113.668c0 15.865 18.582 31.778 46.812 41.427a145.52 145.52 0 0 0 6.921 2.165 167.467 167.467 0 0 0-2.01 9.138c-5.354 28.2-1.173 50.591 12.134 58.266 13.744 7.926 36.812-.22 59.273-19.855a145.567 145.567 0 0 0 5.342-4.923 168.064 168.064 0 0 0 6.92 6.314c21.758 18.722 43.246 26.282 56.54 18.586 13.731-7.949 18.194-32.003 12.4-61.268a145.016 145.016 0 0 0-1.535-6.842c1.62-.48 3.21-.974 4.76-1.488 29.348-9.723 48.443-25.443 48.443-41.52 0-15.417-17.868-30.326-45.517-39.844Zm-6.365 70.984c-1.4.463-2.836.91-4.3 1.345-3.24-10.257-7.612-21.163-12.963-32.432 5.106-11 9.31-21.767 12.459-31.957 2.619.758 5.16 1.557 7.61 2.4 23.69 8.156 38.14 20.213 38.14 29.504 0 9.896-15.606 22.743-40.946 31.14Zm-10.514 20.834c2.562 12.94 2.927 24.64 1.23 33.787-1.524 8.219-4.59 13.698-8.382 15.893-8.067 4.67-25.32-1.4-43.927-17.412a156.726 156.726 0 0 1-6.437-5.87c7.214-7.889 14.423-17.06 21.459-27.246 12.376-1.098 24.068-2.894 34.671-5.345.522 2.107.986 4.173 1.386 6.193ZM87.276 214.515c-7.882 2.783-14.16 2.863-17.955.675-8.075-4.657-11.432-22.636-6.853-46.752a156.923 156.923 0 0 1 1.869-8.499c10.486 2.32 22.093 3.988 34.498 4.994 7.084 9.967 14.501 19.128 21.976 27.15a134.668 134.668 0 0 1-4.877 4.492c-9.933 8.682-19.886 14.842-28.658 17.94ZM50.35 144.747c-12.483-4.267-22.792-9.812-29.858-15.863-6.35-5.437-9.555-10.836-9.555-15.216 0-9.322 13.897-21.212 37.076-29.293 2.813-.98 5.757-1.905 8.812-2.773 3.204 10.42 7.406 21.315 12.477 32.332-5.137 11.18-9.