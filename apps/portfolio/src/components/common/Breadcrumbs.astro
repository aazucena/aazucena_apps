---
export interface BreadcrumbItem {
  label: string;
  href?: string;
  class?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav
  class:list={[
    "mb-12 flex text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:text-gray-500 print:hidden",
    className,
  ]}
  aria-label="Breadcrumb"
>
  <ol class="flex items-center gap-2">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {item.href ? (
            <a href={item.href} class="transition-colors hover:text-blue-600">
              {item.label}
            </a>
          ) : (
            <span
              class={`max-w-[150px] truncate text-blue-600 ${item.class || ""}`}
            >
              {item.label}
            </span>
          )}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
