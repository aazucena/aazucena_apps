---
export interface Props {
  color?: string;
}
const { color = '#000' } = Astro.props;
---
<div class="loader"></div>
<style lang="postcss" define:vars={{ loaderColor: color, borderColor: "#000" }}>
  /* HTML: <div class="loader"></div> */
  .loader {
    width: 320px;
    height: 160px;
    color: var(--loaderColor);
    border: 3px solid var(--borderColor);
    border-right-color: transparent;
    padding: 3px;
    background: repeating-linear-gradient(90deg,var(--loaderColor) 0 16px,#0000 0 15px) 0/0% no-repeat content-box content-box;
    position: relative;
    box-sizing: border-box;
    animation: l5 8s forwards steps(360);
  }
  .loader::before {
    content: "";
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: 100%;
    width: 11px;
    background: linear-gradient(#0000 calc(50% - 20px),var(--borderColor) 0 calc(50% - 18px),#0000 0 calc(50% + 12px),var(--borderColor) 0 calc(50% + 14px),#0000 0) left /100% 100%,linear-gradient(var(--borderColor) calc(50% - 20px),#0000 0 calc(50% + 12px),var(--borderColor) 0) left /2px 100%,linear-gradient(#0000 calc(50% - 21px),var(--borderColor) 0 calc(50% + 12px),#0000 0) right/2px 100%;
    background-repeat: no-repeat;
  }
  @keyframes l5 {
      100% {background-size:120%}
  }
</style>
