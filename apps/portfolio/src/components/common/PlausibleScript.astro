---
interface PlausibleProps {
  /** Allows proxying requests. Default: "https://plausible.io/api/event" */
  endpoint?: string;
  /** Track page paths that use a # in the URL. Default: false */
  hashBasedRouting?: boolean;
  /** Automatically track file downloads. Default: false */
  fileDownloads?: boolean | { fileExtensions: string[] };
  /** Track clicks on outbound links. Default: false */
  outboundLinks?: boolean;
  /** Add custom properties globally. */
  customProperties?: Record<string, any> | ((eventName: string) => Record<string, any>);
  /** Track form submissions. Default: false */
  formSubmissions?: boolean;
  /** Enables tracking on localhost for dev environments. Default: false */
  captureOnLocalhost?: boolean;
  /** Automatically track pageviews. Default: true */
  autoCapturePageviews?: boolean;
  /** Enable/disable logging done by script. Default: true */
  logging?: boolean;
  /** Modify or filter events before sending (e.g., redact PII). */
  transformRequest?: (payload: { url: string; [key: string]: any }) => any;
}

interface Props extends PlausibleProps {
  domain: string;
}

const PLAUSIBLE_URL = import.meta.env.PUBLIC_PLAUSIBLE_API_HOST;
const { domain, ...opts } = Astro.props;
const defaultOptions: PlausibleProps = {
  hashBasedRouting: false,
  fileDownloads: false,
  outboundLinks: false,
  customProperties: {},
  formSubmissions: false,
  // Toggle these based on your environment
  captureOnLocalhost: import.meta.env.DEV, 
  logging: import.meta.env.DEV,
  autoCapturePageviews: true,
  // Default pass-through for the transform function
  transformRequest: (payload) => payload,
}
const config: PlausibleProps = {
  ...opts,
  ...defaultOptions,
}
---

{PLAUSIBLE_URL && (
  <>
    {/* Privacy-friendly analytics by Plausible */}
    <script 
      is:inline 
      async
      data-domain={domain}
      src={`${PLAUSIBLE_URL}/js/pa-BJ-QCN7rPt_MdGq6P2gBN.js`}>
    </script>

    <script is:inline define:vars={{ config }}>
      window.plausible = window.plausible || function() { 
        (plausible.q = plausible.q || []).push(arguments) 
      };
      plausible.init = plausible.init || function(i) { 
        plausible.o = i || {} 
      };
      plausible.init(config);
    </script>
  </>
)}
