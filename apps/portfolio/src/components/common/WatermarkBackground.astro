---
interface Props {
  text: string;
  size?: "small" | "medium" | "large" | "huge";
  class?: string;
}

const { text, size = "large", class: className } = Astro.props;

const sizeClasses = {
  small: "text-[15rem] md:text-[25rem]",
  medium: "text-[20rem]",
  large: "text-[25rem]",
  huge: "text-[30rem] md:text-[40rem]",
};
---

<div
  class:list={[
    "pointer-events-none absolute top-1/2 left-1/2 z-0 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap opacity-[0.02] select-none dark:opacity-[0.05]",
    className,
  ]}
  aria-hidden="true"
>
  <span
    class={`${sizeClasses[size]} font-black uppercase tracking-tighter italic`}
    >{text}</span
  >
</div>
