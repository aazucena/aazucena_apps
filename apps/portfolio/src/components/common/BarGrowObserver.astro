---
/**
 * Marks each .bar-grow bar data-seen when its track scrolls into view, which starts the growth
 * (see globals.css). Independent of the React island, so a bar never waits on hydration and a
 * failed island script leaves the bars at their full width.
 */
---

<script is:inline>
  (function () {
    var bars = document.querySelectorAll(".bar-grow");
    if (!bars.length) return;
    function show(bar) {
      bar.setAttribute("data-seen", "");
    }
    if (
      !("IntersectionObserver" in window) ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      bars.forEach(show);
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          show(entry.target.firstElementChild);
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.5 },
    );
    bars.forEach(function (bar) {
      io.observe(bar.parentElement);
    });
    // Hold the bars at zero only once the observer is watching: if anything above throws,
    // the class never arrives and the bars keep their full width.
    document.documentElement.classList.add("bars-armed");
  })();
</script>
