---
/**
 * Marks each .bar-grow bar data-seen when its track scrolls into view, which starts the growth
 * (see globals.css). Independent of the React island, so a bar never waits on hydration and a
 * failed island script leaves the bars at their full width.
 */
---

<script is:inline>
  (function () {
    var root = document.documentElement;
    var bars = document.querySelectorAll(".bar-grow");
    if (!bars.length) return;
    function show(bar) {
      bar.setAttribute("data-seen", "");
    }
    function showAll() {
      root.classList.remove("bars-armed");
      bars.forEach(show);
    }
    // BaseLayout armed the bars; without that (no observer, reduced motion, or it gave up)
    // they keep their full width.
    if (!root.classList.contains("bars-armed")) return showAll();
    try {
      var io = new IntersectionObserver(
        function (entries) {
          // An observer reports every target once as soon as it starts, seen or not
          window.__barsReported = true;
          if (!root.classList.contains("bars-armed")) return showAll();
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            show(entry.target.firstElementChild);
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.5 },
      );
      bars.forEach(function (bar) {
        io.observe(bar.parentElement);
      });
    } catch (_) {
      showAll();
    }
  })();
</script>
