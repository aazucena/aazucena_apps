---
import { ArrowLeft, ArrowRight } from "@aazucena/icons";

interface NavItem {
  slug: string;
  title: string;
}

interface Props {
  prevItem?: NavItem | null;
  nextItem?: NavItem | null;
  basePath: string; // e.g., '/blog', '/experiences', '/projects'
  prevLabel?: string;
  nextLabel?: string;
}

const {
  prevItem,
  nextItem,
  basePath,
  prevLabel = "Previous",
  nextLabel = "Next",
} = Astro.props;

// Ensure basePath doesn't end with slash to avoid double slashes
const normalizedBasePath = basePath.replace(/\/$/, "");
---

{(nextItem || prevItem) && (
  <nav class="border-rule mt-16 border-t pt-8" aria-label="Pagination">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {prevItem ? (
        <a
          href={`${normalizedBasePath}/${prevItem.slug}`}
          class="group border-rule bg-panel rounded-card hover:bg-state hover:border-rule-strong focus-visible:outline-signal space-y-2 border p-4 text-left transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
        >
          <div class="micro-label text-muted-foreground flex items-center gap-2">
            <ArrowLeft
              size={14}
              className="group-hover:-translate-x-1 transition-transform"
            />
            {prevLabel}
          </div>
          <div class="text-foreground line-clamp-2 text-xl font-bold tracking-tight">
            {prevItem.title}
          </div>
        </a>
      ) : (
        <div aria-hidden="true" />
      )}

      {nextItem && (
        <a
          href={`${normalizedBasePath}/${nextItem.slug}`}
          class="group border-rule bg-panel rounded-card hover:bg-state hover:border-rule-strong focus-visible:outline-signal space-y-2 border p-4 text-right transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
        >
          <div class="micro-label text-muted-foreground flex items-center justify-end gap-2">
            {nextLabel}
            <ArrowRight
              size={14}
              className="group-hover:translate-x-1 transition-transform"
            />
          </div>
          <div class="text-foreground line-clamp-2 text-xl font-bold tracking-tight">
            {nextItem.title}
          </div>
        </a>
      )}
    </div>
  </nav>
)}
