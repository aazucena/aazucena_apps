---
import '@fontsource-variable/inter';
import { UI } from 'astrowind:config';

const { colors, font } = UI.branding;

const cssColorVariables = {
  "aw-color-primary": `${colors.primary}`,
  "aw-color-secondary": `${colors.secondary}`,
  "aw-color-accent": `${colors.accent}`,
  "aw-color-text-heading": `${colors.textHeading}`,
  "aw-color-text-default": `${colors.textDefault}`,
  "aw-color-text-muted": `${colors.textMuted}`,
  "aw-color-bg-page": `${colors.bgPage}`,
  "aw-color-bg-page-dark": `${colors.bgPageDark}`,
};

const cssDarkColorVariables = {
  "aw-color-primary": `${colors.primaryDark}`,
  "aw-color-secondary": `${colors.secondaryDark}`,
  "aw-color-accent": `${colors.accentDark}`,
  "aw-color-text-heading": `${colors.textHeadingDark}`,
  "aw-color-text-default": `${colors.textDefaultDark}`,
  "aw-color-text-muted": `${colors.textMutedDark}`,
  "aw-color-bg-page": `${colors.bgPageDark}`,
};

const cssFontVariables = {
  "aw-font-sans": `'${font.sans}'`,
  "aw-font-serif": `'${font.serif}'`,
  "aw-font-heading": `'${font.heading}'`,
};
const cssVariables = {
  colors: cssColorVariables,
  darkColors: cssDarkColorVariables,
  fonts: cssFontVariables,
};

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---
<custom-styles data-aw-styles={JSON.stringify(cssVariables)}>
  <style is:inline>
  </style>
</custom-styles>
<script>
  class CustomStyles extends HTMLElement {
    
    connectedCallback() {
      const { colors, darkColors, fonts } = JSON.parse(this.dataset.awStyles!);
      const styleElement = this.querySelector('style')!;

      const buildRootVariables = (variables: object) => {
        return Object.entries(variables).map(([key, value]) => `--${key}: ${value};`).join('\n');
      }

      styleElement.innerHTML = `
      :root {
        ${buildRootVariables(fonts)}
        
        ${buildRootVariables(colors)}

        ::selection {
          background-color: ${colors["aw-color-primary"]};
        }
      }

      .dark {
        ${buildRootVariables(fonts)}
        
        ${buildRootVariables(darkColors)}

        ::selection {
          background-color: ${darkColors["aw-color-text-heading"]};
          color: ${darkColors["aw-color-primary"]};
        }
      }
      `
      document.querySelector("head")!.append(styleElement);
      this.remove();
    }
  }

  customElements.define('custom-styles', CustomStyles);
</script>
