---
// Click button, get confetti!
// Styled by Tailwind :)
---

<button class="bg-signal text-signal-foreground h-control rounded-control hover:bg-signal/90 focus-visible:outline-signal appearance-none px-4 text-sm font-medium transition-colors focus-visible:outline-1 focus-visible:outline-offset-2">
  <slot />
</button>

<script>
  import confetti from "canvas-confetti";
  const button = document.body.querySelector("button");

  if (button) {
    button.addEventListener("click", () => confetti());
  }
</script>
