---
import PageLayout from '~/layouts/PageLayout.astro';
import { MarkdownRenderer } from '~/components/blocks/MarkdownRenderer';
import { getMaintenance } from '~/lib/api/maintenance';
import { Wrench, Refresh, Envelope, Globe, ClockCircle as Clock } from '@mynaui/icons-react';

export const prerender = false;

// Fetch maintenance configuration
const maintenance = await getMaintenance();

// If maintenance is NOT enabled, redirect users away from this page
if (!maintenance.enabled && !import.meta.env.DEV) {
  const referer = Astro.request.headers.get('referer');
  // Avoid redirect loops if the referer is the maintenance page itself
  const redirectUrl = (referer && !referer.includes('/maintenance')) ? referer : '/';
  return Astro.redirect(redirectUrl);
}

const pageTitle = 'Maintenance Mode';
const pageDescription = maintenance.message;
---

<PageLayout title={pageTitle} description={pageDescription}>
  <main class="min-h-screen bg-white dark:bg-gray-950 flex flex-col items-center justify-center relative overflow-hidden text-center">
    <!-- Sophisticated Background Decoration -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-[10%] -left-[10%] w-[60%] h-[60%] bg-blue-500/10 dark:bg-blue-600/5 blur-[120px] rounded-full animate-pulse"></div>
      <div class="absolute -bottom-[10%] -right-[10%] w-[60%] h-[60%] bg-purple-500/10 dark:bg-purple-600/5 blur-[120px] rounded-full animate-pulse" style="animation-delay: 2s;"></div>
      <div class="absolute top-[20%] right-[10%] w-[30%] h-[30%] bg-indigo-500/5 dark:bg-indigo-600/5 blur-[100px] rounded-full animate-pulse" style="animation-delay: 4s;"></div>
    </div>

    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
      <!-- Icon with specialized container -->
      <div class="mb-12 relative inline-flex group">
        <div class="absolute inset-0 bg-blue-500/20 blur-3xl rounded-full scale-150 opacity-50 group-hover:opacity-100 transition-opacity duration-1000"></div>
        <div class="relative w-28 h-28 rounded-[2.5rem] bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-2xl flex items-center justify-center text-blue-600 dark:text-blue-400">
          <Wrench size={48} className="animate-spin-slow" />
        </div>
      </div>

      <!-- Status Message -->
      <h1 class="text-5xl md:text-7xl font-black text-gray-900 dark:text-white mb-8 tracking-tighter leading-none">
        Refining the <br class="hidden md:block"/><span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">Experience.</span>
      </h1>

      <div class="max-w-lg mx-auto space-y-8 mb-12">
        <div class="text-xl text-gray-600 dark:text-gray-400 font-medium leading-relaxed whitespace-pre-line prose dark:prose-invert max-w-none text-center">
          {maintenance.message ? (
            <MarkdownRenderer content={maintenance.message} />
          ) : (
            <p>I'm currently updating my portfolio to bring you something better. I'll be back online very shortly.</p>
          )}
        </div>
        
        <div class="flex items-center justify-center gap-6 py-4 border-y border-gray-100 dark:border-gray-900">
          <div class="flex items-center gap-2">
            <Clock size={16} className="text-blue-500" />
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">Updating</span>
          </div>
          <div class="flex items-center gap-2">
            <Globe size={16} className="text-purple-500" />
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">Global Deploy</span>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <button
          onclick="window.location.reload()"
          class="inline-flex items-center justify-center gap-3 px-10 py-5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-[1.5rem] font-black text-xs uppercase tracking-[0.2em] hover:bg-blue-600 dark:hover:bg-blue-50 transition-all shadow-2xl active:scale-95 group"
        >
          <Refresh size={18} className="group-hover:rotate-180 transition-transform duration-700" />
          Check Status
        </button>
      </div>

      <!-- Footer Info -->
      <div class="space-y-8 pt-8 border-t border-gray-50 dark:border-gray-900/50">
        <div class="flex items-center justify-center gap-3">
          <div class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </div>
          <span class="text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 dark:text-gray-500">Real-time monitoring enabled</span>
        </div>
        
        <div class="flex flex-col items-center gap-2">
          <span class="text-[10px] font-black uppercase tracking-widest text-gray-300 dark:text-gray-700">Reach out directly</span>
          <a href="mailto:contact@aazucena.com" class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 font-bold hover:text-blue-600 dark:hover:text-blue-400 transition-colors group">
            <Envelope size={16} className="text-gray-400 group-hover:text-blue-500 transition-colors" />
            contact@aazucena.com
          </a>
        </div>
      </div>
    </div>
  </main>

  <style>
    .animate-spin-slow {
      animation: spin 12s linear infinite;
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>


  <!-- Auto-refresh script (check every 30 seconds) -->
  <script is:inline>
    // Auto-refresh every 30 seconds to check if maintenance is over
    let refreshInterval;

    function startAutoRefresh() {
      refreshInterval = setInterval(() => {
        console.log('[Maintenance] Checking if maintenance is over...');
        window.location.reload();
      }, 30000); // 30 seconds
    }

    // Start auto-refresh when page loads
    if (typeof window !== 'undefined') {
      startAutoRefresh();
    }

    // Clean up interval when page unloads
    window.addEventListener('beforeunload', () => {
      if (refreshInterval) {
        clearInterval(refreshInterval);
      }
    });
  </script>
</PageLayout>
