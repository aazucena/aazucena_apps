---
import PageLayout from "~/layouts/PageLayout.astro";
import { MarkdownRenderer } from "@aazucena/ui";
import { getMaintenance } from "@aazucena/api";
import { Refresh, Envelope, Wrench } from "@aazucena/icons";
import { buttonVariants } from "@aazucena/ui";

export const prerender = false;

// Fetch maintenance configuration
const maintenance = await getMaintenance();

const envMaintenanceMode = import.meta.env.MAINTENANCE_MODE === "true";

// If maintenance is NOT enabled (via env var or CMS), redirect users away from this page
if (!maintenance.enabled && !envMaintenanceMode && !import.meta.env.DEV) {
  // Avoid redirect loops if the referer is the maintenance page itself
  return Astro.redirect(
    Astro.request.headers.get("referer") &&
      !Astro.request.headers.get("referer")?.includes("/maintenance")
      ? (Astro.request.headers.get("referer") as string)
      : "/",
  );
}

const pageTitle = "Maintenance Mode";
const pageDescription = maintenance.message;
---

<PageLayout title={pageTitle} description={pageDescription}>
  <main class="bg-background relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center">
    <div class="relative z-10 mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="micro-label text-muted-foreground mb-8">
        MAINTENANCE // WINDOW
      </p>

      <div class="rounded-card border-rule bg-panel text-signal mx-auto mb-8 flex size-20 items-center justify-center border">
        <Wrench size={36} aria-hidden="true" className="spin-slow" />
      </div>

      <!-- Status Message -->
      <h1 class="text-foreground mb-8 text-5xl leading-none font-bold tracking-tight md:text-6xl">
        Refining the <br class="hidden md:block" />
        <span class="text-signal">Experience.</span>
      </h1>

      <div class="mx-auto mb-12 max-w-lg space-y-8">
        <div class="prose dark:prose-invert text-muted-foreground max-w-none text-center text-lg leading-relaxed whitespace-pre-line">
          {maintenance.message ? (
            <MarkdownRenderer content={maintenance.message as string} />
          ) : (
            <p>
              I'm currently updating my portfolio to bring you something better.
              I'll be back online very shortly.
            </p>
          )}
        </div>

        <p class="micro-label text-warning border-rule flex items-center justify-center gap-2 border-y py-3">
          <span aria-hidden="true">◆</span>
          <span>Updating</span>
        </p>
      </div>

      <!-- Action Button -->
      <div class="mb-12 flex flex-col justify-center gap-3 sm:flex-row">
        <button
          onclick="window.location.reload()"
          class={buttonVariants({ variant: "default", class: "group press" })}
        >
          <Refresh
            size={16}
            aria-hidden="true"
            className="hover-spin [--spin:180deg]"
          />
          Check Status
        </button>
      </div>

      <!-- Footer Info -->
      <div class="border-rule border-t pt-8">
        <p class="micro-label text-muted-foreground mb-6 flex items-center justify-center gap-3">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="bg-signal absolute inline-flex size-full rounded-full opacity-60 motion-safe:animate-ping" />
            <span class="bg-signal relative inline-flex size-2 rounded-full" />
          </span>
          Checks every 30 seconds
        </p>
        <p class="micro-label text-muted-foreground mb-2">REACH OUT DIRECTLY</p>
        <a
          href="mailto:contact@aazucena.com"
          class="text-foreground hover:text-signal focus-visible:outline-signal inline-flex items-center gap-2 font-mono text-sm transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
        >
          <Envelope size={16} />
          contact@aazucena.com
        </a>
      </div>
    </div>
  </main>

  <!-- Auto-refresh script (check every 30 seconds) -->
  <script is:inline>
    // Auto-refresh every 30 seconds to check if maintenance is over
    let refreshInterval;

    function startAutoRefresh() {
      refreshInterval = setInterval(() => {
        window.location.reload();
      }, 30000); // 30 seconds
    }

    // Start auto-refresh when page loads
    if (typeof window !== "undefined") {
      startAutoRefresh();
    }

    // Clean up interval when page unloads
    window.addEventListener("beforeunload", () => {
      if (refreshInterval) {
        clearInterval(refreshInterval);
      }
    });
  </script>
</PageLayout>
