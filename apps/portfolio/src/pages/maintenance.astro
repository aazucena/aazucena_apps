---
import PageLayout from "~/layouts/PageLayout.astro";
import { MarkdownRenderer } from "@aazucena/ui";
import { getMaintenance } from "@aazucena/api";
import {
  Wrench,
  Refresh,
  Envelope,
  Globe,
  ClockCircle as Clock,
} from "@aazucena/icons";

export const prerender = false;

// Fetch maintenance configuration
const maintenance = await getMaintenance();

// If maintenance is NOT enabled, redirect users away from this page
if (!maintenance.enabled && !import.meta.env.DEV) {
  // Avoid redirect loops if the referer is the maintenance page itself
  return Astro.redirect(
    Astro.request.headers.get("referer") &&
      !Astro.request.headers.get("referer")?.includes("/maintenance")
      ? (Astro.request.headers.get("referer") as string)
      : "/",
  );
}

const pageTitle = "Maintenance Mode";
const pageDescription = maintenance.message;
---

<PageLayout title={pageTitle} description={pageDescription}>
  <main
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-white text-center dark:bg-gray-950"
  >
    <!-- Sophisticated Background Decoration -->
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div
        class="absolute -top-[10%] -left-[10%] h-[60%] w-[60%] animate-pulse rounded-full bg-blue-500/10 blur-[120px] dark:bg-blue-600/5"
      >
      </div>
      <div
        class="absolute -right-[10%] -bottom-[10%] h-[60%] w-[60%] animate-pulse rounded-full bg-purple-500/10 blur-[120px] dark:bg-purple-600/5"
        style="animation-delay: 2s;"
      >
      </div>
      <div
        class="absolute top-[20%] right-[10%] h-[30%] w-[30%] animate-pulse rounded-full bg-indigo-500/5 blur-[100px] dark:bg-indigo-600/5"
        style="animation-delay: 4s;"
      >
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <!-- Icon with specialized container -->
      <div class="group relative mb-12 inline-flex">
        <div
          class="absolute inset-0 scale-150 rounded-full bg-blue-500/20 opacity-50 blur-3xl transition-opacity duration-1000 group-hover:opacity-100"
        >
        </div>
        <div
          class="relative flex h-28 w-28 items-center justify-center rounded-[2.5rem] border border-gray-100 bg-white text-blue-600 shadow-2xl dark:border-gray-800 dark:bg-gray-900 dark:text-blue-400"
        >
          <Wrench size={48} className="animate-spin-slow" />
        </div>
      </div>

      <!-- Status Message -->
      <h1
        class="mb-8 text-5xl leading-none font-black tracking-tighter text-gray-900 md:text-7xl dark:text-white"
      >
        Refining the <br class="hidden md:block" /><span
          class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent"
          >Experience.</span
        >
      </h1>

      <div class="mx-auto mb-12 max-w-lg space-y-8">
        <div
          class="prose dark:prose-invert max-w-none text-center text-xl leading-relaxed font-medium whitespace-pre-line text-gray-600 dark:text-gray-400"
        >
          {
            maintenance.message ? (
              <MarkdownRenderer content={maintenance.message as string} />
            ) : (
              <p>
                I'm currently updating my portfolio to bring you something
                better. I'll be back online very shortly.
              </p>
            )
          }
        </div>

        <div
          class="flex items-center justify-center gap-6 border-y border-gray-100 py-4 dark:border-gray-900"
        >
          <div class="flex items-center gap-2">
            <Clock size={16} className="text-blue-500" />
            <span
              class="text-[10px] font-black tracking-[0.2em] text-gray-400 uppercase"
              >Updating</span
            >
          </div>
          <div class="flex items-center gap-2">
            <Globe size={16} className="text-purple-500" />
            <span
              class="text-[10px] font-black tracking-[0.2em] text-gray-400 uppercase"
              >Global Deploy</span
            >
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="mb-16 flex flex-col justify-center gap-4 sm:flex-row">
        <button
          onclick="window.location.reload()"
          class="group inline-flex items-center justify-center gap-3 rounded-[1.5rem] bg-gray-900 px-10 py-5 text-xs font-black tracking-[0.2em] text-white uppercase shadow-2xl transition-all hover:bg-blue-600 active:scale-95 dark:bg-white dark:text-gray-900 dark:hover:bg-blue-50"
        >
          <Refresh
            size={18}
            className="transition-transform duration-700 group-hover:rotate-180"
          />
          Check Status
        </button>
      </div>

      <!-- Footer Info -->
      <div
        class="space-y-8 border-t border-gray-50 pt-8 dark:border-gray-900/50"
      >
        <div class="flex items-center justify-center gap-3">
          <div class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-500"
            ></span>
          </div>
          <span
            class="text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:text-gray-500"
            >Real-time monitoring enabled</span
          >
        </div>

        <div class="flex flex-col items-center gap-2">
          <span
            class="text-[10px] font-black tracking-widest text-gray-300 uppercase dark:text-gray-700"
            >Reach out directly</span
          >
          <a
            href="mailto:contact@aazucena.com"
            class="group inline-flex items-center gap-2 text-sm font-bold text-gray-600 transition-colors hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400"
          >
            <Envelope
              size={16}
              className="text-gray-400 transition-colors group-hover:text-blue-500"
            />
            contact@aazucena.com
          </a>
        </div>
      </div>
    </div>
  </main>

  <style>
    .animate-spin-slow {
      animation: spin 12s linear infinite;
    }
    @keyframes spin {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }
  </style>

  <!-- Auto-refresh script (check every 30 seconds) -->
  <script is:inline>
    // Auto-refresh every 30 seconds to check if maintenance is over
    let refreshInterval;

    function startAutoRefresh() {
      refreshInterval = setInterval(() => {
        window.location.reload();
      }, 30000); // 30 seconds
    }

    // Start auto-refresh when page loads
    if (typeof window !== "undefined") {
      startAutoRefresh();
    }

    // Clean up interval when page unloads
    window.addEventListener("beforeunload", () => {
      if (refreshInterval) {
        clearInterval(refreshInterval);
      }
    });
  </script>
</PageLayout>
