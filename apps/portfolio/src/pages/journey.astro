---
/**
 * Journey page - features complex data visualizations of skills and career progression.
 * Includes interactive graphs, timelines, and heatmaps.
 */
import { Compass, Heart, Lamp, Rocket } from "@aazucena/icons";
// Journey page imports - organized by type
// DEBUG: import { JourneyDashboard } from "~/components/JourneyDashboard";
// DEBUG: import { CareerStats, GrowthMetrics, ChronologyTimeline } from "~/components/ui/journey";
import {
  calculateCareerStats,
  calculateSkillGrowthMetrics,
  transformToHeatmapData,
  transformToSankeyData,
  transformToSkillsEvolution,
  transformToSkillsNetwork,
  transformToStreamGraphData,
  transformToTimelineData,
  type SkillNode,
} from "~/lib/transformers";
import { IconRenderer } from "@aazucena/ui";
import GradientAccent from "~/components/common/GradientAccent.astro";
import WatermarkBackground from "~/components/common/WatermarkBackground.astro";
import PageLayout from "~/layouts/PageLayout.astro";
import { fetchEducation as getEducation } from "@aazucena/api";
import { getExperiences } from "@aazucena/api";
import { getJourneyPage } from "@aazucena/api";
import { getProjects } from "@aazucena/api";
import { getSkillCategories } from "@aazucena/api";
import type { Education } from "@aazucena/types";
import type { Project } from "@aazucena/types";
import type { Experience } from "@aazucena/types";
import type { SkillCategoryInfo } from "@aazucena/types";
import type { JourneyPageConfig } from "@aazucena/types";

// Fetch all experiences, education, projects, categories, and journey config
let experiences: Experience[] = [];
let education: Education[] = [];
let projects: Project[] = [];
let categories: SkillCategoryInfo[] = [];
let journeyConfig: JourneyPageConfig | null = null;

try {
  [experiences, education, projects, categories, journeyConfig] =
    await Promise.all([
      getExperiences(),
      getEducation(),
      getProjects("all"),
      getSkillCategories(),
      getJourneyPage(),
    ]);
} catch (error) {
  console.error("[Journey] Error fetching data:", error);
}

// Transform data for visualizations
const timelineData = transformToTimelineData(experiences, education);
const skillsEvolutionData = transformToSkillsEvolution(
  experiences,
  education,
  projects,
);
const skillsNetworkData = transformToSkillsNetwork(
  experiences,
  education,
  projects,
);
const sankeyData = transformToSankeyData(experiences, education, projects);
const heatmapData = transformToHeatmapData(experiences, education, projects);
const streamGraphData = transformToStreamGraphData(
  experiences,
  education,
  projects,
);
const careerStats = calculateCareerStats(experiences);
const growthMetrics = calculateSkillGrowthMetrics(
  experiences,
  education,
  projects,
);

const allCategories = Array.from(
  new Set([
    ...skillsNetworkData.nodes.map((n: SkillNode) => n.category),
    ...categories.map((c) => c.label),
  ]),
)
  .filter(Boolean)
  .sort();

// Use CMS journey config or fallback to defaults
const pageTitle =
  journeyConfig?.header?.title || "Journey | Growth & Evolution";
const pageDescription =
  journeyConfig?.header?.description ||
  "An interactive visualization of my professional journey, showcasing career growth, skills evolution, and key milestones.";
const watermarkText = journeyConfig?.header?.watermark || "JOURNEY";

// Map phase badges to colors (used for badge styling)
const phaseColors: Record<string, string> = {
  "Phase I": "blue",
  "Phase II": "purple",
  "Phase III": "green",
};

function getPhaseColor(badge?: string | null): string {
  if (!badge) return "blue";
  for (const [key, value] of Object.entries(phaseColors)) {
    if (badge.includes(key)) return value;
  }
  return "blue";
}

// Get CMS phases or use hardcoded fallback
const phases =
  journeyConfig?.phases && journeyConfig.phases.length > 0
    ? journeyConfig.phases
    : [
        {
          enabled: true,
          name: "chronology",
          badge: "Phase I: Chronology",
          title: "The Path Traveled.",
          description:
            "Visualizing the timeline of experience and education. Every step has been a foundational milestone in Squashing bugs and architecting systems.",
          items: [],
        },
        {
          enabled: true,
          name: "adaptation",
          badge: "Phase II: Adaptation",
          title: "Technical DNA.",
          description:
            "Tracking the expansion of my technical toolkit through different lenses: growth momentum, network density, and monthly intensity.",
          items: [],
        },
        {
          enabled: true,
          name: "logic",
          badge: "Phase III: Logic",
          title: "Distilled Wisdom.",
          description:
            "The core principles derived from years of building, breaking, and improving software for real humans.",
          items: [
            {
              title: "Embrace Complexity",
              description:
                "Complex problems aren't obstacles; they're opportunities for innovation. The most rewarding solutions often lie behind the most daunting challenges.",
              icon: Lamp,
              variant: "blue" as const,
            },
            {
              title: "Collective Intelligence",
              description:
                "Diverse perspectives are the secret ingredient to building truly resilient systems. I prioritize team growth as much as technical excellence.",
              icon: Heart,
              variant: "purple" as const,
            },
            {
              title: "Iterative Velocity",
              description:
                "Perfection is the enemy of progress. I prioritize getting working software into users' hands fast, using real feedback as the driver for refinement.",
              icon: Rocket,
              variant: "pink" as const,
            },
            {
              title: "Relentless Curiosity",
              description:
                "Staying static is moving backward. I treat every project as a classroom, and every bug as a vital lesson in architecture and logic.",
              icon: Compass,
              variant: "green" as const,
            },
          ],
        },
      ];
---

<PageLayout title={pageTitle} description={pageDescription}>
  <main class="min-h-screen bg-white dark:bg-gray-950">
    <GradientAccent variant="print-hidden" />

    <!-- Hero Header -->
    <header
      class="relative overflow-hidden border-b border-gray-100 bg-white py-20 md:py-32 dark:border-gray-800 dark:bg-gray-900"
    >
      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-20 space-y-6 text-center">
          <h1
            class="text-5xl leading-none font-black tracking-tighter text-gray-900 md:text-8xl dark:text-white"
          >
            {pageTitle}<span class="text-blue-600">.</span>
          </h1>
          {
            pageDescription && (
              <p class="mx-auto max-w-3xl text-xl leading-relaxed font-medium text-gray-600 md:text-2xl dark:text-gray-400">
                {pageDescription}
              </p>
            )
          }
        </div>

        <!-- Career Stats Visualization -->
        <div class="relative z-20">
          {/* DEBUG: <CareerStats stats={careerStats} client:only="react" /> */}
        </div>
      </div>

      <WatermarkBackground text={watermarkText} size="huge" />
    </header>

    <!-- Dynamic Phases from CMS -->
    {
      phases.map((phase, index) => {
        const phaseColor = getPhaseColor(phase.badge);
        const isEven = index % 2 === 0;
        const bgClass = isEven
          ? "bg-white dark:bg-gray-950"
          : "bg-gray-50/50 dark:bg-gray-900/30 border-y border-gray-100 dark:border-gray-800";

        return (
          <section class={`py-24 ${bgClass}`}>
            <div class="mx-auto mb-16 max-w-5xl px-4 sm:px-6 lg:px-8">
              {phase.badge && (
                <div
                  class={`inline-flex items-center gap-3 px-4 py-2 bg-${phaseColor}-50 dark:bg-${phaseColor}-900/20 rounded-full border border-${phaseColor}-100 dark:border-${phaseColor}-800 mb-8`}
                >
                  <div
                    class={`h-1.5 w-1.5 rounded-full bg-${phaseColor}-500 animate-pulse`}
                  />
                  <span
                    class={`text-[10px] font-black tracking-[0.3em] uppercase text-${phaseColor}-600 dark:text-${phaseColor}-400`}
                  >
                    {phase.badge}
                  </span>
                </div>
              )}

              <div class="space-y-6">
                <h2 class="text-4xl font-black tracking-tighter text-gray-900 md:text-6xl dark:text-white">
                  {phase.title}
                </h2>
                <p class="max-w-3xl text-xl leading-relaxed font-medium text-gray-600 dark:text-gray-400">
                  {phase.description}
                </p>
              </div>
            </div>

            {/* Phase I: Chronology - Timeline */}
            {phase.name === "chronology" && (
              <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                {/* DEBUG: <ChronologyTimeline data={timelineData} client:only="react" /> */}
              </div>
            )}

            {/* Phase II: Adaptation - Skills Dashboard */}
            {phase.name === "adaptation" && (
              <>
                <div class="mx-auto mb-12 max-w-7xl px-4 sm:px-6 lg:px-8">
                  {/* DEBUG: <GrowthMetrics metrics={growthMetrics} client:only="react" /> */}
                </div>
                {/* DEBUG: <JourneyDashboard
                  evolutionData={skillsEvolutionData}
                  networkData={skillsNetworkData}
                  sankeyData={sankeyData}
                  heatmapData={heatmapData}
                  streamGraphData={streamGraphData}
                  experiences={experiences}
                  education={education}
                  projects={projects}
                  growthMetrics={growthMetrics}
                  careerStats={careerStats}
                  categories={allCategories}
                  hideHeader={true}
                  hideStats={true}
                  hideMetrics={true}
                  client:only="react"
                /> */}
              </>
            )}

            {/* Phase III or custom phases - Render narrative items as cards */}
            {phase.items && phase.items.length > 0 && (
              <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
                {phase.items.map((item) => (
                  <div class="group rounded-[2.5rem] border border-gray-100 bg-gray-50 p-10 shadow-sm transition-all duration-500 hover:border-blue-500/20 hover:shadow-xl dark:border-gray-800 dark:bg-gray-900">
                    {item.icon && (
                      <div
                        class={`flex h-14 w-14 items-center justify-center rounded-2xl text-${item.variant}-600 bg-${item.variant}-50 dark:bg-${item.variant}-900/20 mb-8 transition-transform duration-500 group-hover:scale-110`}
                      >
                        <IconRenderer
                          icon={item.icon as any}
                          client:only="react"
                        />
                      </div>
                    )}
                    <h3 class="mb-4 text-2xl font-black tracking-tight text-gray-900 dark:text-white">
                      {item.title}
                    </h3>
                    <p class="leading-relaxed font-medium text-gray-600 dark:text-gray-400">
                      {item.description}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </section>
        );
      })
    }

    <!-- Global CTA -->
    {
      (
        <section class="relative overflow-hidden py-32">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-600 via-purple-600 to-pink-600" />
          <div class="absolute inset-0 bg-black/10 backdrop-blur-3xl" />

          <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
            <h2 class="mb-8 text-4xl font-black tracking-tighter text-white md:text-6xl">
              {journeyConfig?.callToAction?.title || "Explore the Details."}
            </h2>
            {
              <p class="mx-auto mb-12 max-w-2xl text-xl font-medium text-white/80">
                {journeyConfig?.callToAction?.description ||
                  "Dive deeper into specific case studies, technical writings, or get in touch to discuss a collaboration."}
              </p>
            }
            <div class="flex flex-col justify-center gap-4 sm:flex-row">
              {journeyConfig?.callToAction?.buttons?.length ? (
                journeyConfig.callToAction.buttons.map((button) => (
                  <a
                    href={button.url}
                    target={button.openInNewTab ? "_blank" : undefined}
                    class={`rounded-[1.5rem] px-10 py-5 text-xs font-black tracking-[0.2em] uppercase shadow-2xl transition-all active:scale-95 ${
                      button.variant === "primary"
                        ? "bg-white text-gray-900 hover:bg-blue-50"
                        : "border border-white/20 bg-white/10 text-white backdrop-blur-md hover:bg-white/20"
                    }`}
                  >
                    {button.label}
                  </a>
                ))
              ) : (
                <>
                  <a
                    href="/projects"
                    class="rounded-[1.5rem] bg-white px-10 py-5 text-xs font-black tracking-[0.2em] text-gray-900 uppercase shadow-2xl transition-all hover:bg-blue-50 active:scale-95"
                  >
                    Portfolio
                  </a>
                  <a
                    href="/experiences"
                    class="rounded-[1.5rem] border border-white/20 bg-white/10 px-10 py-5 text-xs font-black tracking-[0.2em] text-white uppercase shadow-2xl backdrop-blur-md transition-all hover:bg-white/20 active:scale-95"
                  >
                    Full History
                  </a>
                  <a
                    href="/contact"
                    class="rounded-[1.5rem] border border-white/20 bg-white/10 px-10 py-5 text-xs font-black tracking-[0.2em] text-white uppercase shadow-2xl backdrop-blur-md transition-all hover:bg-white/20 active:scale-95"
                  >
                    Get in Touch
                  </a>
                </>
              )}
            </div>
          </div>
        </section>
      )
    }
  </main>
</PageLayout>
