---
import PageLayout from '~/layouts/PageLayout.astro';
import { getExperiences } from '~/lib/api/experiences';
import { fetchEducation as getEducation } from '~/lib/api/education';
import { getProjects } from '~/lib/api/projects';
import { getSkillCategories } from '~/lib/api/skill-categories';
import type { StrapiEducation as Education } from '~/lib/validators/education';
import type { Project } from '~/lib/transformers/projects';
import type { SkillCategoryInfo } from '~/lib/transformers/skill-category';
import {
  InteractiveTimeline,
  SkillsDashboard,
  CareerStats,
  GrowthMetrics,
} from '~/components/journey';
import {
  transformToTimelineData,
  transformToSkillsEvolution,
  transformToSkillsNetwork,
  transformToSankeyData,
  transformToHeatmapData,
  transformToStreamGraphData,
  calculateCareerStats,
  calculateSkillGrowthMetrics,
} from '~/components/journey';
import type { Experience } from '~/components/animations/sections/data/experiences';
import { Calendar, Chip as Cpu, Heart, Compass, Rocket, ArrowRight, ClockCircle as Clock, LayersOne as Layers, Lamp } from '@mynaui/icons-react';

// Fetch all experiences, education, projects, and categories
let experiences: Experience[] = [];
let education: Education[] = [];
let projects: Project[] = [];
let categories: SkillCategoryInfo[] = [];

try {
  [experiences, education, projects, categories] = await Promise.all([
    getExperiences(),
    getEducation(),
    getProjects('all'), 
    getSkillCategories(),
  ]);
} catch (error) {
  console.error('Error fetching data for journey:', error);
}

// Transform data for visualizations
const timelineData = transformToTimelineData(experiences, education);
const skillsEvolutionData = transformToSkillsEvolution(experiences, education, projects);
const skillsNetworkData = transformToSkillsNetwork(experiences, education, projects);
const sankeyData = transformToSankeyData(experiences, education, projects);
const heatmapData = transformToHeatmapData(experiences, education, projects);
const streamGraphData = transformToStreamGraphData(experiences, education, projects);
const careerStats = calculateCareerStats(experiences);
const growthMetrics = calculateSkillGrowthMetrics(experiences, education, projects);

const allCategories = Array.from(new Set([
  ...skillsNetworkData.nodes.map(n => n.category),
  ...categories.map(c => c.label)
])).filter(Boolean).sort();

const pageTitle = 'Journey | Growth & Evolution';
const pageDescription = 'An interactive visualization of my professional journey, showcasing career growth, skills evolution, and key milestones.';
---

<PageLayout title={pageTitle} description={pageDescription}>
  <main class="min-h-screen bg-white dark:bg-gray-950">
    <div class="h-1 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 print:hidden" aria-hidden="true"></div>

    <!-- Hero Header -->
    <header class="bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 py-20 md:py-32 overflow-hidden relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center space-y-6 mb-20">
          <h1 class="text-5xl md:text-8xl font-black text-gray-900 dark:text-white tracking-tighter leading-none">
            The <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">Evolution.</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium max-w-3xl mx-auto leading-relaxed">
            An interactive report on growth, technical adaptation, and the logic behind the journey.
          </p>
        </div>

        <!-- Career Stats Visualization -->
        <div class="relative z-20">
          <CareerStats stats={careerStats} client:load />
        </div>
      </div>
      
      <!-- Watermark -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none opacity-[0.02] dark:opacity-[0.05] whitespace-nowrap z-0">
        <span class="text-[40rem] font-black uppercase tracking-tighter italic">JOURNEY</span>
      </div>
    </header>

    <!-- Phase I: The Chronology -->
    <section class="py-24 bg-white dark:bg-gray-950">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <div class="inline-flex items-center gap-3 px-4 py-2 bg-blue-50 dark:bg-blue-900/20 rounded-full border border-blue-100 dark:border-blue-800 mb-8">
          <div class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></div>
          <span class="text-[10px] font-black uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400">Phase I: Chronology</span>
        </div>
        
        <div class="space-y-6">
          <h2 class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white tracking-tighter">
            The Path Traveled.
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed font-medium">
            Visualizing the timeline of experience and education. Every step has been a foundational milestone in Squashing bugs and architecting systems.
          </p>
        </div>
      </div>

      <div class="overflow-hidden">
        <InteractiveTimeline data={timelineData} hideHeader={true} client:visible />
      </div>
    </section>

    <!-- Phase II: Technical DNA -->
    <section class="py-24 bg-gray-50/50 dark:bg-gray-900/30 border-y border-gray-100 dark:border-gray-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <div class="inline-flex items-center gap-3 px-4 py-2 bg-purple-50 dark:bg-purple-900/20 rounded-full border border-purple-100 dark:border-purple-800 mb-8">
          <div class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></div>
          <span class="text-[10px] font-black uppercase tracking-[0.3em] text-purple-600 dark:text-purple-400">Phase II: Adaptation</span>
        </div>
        
        <div class="space-y-6">
          <h2 class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white tracking-tighter">
            Technical DNA.
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed font-medium">
            Tracking the expansion of my technical toolkit through different lenses: growth momentum, network density, and monthly intensity.
          </p>
        </div>
      </div>

      <!-- Growth Metrics Grid -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
        <GrowthMetrics metrics={growthMetrics} client:visible />
      </div>

      <!-- Dashboard -->
      <SkillsDashboard
        evolutionData={skillsEvolutionData}
        networkData={skillsNetworkData}
        sankeyData={sankeyData}
        heatmapData={heatmapData}
        streamGraphData={streamGraphData}
        experiences={experiences}
        education={education}
        projects={projects}
        growthMetrics={growthMetrics}
        careerStats={careerStats}
        categories={allCategories}
        hideHeader={true}
        hideStats={true}
        hideMetrics={true}
        client:visible
      />
    </section>

    <!-- Phase III: Principles -->
    <section class="py-24 bg-white dark:bg-gray-950">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
        <div class="inline-flex items-center gap-3 px-4 py-2 bg-green-50 dark:bg-green-900/20 rounded-full border border-green-100 dark:border-green-800 mb-8">
          <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
          <span class="text-[10px] font-black uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Phase III: Logic</span>
        </div>
        
        <div class="space-y-6">
          <h2 class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white tracking-tighter">
            Distilled Wisdom.
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed font-medium">
            The core principles derived from years of building, breaking, and improving software for real humans.
          </p>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        {[
          { 
            title: 'Embrace Complexity', 
            desc: "Complex problems aren't obstacles; they're opportunities for innovation. The most rewarding solutions often lie behind the most daunting challenges.",
            icon: Lamp, color: 'text-blue-600 bg-blue-50 dark:bg-blue-900/20'
          },
          { 
            title: 'Collective Intelligence', 
            desc: 'Diverse perspectives are the secret ingredient to building truly resilient systems. I prioritize team growth as much as technical excellence.',
            icon: Heart, color: 'text-purple-600 bg-purple-50 dark:bg-purple-900/20'
          },
          { 
            title: 'Iterative Velocity', 
            desc: "Perfection is the enemy of progress. I prioritize getting working software into users' hands fast, using real feedback as the driver for refinement.",
            icon: Rocket, color: 'text-pink-600 bg-pink-50 dark:bg-pink-900/20'
          },
          { 
            title: 'Relentless Curiosity', 
            desc: 'Staying static is moving backward. I treat every project as a classroom, and every bug as a vital lesson in architecture and logic.',
            icon: Compass, color: 'text-green-600 bg-green-50 dark:bg-green-900/20'
          }
        ].map(card => (
          <div class="p-10 rounded-[2.5rem] bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 hover:border-blue-500/20 transition-all duration-500 group shadow-sm hover:shadow-xl">
            <div class={`w-14 h-14 rounded-2xl flex items-center justify-center ${card.color} mb-8 group-hover:scale-110 transition-transform duration-500`}>
              <card.icon size={28} />
            </div>
            <h3 class="text-2xl font-black text-gray-900 dark:text-white mb-4 tracking-tight">{card.title}</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed font-medium">{card.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Global CTA -->
    <section class="relative py-32 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-600 via-purple-600 to-pink-600"></div>
      <div class="absolute inset-0 bg-black/10 backdrop-blur-3xl"></div>
      
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <h2 class="text-4xl md:text-6xl font-black text-white mb-8 tracking-tighter">
          Explore the Details.
        </h2>
        <p class="text-xl text-white/80 mb-12 font-medium max-w-2xl mx-auto">
          Dive deeper into specific case studies, technical writings, or get in touch to discuss a collaboration.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/projects" class="px-10 py-5 bg-white text-gray-900 rounded-[1.5rem] font-black text-xs uppercase tracking-[0.2em] hover:bg-blue-50 transition-all shadow-2xl active:scale-95">
            Portfolio
          </a>
          <a href="/experiences" class="px-10 py-5 bg-white/10 backdrop-blur-md text-white border border-white/20 rounded-[1.5rem] font-black text-xs uppercase tracking-[0.2em] hover:bg-white/20 transition-all shadow-2xl active:scale-95">
            Full History
          </a>
          <a href="/contact" class="px-10 py-5 bg-white/10 backdrop-blur-md text-white border border-white/20 rounded-[1.5rem] font-black text-xs uppercase tracking-[0.2em] hover:bg-white/20 transition-all shadow-2xl active:scale-95">
            Get in Touch
          </a>
        </div>
      </div>
    </section>
  </main>
</PageLayout>