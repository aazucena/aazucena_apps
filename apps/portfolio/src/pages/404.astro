---
import { ArrowLeft, Compass, Home } from "@aazucena/icons";
import { Badge, buttonVariants } from "@aazucena/ui";
import PageLayout from "~/layouts/PageLayout.astro";
import WatermarkBackground from "~/components/common/WatermarkBackground.astro";

const pageTitle = "404 - Page Not Found";
const pageDescription =
  "The page you are looking for has drifted out of orbit.";
---

<PageLayout title={pageTitle} description={pageDescription}>
  <main class="bg-background relative flex min-h-screen flex-col items-center justify-center overflow-hidden">
    <WatermarkBackground text="LOST" max="30rem" />
    <div class="relative z-10 mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <p class="micro-label text-muted-foreground mb-8">LOST // SIGNAL</p>

      <!-- 404 Visual -->
      <h1 class="text-signal font-mono text-[9rem] leading-none font-light tracking-normal">
        404
      </h1>
      <div class="mt-8 flex justify-center">
        <Badge variant="destructive">Drifted Out of Orbit</Badge>
      </div>

      <!-- Error Message -->
      <div class="mt-8 mb-12 space-y-4">
        <h2 class="text-foreground text-4xl font-bold tracking-tight">
          Houston, we have
          <span class="text-signal">a problem.</span>
        </h2>
        <p class="text-muted-foreground mx-auto max-w-md text-base leading-relaxed">
          The page you're looking for has drifted into deep space. Let's get you
          back to mission control.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="mb-16 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class={buttonVariants({ variant: "default", class: "group press" })}
        >
          <Home
            size={16}
            aria-hidden="true"
            className="hover-nudge [--nudge-x:0px] [--nudge-y:-2px]"
          />
          Back to Safety
        </a>
        <button
          onclick="history.back()"
          class={buttonVariants({ variant: "outline", class: "group press" })}
        >
          <ArrowLeft
            size={16}
            aria-hidden="true"
            className="hover-nudge [--nudge-x:-4px]"
          />
          Previous Page
        </button>
      </div>

      <!-- Navigation Beacon -->
      <div>
        <p class="micro-label text-muted-foreground mb-4 flex items-center justify-center gap-2">
          <Compass
            size={14}
            aria-hidden="true"
            className="spin-slow text-signal"
          />
          NAVIGATION // BEACON
        </p>
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-3">
          {[
            { label: "Projects", href: "/projects" },
            { label: "Experience", href: "/experiences" },
            { label: "Skills", href: "/skills" },
            { label: "Blog", href: "/blog" },
            { label: "About", href: "/about" },
          ].map((link) => (
            <a
              href={link.href}
              class="group text-foreground hover:text-signal focus-visible:outline-signal relative text-sm font-medium tracking-wide uppercase transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
            >
              {link.label}
              <span
                aria-hidden="true"
                class="bg-signal absolute -bottom-1 left-0 h-0.5 w-0 motion-safe:transition-[width] motion-safe:duration-(--motion-base) group-hover:w-full group-focus-visible:w-full"
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
</PageLayout>
