---
import PageLayout from "~/layouts/PageLayout.astro";
import WatermarkBackground from "~/components/common/WatermarkBackground.astro";
import { DangerCircle, Home, Refresh, Terminal } from "@aazucena/icons";
import { Badge, buttonVariants } from "@aazucena/ui";

export const prerender = false;

const pageTitle = "500 - Internal Server Error";
const pageDescription =
  "The system encountered an unexpected malfunction. Our engineering team has been notified.";

// In Astro, 500.astro receives the error object in its props if configured
interface Props {
  error?: unknown;
}

const { error } = Astro.props;
---

<PageLayout title={pageTitle} description={pageDescription}>
  <main class="bg-background relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center">
    <WatermarkBackground text="ERROR" max="30rem" />
    <div class="relative z-10 mx-auto max-w-xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="micro-label text-muted-foreground mb-8">SYSTEM // FAULT</p>

      <!-- 500 Visual -->
      <h1 class="text-signal font-mono text-[9rem] leading-none font-light tracking-widest md:text-[14rem]">
        500
      </h1>
      <div class="mt-8 flex justify-center">
        <Badge variant="destructive">System Malfunction</Badge>
      </div>

      <!-- Error Message -->
      <div class="mt-8 mb-12 space-y-4">
        <h2 class="text-foreground text-4xl font-bold tracking-tight md:text-5xl">
          Critical <br class="hidden md:block" />
          <span class="text-signal">Core Failure.</span>
        </h2>
        <p class="text-muted-foreground mx-auto max-w-md text-lg leading-relaxed">
          Something went wrong deep within the system. We're working on
          stabilizing the core.
        </p>
      </div>

      <!-- Error Detail (DEV ONLY) -->
      {import.meta.env.DEV && error && (
        <>
          {/* eslint-disable jsx-a11y/no-noninteractive-tabindex -- scrollable pane must be keyboard-focusable */}
          <div
            aria-label="Debug info"
            role="region"
            tabindex="0"
            class="bg-panel border-rule rounded-card focus-visible:outline-signal mb-12 max-h-64 overflow-auto border p-4 text-left focus-visible:outline-1 focus-visible:outline-offset-2"
          >
            <p class="micro-label text-alert mb-3 flex items-center gap-2">
              <Terminal size={14} aria-hidden="true" />▲ DEBUG INFO
            </p>
            <pre class="text-muted-foreground font-mono text-xs">
              {error instanceof Error
                ? error.stack
                : JSON.stringify(error, null, 2)}
            </pre>
          </div>
          {/* eslint-enable jsx-a11y/no-noninteractive-tabindex */}
        </>
      )}

      <!-- Action Buttons -->
      <div class="mb-16 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button
          onclick="window.location.reload()"
          class={buttonVariants({ variant: "default", class: "group press" })}
        >
          <Refresh
            size={16}
            aria-hidden="true"
            className="hover-spin [--spin:180deg]"
          />
          Reboot System
        </button>
        <a
          href="/"
          class={buttonVariants({ variant: "outline", class: "group press" })}
        >
          <Home
            size={16}
            aria-hidden="true"
            className="hover-nudge [--nudge-x:0px] [--nudge-y:-2px]"
          />
          Safe Harbor
        </a>
      </div>

      <!-- Support Status -->
      <div>
        <p class="micro-label text-muted-foreground mb-3 flex items-center justify-center gap-2">
          <DangerCircle size={14} aria-hidden="true" />
          INCIDENT // MONITORING ACTIVE
        </p>
        <p class="text-muted-foreground mx-auto max-w-xs text-xs leading-relaxed">
          Automated logs have been dispatched to the engineering deck for
          immediate analysis.
        </p>
      </div>
    </div>
  </main>
</PageLayout>
