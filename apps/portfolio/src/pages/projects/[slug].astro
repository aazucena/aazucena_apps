---
/**
 * Project detail page - displays full project case study.
 * Includes metrics, screenshots, tech stack, and navigation.
 */
import { BrandGithub, Briefcase, ExternalLink } from '@mynaui/icons-react';
import { MarkdownRenderer } from '~/components/blocks/MarkdownRenderer';
import { MetricCard } from '~/components/ui/MetricCard';
import { RelatedLinks } from '~/components/ui/RelatedLinks';
import { TechStackDistribution } from '~/components/ui/TechStackDistribution';
import { StatusBadge } from '~/components/ui/StatusBadge';
import DetailLayout from '~/layouts/DetailLayout.astro';
import { getProjects } from '~/lib/api/projects';
import { getProjectStatusVariant, formatProjectDate } from '~/lib/utils/projects';

// Generate static paths for all projects
export async function getStaticPaths() {
  try {
    const projects = await getProjects('listed');
    return projects.map((project, index) => {
      const nextProject = index < projects.length - 1 ? projects[index + 1] : null;
      const prevProject = index > 0 ? projects[index - 1] : null;
      return {
        params: { slug: project.slug },
        props: { project, nextProject, prevProject },
      };
    });
  } catch (error) {
    console.error('Error generating project paths:', error);
    return [];
  }
}

const { project, nextProject, prevProject } = Astro.props;

if (!project) {
  return Astro.redirect('/404');
}

const startDateFormatted = formatProjectDate(project.startDate!);
const endDateFormatted = project.endDate ? formatProjectDate(project.endDate!) : (project.projectStatus === 'In Progress' ? 'Present' : null);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Portfolio', href: '/projects' },
  { label: project.title }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": project.title,
      "description": project.shortDescription,
      "applicationCategory": project.projectType || "WebApplication",
      "url": `https://aazucena.com/projects/${project.slug}`
    }
  ]
};

const seoTitle = project.seo?.title || project.title;
const seoDescription = project.seo?.description || project.shortDescription;
---

<DetailLayout
  title={seoTitle}
  description={seoDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="PROJECT"
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  prevItem={prevProject}
  nextItem={nextProject}
  basePath="/projects"
  prevLabel="Previous Case"
  nextLabel="Next Case"
  tocSelector="#project-content"
>
  <!-- Header slot: badges, title, action buttons -->
  <div slot="header" class="flex flex-col md:flex-row md:items-end justify-between gap-12">
    <div class="space-y-6 flex-1">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-[10px] font-black uppercase tracking-widest rounded-full border border-blue-100 dark:border-blue-800">
          {project.projectType}
        </span>
        {project.display === 'featured' && (
          <span class="px-3 py-1 bg-yellow-400/10 text-yellow-600 text-[10px] font-black uppercase tracking-widest rounded-full border border-yellow-400/20">
            Featured
          </span>
        )}
      </div>

      <h1 class="text-5xl md:text-8xl font-black text-gray-900 dark:text-white leading-none tracking-tighter">
        {project.title}
      </h1>

      <div class="flex flex-wrap gap-4 pt-4 print:hidden">
        {project.liveDemoUrl && (
          <a href={project.liveDemoUrl} target="_blank" class="inline-flex items-center gap-3 px-10 py-5 bg-blue-600 text-white rounded-[1.5rem] font-black text-xs uppercase tracking-[0.2em] hover:bg-blue-500 transition-all shadow-2xl shadow-blue-500/20 active:scale-95">
            <ExternalLink size={20} /> Live Demo
          </a>
        )}
        {project.repositoryUrl && (
          <a href={project.repositoryUrl} target="_blank" class="inline-flex items-center gap-3 px-10 py-5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-[1.5rem] font-black text-xs uppercase tracking-[0.2em] hover:bg-blue-600 dark:hover:bg-blue-50 transition-all shadow-xl active:scale-95">
            <BrandGithub size={20} /> Source
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Content slot: cover image, overview, metrics, screenshots -->
  <Fragment slot="content">
    <!-- Hero Image -->
    {project.coverImage?.url && (
      <div class="rounded-[2.5rem] overflow-hidden border border-gray-100 dark:border-gray-800 shadow-2xl group relative">
        <div class="absolute inset-0 bg-gradient-to-tr from-blue-600/10 to-transparent pointer-events-none"></div>
        <img src={project.coverImage.url} alt={project.title} class="w-full h-auto group-hover:scale-[1.02] transition-transform duration-1000" />
      </div>
    )}

    <!-- Narrative Overview -->
    <section id="overview" class="space-y-8">
      <h2 class="text-3xl font-black text-gray-900 dark:text-white tracking-tighter">Case Study Overview</h2>
      <article class="prose prose-lg dark:prose-invert max-w-none prose-p:leading-relaxed prose-headings:font-black">
        <MarkdownRenderer content={project.description} />
      </article>
    </section>

    <!-- Metrics -->
    {project.metrics && project.metrics.length > 0 && (
      <section id="impact" class="space-y-10">
        <h2 class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-[0.2em]">Success Metrics</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {project.metrics.map(metric => (
            <MetricCard client:visible {...metric} />
          ))}
        </div>
      </section>
    )}

    <!-- Visual Showcase -->
    {project.screenshots && project.screenshots.length > 0 && (
      <section id="gallery" class="space-y-12">
        <h2 class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-[0.2em]">Visual Deep Dive</h2>
        <div class="space-y-12">
          {project.screenshots.map((shot, idx) => shot?.url && (
            <figure class="space-y-4 group">
              <div class="rounded-[2rem] overflow-hidden border border-gray-100 dark:border-gray-800 shadow-xl transition-all duration-700 hover:shadow-2xl">
                <img src={shot.url} alt={shot.alt} class="w-full h-auto" loading="lazy" />
              </div>
              {shot.alt && (
                <figcaption class="text-[10px] font-black uppercase tracking-widest text-gray-400 text-center opacity-50 group-hover:opacity-100 transition-opacity">
                  Visual {idx + 1}: {shot.alt}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}
  </Fragment>

  <!-- Sidebar slot: tech stack, metadata, related links -->
  <Fragment slot="sidebar">
    <!-- Stack -->
    <div class="bg-white dark:bg-gray-900 rounded-[2rem] shadow-sm border border-gray-100 dark:border-gray-800 p-8 space-y-8">
      <h2 class="text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em] border-b border-gray-100 dark:border-gray-800 pb-4">
        Development Stack
      </h2>
      <TechStackDistribution skills={project.techStack} client:visible />
    </div>

    <!-- Metadata -->
    <div class="bg-white dark:bg-gray-900 rounded-[2rem] shadow-sm border border-gray-100 dark:border-gray-800 p-8 space-y-8">
      <h2 class="text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em] border-b border-gray-100 dark:border-gray-800 pb-4">
        Project Brief
      </h2>
      <div class="space-y-6">
        {[
          { label: 'Status', value: project.projectStatus, isPill: true },
          { label: 'Timeline', value: `${startDateFormatted} — ${endDateFormatted}` },
          { label: 'Platform', value: project.projectType }
        ].map(item => item.value && (
          <div>
            <div class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1">{item.label}</div>
            {item.isPill ? (
              <StatusBadge
                label={project.projectStatus}
                variant={getProjectStatusVariant(project.projectStatus!)}
                animated={project.projectStatus === 'Released' || project.projectStatus === 'In Progress'}
                size="sm"
              />
            ) : (
              <div class="text-sm font-bold text-gray-900 dark:text-white">{item.value}</div>
            )}
          </div>
        ))}
      </div>

      {/* Context Callout */}
      {project.experience && (
        <div class="pt-6 border-t border-gray-100 dark:border-gray-800">
          <div class="p-5 bg-blue-50/50 dark:bg-blue-900/10 rounded-2xl border border-blue-100 dark:border-blue-800/50 flex items-start gap-4">
            <Briefcase size={18} className="text-blue-600 mt-0.5" />
            <div>
              <div class="text-[9px] font-black text-blue-600 uppercase tracking-widest mb-1">Context</div>
              <div class="text-xs font-bold text-gray-900 dark:text-white leading-tight">{project.experience.position}</div>
              <div class="text-[10px] text-gray-500">{project.experience.company}</div>
            </div>
          </div>
        </div>
      )}
    </div>

    <RelatedLinks links={project.relatedLinks} />
  </Fragment>
</DetailLayout>
