---
/**
 * Project detail page - displays full project case study.
 * Includes metrics, screenshots, tech stack, and navigation.
 */
import { BrandGithub, Briefcase, ExternalLink } from "@aazucena/icons";
import { MarkdownRenderer, Gallery } from "@aazucena/ui";
import PanelBox from "~/components/common/PanelBox.astro";
import MetricCard from "~/components/ui/MetricCard.astro";
import { RelatedLinks } from "~/components/ui/RelatedLinks";
import { TechStackDistribution } from "~/components/ui/TechStackDistribution";
import StatusBadge from "~/components/ui/StatusBadge.astro";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getProjects } from "@aazucena/api";
import { getProjectStatusVariant, formatProjectDate } from "@aazucena/utils";

// Generate static paths for all projects
export async function getStaticPaths() {
  try {
    const projects = await getProjects("listed");
    return projects.map((project, index) => {
      const nextProject =
        index < projects.length - 1 ? projects[index + 1] : null;
      const prevProject = index > 0 ? projects[index - 1] : null;
      return {
        params: { slug: project.slug },
        props: { project, nextProject, prevProject },
      };
    });
  } catch (error) {
    console.error("Error generating project paths:", error);
    return [];
  }
}

const { project, nextProject, prevProject } = Astro.props;

if (!project) {
  return Astro.redirect("/404");
}

const startDateFormatted = formatProjectDate(project.startDate!);
const endDateFormatted = project.endDate
  ? formatProjectDate(project.endDate!)
  : project.projectStatus === "In Progress"
    ? "Present"
    : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Portfolio", href: "/projects" },
  { label: project.title },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: project.title,
      description: project.shortDescription,
      applicationCategory: project.projectType || "WebApplication",
      url: `https://aazucena.com/projects/${project.slug}`,
    },
  ],
};

const seoTitle = project.seo?.title || project.title;
const seoDescription = project.seo?.description || project.shortDescription;
---

<DetailLayout
  title={seoTitle}
  description={seoDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="PROJECT"
  watermarkSize="medium"
  hideWatermarkOnMobile
  maxWidth="5xl"
  hasSidebar={true}
  prevItem={prevProject}
  nextItem={nextProject}
  basePath="/projects"
  prevLabel="Previous Case"
  nextLabel="Next Case"
  tocSelector="#project-content"
>
  <!-- Header slot: badges, title, action buttons -->
  <div
    slot="header"
    class="flex flex-col justify-between gap-12 md:flex-row md:items-end"
  >
    <div class="flex-1 space-y-6">
      <div class="flex items-center gap-3">
        {project.projectType && (
          <span class="rounded-badge border-rule micro-label text-muted-foreground border px-2 py-0.5">
            {project.projectType}
          </span>
        )}
        {project.display === "featured" && (
          <span class="rounded-badge border-signal/60 micro-label text-signal border px-2 py-0.5">
            ● Featured
          </span>
        )}
      </div>

      <!-- prettier-ignore -->

      <h1 class="text-foreground text-5xl leading-none font-bold tracking-[-0.02em] md:text-[56px] md:leading-[normal]">{project.title}<span class="text-signal">.</span></h1>

      <div class="flex flex-wrap gap-3 pt-2 print:hidden">
        {project.liveDemoUrl && (
          <a
            href={project.liveDemoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-signal text-signal-foreground h-control rounded-control hover:bg-signal/90 focus-visible:outline-signal inline-flex items-center gap-2 px-4 text-sm font-medium transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
          >
            <ExternalLink size={16} aria-hidden="true" /> Live demo
          </a>
        )}
        {project.repositoryUrl && (
          <a
            href={project.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="border-rule-strong text-foreground h-control rounded-control hover:bg-state focus-visible:outline-signal inline-flex items-center gap-2 border px-4 text-sm font-medium transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
          >
            <BrandGithub size={16} aria-hidden="true" /> Source
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Content slot: cover image, overview, metrics, screenshots -->
  <Fragment slot="content">
    <!-- Hero Image -->
    {project.coverImage?.url && (
      <div class="border-rule rounded-card overflow-hidden border">
        <img
          src={project.coverImage.url}
          alt={project.coverImage.alt || project.title}
          class="h-auto w-full"
        />
      </div>
    )}

    <!-- Narrative Overview -->
    <section id="overview" class="space-y-6">
      <h2 class="text-foreground text-2xl font-semibold tracking-tight">
        Case Study Overview
      </h2>
      <article class="prose prose-lg dark:prose-invert prose-p:leading-relaxed max-w-none">
        <MarkdownRenderer content={project.description as string} />
      </article>
    </section>

    <!-- Metrics -->
    {project.metrics && project.metrics.length > 0 && (
      <section id="impact" class="space-y-4">
        <h2 class="micro-label text-muted-foreground">SUCCESS // METRICS</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {project.metrics.map((metric) => (
            <MetricCard {...metric} />
          ))}
        </div>
      </section>
    )}

    <!-- Visual Showcase -->
    {project.screenshots && project.screenshots.length > 0 && (
      <section id="gallery" class="space-y-6">
        <h2 class="micro-label text-muted-foreground">VISUAL // DEEP DIVE</h2>
        <div class="space-y-8">
          {project.screenshots.map(
            (shot, idx) =>
              shot?.url && (
                <figure class="space-y-3">
                  <div class="border-rule rounded-card overflow-hidden border">
                    <img
                      src={shot.url}
                      alt={shot.alt}
                      class="h-auto w-full"
                      loading="lazy"
                    />
                  </div>
                  {shot.alt && (
                    <figcaption class="micro-label text-muted-foreground">
                      Visual {idx + 1}: {shot.alt}
                    </figcaption>
                  )}
                </figure>
              ),
          )}
        </div>
      </section>
    )}
    <!-- Project Gallery -->
    {project.gallery && project.gallery.length > 0 && (
      <section id="project-gallery" class="space-y-4">
        <h2 class="micro-label text-muted-foreground">PROJECT // GALLERY</h2>
        <Gallery
          client:load
          items={project.gallery.map((img) => ({
            src: img.url!,
            alt: img.alt || project.title,
          }))}
        />
      </section>
    )}
  </Fragment>

  <!-- Sidebar slot: tech stack, metadata, related links -->
  <Fragment slot="sidebar">
    <PanelBox label="DEVELOPMENT // STACK">
      <TechStackDistribution skills={project.techStack} client:visible />
    </PanelBox>

    <PanelBox label="PROJECT // BRIEF">
      <dl class="flex flex-col gap-3">
        {[
          { label: "Status", value: project.projectStatus, isPill: true },
          {
            label: "Timeline",
            value: `${startDateFormatted} — ${endDateFormatted ?? "—"}`,
          },
          { label: "Platform", value: project.projectType },
        ].map(
          (item) =>
            item.value && (
              <div class="flex items-center justify-between gap-3">
                <dt class="micro-label text-muted-foreground">{item.label}</dt>
                <dd class="text-foreground text-right font-mono text-xs">
                  {item.isPill ? (
                    <StatusBadge
                      label={project.projectStatus}
                      variant={getProjectStatusVariant(project.projectStatus!)}
                      animated={
                        project.projectStatus === "Released" ||
                        project.projectStatus === "In Progress"
                      }
                      size="sm"
                    />
                  ) : (
                    item.value
                  )}
                </dd>
              </div>
            ),
        )}
      </dl>

      {project.experience && (
        <div class="border-rule mt-2 flex items-start gap-3 border-t pt-4">
          <Briefcase
            size={16}
            className="text-muted-foreground mt-0.5"
            aria-hidden="true"
          />
          <div>
            <div class="micro-label text-muted-foreground">Context</div>
            <div class="text-foreground text-sm font-medium">
              {project.experience.position}
            </div>
            <div class="text-muted-foreground text-xs">
              {project.experience.company}
            </div>
          </div>
        </div>
      )}
    </PanelBox>

    <RelatedLinks links={project.relatedLinks} />
  </Fragment>
</DetailLayout>
