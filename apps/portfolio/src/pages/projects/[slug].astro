---
/**
 * Project detail page - displays full project case study.
 * Includes metrics, screenshots, tech stack, and navigation.
 */
import { BrandGithub, Briefcase, ExternalLink } from "@mynaui/icons-react";
import { MarkdownRenderer } from "~/components/blocks/MarkdownRenderer";
import { MetricCard } from "~/components/ui/MetricCard";
import { RelatedLinks } from "~/components/ui/RelatedLinks";
import { TechStackDistribution } from "~/components/ui/TechStackDistribution";
import { StatusBadge } from "~/components/ui/StatusBadge";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getProjects } from "~/lib/api/projects";
import {
  getProjectStatusVariant,
  formatProjectDate,
} from "~/lib/utils/projects";

// Generate static paths for all projects
export async function getStaticPaths() {
  try {
    const projects = await getProjects("listed");
    return projects.map((project, index) => {
      const nextProject =
        index < projects.length - 1 ? projects[index + 1] : null;
      const prevProject = index > 0 ? projects[index - 1] : null;
      return {
        params: { slug: project.slug },
        props: { project, nextProject, prevProject },
      };
    });
  } catch (error) {
    console.error("Error generating project paths:", error);
    return [];
  }
}

const { project, nextProject, prevProject } = Astro.props;

if (!project) {
  return Astro.redirect("/404");
}

const startDateFormatted = formatProjectDate(project.startDate!);
const endDateFormatted = project.endDate
  ? formatProjectDate(project.endDate!)
  : project.projectStatus === "In Progress"
    ? "Present"
    : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Portfolio", href: "/projects" },
  { label: project.title },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: project.title,
      description: project.shortDescription,
      applicationCategory: project.projectType || "WebApplication",
      url: `https://aazucena.com/projects/${project.slug}`,
    },
  ],
};

const seoTitle = project.seo?.title || project.title;
const seoDescription = project.seo?.description || project.shortDescription;
---

<DetailLayout
  title={seoTitle}
  description={seoDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="PROJECT"
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  prevItem={prevProject}
  nextItem={nextProject}
  basePath="/projects"
  prevLabel="Previous Case"
  nextLabel="Next Case"
  tocSelector="#project-content"
>
  <!-- Header slot: badges, title, action buttons -->
  <div
    slot="header"
    class="flex flex-col justify-between gap-12 md:flex-row md:items-end"
  >
    <div class="flex-1 space-y-6">
      <div class="flex items-center gap-3">
        <span
          class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-[10px] font-black tracking-widest text-blue-600 uppercase dark:border-blue-800 dark:bg-blue-900/30 dark:text-blue-400"
        >
          {project.projectType}
        </span>
        {
          project.display === "featured" && (
            <span class="rounded-full border border-yellow-400/20 bg-yellow-400/10 px-3 py-1 text-[10px] font-black tracking-widest text-yellow-600 uppercase">
              Featured
            </span>
          )
        }
      </div>

      <h1
        class="text-5xl leading-none font-black tracking-tighter text-gray-900 md:text-8xl dark:text-white"
      >
        {project.title}<span class="text-blue-600">.</span>
      </h1>

      <div class="flex flex-wrap gap-4 pt-4 print:hidden">
        {
          project.liveDemoUrl && (
            <a
              href={project.liveDemoUrl}
              target="_blank"
              class="inline-flex items-center gap-3 rounded-[1.5rem] bg-blue-600 px-10 py-5 text-xs font-black tracking-[0.2em] text-white uppercase shadow-2xl shadow-blue-500/20 transition-all hover:bg-blue-500 active:scale-95"
            >
              <ExternalLink size={20} /> Live Demo
            </a>
          )
        }
        {
          project.repositoryUrl && (
            <a
              href={project.repositoryUrl}
              target="_blank"
              class="inline-flex items-center gap-3 rounded-[1.5rem] bg-gray-900 px-10 py-5 text-xs font-black tracking-[0.2em] text-white uppercase shadow-xl transition-all hover:bg-blue-600 active:scale-95 dark:bg-white dark:text-gray-900 dark:hover:bg-blue-50"
            >
              <BrandGithub size={20} /> Source
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Content slot: cover image, overview, metrics, screenshots -->
  <Fragment slot="content">
    <!-- Hero Image -->
    {
      project.coverImage?.url && (
        <div class="group relative overflow-hidden rounded-[2.5rem] border border-gray-100 shadow-2xl dark:border-gray-800">
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-blue-600/10 to-transparent" />
          <img
            src={project.coverImage.url}
            alt={project.title}
            class="h-auto w-full transition-transform duration-1000 group-hover:scale-[1.02]"
          />
        </div>
      )
    }

    <!-- Narrative Overview -->
    <section id="overview" class="space-y-8">
      <h2
        class="text-3xl font-black tracking-tighter text-gray-900 dark:text-white"
      >
        Case Study Overview
      </h2>
      <article
        class="prose prose-lg dark:prose-invert prose-p:leading-relaxed prose-headings:font-black max-w-none"
      >
        <MarkdownRenderer content={project.description} />
      </article>
    </section>

    <!-- Metrics -->
    {
      project.metrics && project.metrics.length > 0 && (
        <section id="impact" class="space-y-10">
          <h2 class="text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white">
            Success Metrics
          </h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {project.metrics.map((metric) => (
              <MetricCard client:visible {...metric} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Visual Showcase -->
    {
      project.screenshots && project.screenshots.length > 0 && (
        <section id="gallery" class="space-y-12">
          <h2 class="text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white">
            Visual Deep Dive
          </h2>
          <div class="space-y-12">
            {project.screenshots.map(
              (shot, idx) =>
                shot?.url && (
                  <figure class="group space-y-4">
                    <div class="overflow-hidden rounded-[2rem] border border-gray-100 shadow-xl transition-all duration-700 hover:shadow-2xl dark:border-gray-800">
                      <img
                        src={shot.url}
                        alt={shot.alt}
                        class="h-auto w-full"
                        loading="lazy"
                      />
                    </div>
                    {shot.alt && (
                      <figcaption class="text-center text-[10px] font-black tracking-widest text-gray-400 uppercase opacity-50 transition-opacity group-hover:opacity-100">
                        Visual {idx + 1}: {shot.alt}
                      </figcaption>
                    )}
                  </figure>
                ),
            )}
          </div>
        </section>
      )
    }
  </Fragment>

  <!-- Sidebar slot: tech stack, metadata, related links -->
  <Fragment slot="sidebar">
    <!-- Stack -->
    <div
      class="space-y-8 rounded-[2rem] border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Development Stack
      </h2>
      <TechStackDistribution skills={project.techStack} client:visible />
    </div>

    <!-- Metadata -->
    <div
      class="space-y-8 rounded-[2rem] border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Project Brief
      </h2>
      <div class="space-y-6">
        {
          [
            { label: "Status", value: project.projectStatus, isPill: true },
            {
              label: "Timeline",
              value: `${startDateFormatted} — ${endDateFormatted}`,
            },
            { label: "Platform", value: project.projectType },
          ].map(
            (item) =>
              item.value && (
                <div>
                  <div class="mb-1 text-[9px] font-black tracking-widest text-gray-400 uppercase">
                    {item.label}
                  </div>
                  {item.isPill ? (
                    <StatusBadge
                      label={project.projectStatus}
                      variant={getProjectStatusVariant(project.projectStatus!)}
                      animated={
                        project.projectStatus === "Released" ||
                        project.projectStatus === "In Progress"
                      }
                      size="sm"
                    />
                  ) : (
                    <div class="text-sm font-bold text-gray-900 dark:text-white">
                      {item.value}
                    </div>
                  )}
                </div>
              ),
          )
        }
      </div>

      {/* Context Callout */}
      {
        project.experience && (
          <div class="border-t border-gray-100 pt-6 dark:border-gray-800">
            <div class="flex items-start gap-4 rounded-2xl border border-blue-100 bg-blue-50/50 p-5 dark:border-blue-800/50 dark:bg-blue-900/10">
              <Briefcase size={18} className="text-blue-600 mt-0.5" />
              <div>
                <div class="mb-1 text-[9px] font-black tracking-widest text-blue-600 uppercase">
                  Context
                </div>
                <div class="text-xs leading-tight font-bold text-gray-900 dark:text-white">
                  {project.experience.position}
                </div>
                <div class="text-[10px] text-gray-500">
                  {project.experience.company}
                </div>
              </div>
            </div>
          </div>
        )
      }
    </div>

    <RelatedLinks links={project.relatedLinks} />
  </Fragment>
</DetailLayout>
