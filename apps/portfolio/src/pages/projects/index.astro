---
import { cmsTone } from "~/lib/utils/cms-tone";
/**
 * Projects list page - displays all publicly listed projects with filtering.
 * Fetches from CMS and groups by type/status.
 */
import ListLayout from "~/layouts/ListLayout.astro";
import type { FilterConfig } from "~/layouts/ListLayout.astro";
import { getProjects } from "@aazucena/api";
import type { Project } from "@aazucena/types";
import { toTitleCase } from "@aazucena/utils";
import { getCompanyInitials } from "@aazucena/utils";
import { getProjectStatusVariant, formatProjectDate } from "@aazucena/utils";
import StatusBadge from "~/components/ui/StatusBadge.astro";
import { ArrowRight, Calendar, Star } from "@aazucena/icons";

// Fetch all publicly listed projects
let projects: Project[] = [];
try {
  projects = await getProjects("listed");
} catch (error) {
  console.error("Error fetching projects:", error);
}

// Get unique project types and statuses for filters
const projectTypes = [...new Set(projects.map((p) => p.projectType))]
  .filter(Boolean)
  .sort() as string[];
const projectStatuses = [...new Set(projects.map((p) => p.projectStatus))]
  .filter(Boolean)
  .sort() as string[];

const filters: FilterConfig[] = [
  { id: "type", label: "Project Type", options: projectTypes },
  { id: "status", label: "Status", options: projectStatuses },
];
---

<ListLayout
  title="Portfolio"
  description={`A collection of ${projects.length} projects spanning software engineering, creative technology, and problem-solving.`}
  watermark="PORTFOLIO"
  filters={filters}
  searchPlaceholder="Search projects by tech, title..."
  layout="grid"
  maxWidth="7xl"
  hasItems={projects.length > 0}
>
  {projects.map((project) => (
    <article
      class="item-card group linked-card hover-lift bg-panel border-rule rounded-card hover:border-signal focus-within:border-signal relative flex flex-col overflow-hidden border [--transition-also:border-color]"
      data-filter-type={project.projectType || ""}
      data-filter-status={project.projectStatus || ""}
      data-search={`${project.title} ${project.shortDescription} ${project.tags.map((t) => t.label).join(" ")} ${project.techStack.map((s) => (typeof s === "string" ? s : s.name)).join(" ")}`.toLowerCase()}
    >
      {/* Cover Image */}
      <div class="border-rule relative aspect-[16/10] overflow-hidden border-b">
        {project.coverImage?.url ? (
          <img
            src={project.coverImage.url}
            alt={project.coverImage.alt || project.title}
            class="hover-grow h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <div class="bg-state flex h-full w-full items-center justify-center">
            <span
              class="text-muted-foreground font-mono text-5xl font-semibold tracking-tighter select-none"
              aria-hidden="true"
            >
              {getCompanyInitials(project.title)}
            </span>
          </div>
        )}
      </div>

      <div class="p-panel flex flex-1 flex-col gap-3">
        <div class="flex flex-wrap items-center gap-2">
          {project.projectType && (
            <span class="rounded-badge border-rule micro-label text-muted-foreground border px-2 py-0.5">
              {project.projectType}
            </span>
          )}
          {project.display === "featured" && (
            <span class="rounded-badge border-signal/60 micro-label text-signal flex items-center gap-1 border px-2 py-0.5">
              <Star size={10} aria-hidden="true" /> Featured
            </span>
          )}
          <span class="micro-label text-muted-foreground flex items-center gap-1.5">
            <Calendar size={12} aria-hidden="true" />
            {formatProjectDate(project.startDate)}{" "}
            {project.endDate
              ? `— ${formatProjectDate(project.endDate)}`
              : "— Present"}
          </span>
        </div>

        <h3 class="text-foreground text-base font-semibold tracking-tight">
          <a
            href={`/projects/${project.slug}`}
            class="group-hover:text-signal group-has-[:focus-visible]:text-signal motion-safe:transition-[color] after:absolute after:inset-0 focus-visible:outline-none"
          >
            {toTitleCase(project.title)}
          </a>
        </h3>

        <p class="text-muted-foreground line-clamp-3 text-sm">
          {project.shortDescription}
        </p>

        <div class="mt-auto flex flex-col gap-3">
          {project.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {project.tags.slice(0, 3).map((tag) => (
                <span
                  class="rounded-badge border-rule bg-state micro-label text-muted-foreground border px-2 py-0.5"
                  style={
                    cmsTone(tag.color)
                      ? `border-color: ${cmsTone(tag.color)}`
                      : undefined
                  }
                >
                  {tag.label}
                </span>
              ))}
              {project.tags.length > 3 && (
                <span class="micro-label text-muted-foreground py-0.5">
                  +{project.tags.length - 3}
                </span>
              )}
            </div>
          )}

          <div class="border-rule flex items-center justify-between border-t pt-3">
            {project.projectStatus ? (
              <StatusBadge
                label={project.projectStatus}
                variant={getProjectStatusVariant(project.projectStatus)}
                animated={
                  project.projectStatus === "Released" ||
                  project.projectStatus === "In Progress"
                }
                size="sm"
              />
            ) : (
              <span class="micro-label text-muted-foreground">—</span>
            )}

            <span class="micro-label text-signal flex items-center gap-1.5">
              Case Study
              <ArrowRight
                size={12}
                className="hover-nudge"
                aria-hidden="true"
              />
            </span>
          </div>
        </div>
      </div>
    </article>
  ))}
</ListLayout>
