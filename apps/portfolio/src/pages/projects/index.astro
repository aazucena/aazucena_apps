---
import ListLayout from '~/layouts/ListLayout.astro';
import type { FilterConfig } from '~/layouts/ListLayout.astro';
import { getProjects } from '~/lib/api/projects';
import type { Project } from '~/lib/transformers/projects';
import { getTagColorClasses } from '~/lib/utils/tagColors';
import { getCompanyLogoGradient, getCompanyInitials } from '~/lib/utils/experienceHelpers';
import { Star, Calendar, ArrowRight } from '@mynaui/icons-react';

// Fetch all publicly listed projects
let projects: Project[] = [];
try {
  projects = await getProjects('listed');
} catch (error) {
  console.error('Error fetching projects:', error);
}

// Get unique project types and statuses for filters
const projectTypes = [...new Set(projects.map(p => p.projectType))].filter(Boolean).sort() as string[];
const projectStatuses = [...new Set(projects.map(p => p.projectStatus))].filter(Boolean).sort() as string[];

const filters: FilterConfig[] = [
  { id: 'type', label: 'Project Type', options: projectTypes },
  { id: 'status', label: 'Status', options: projectStatuses }
];

const formatProjectDate = (date?: Date) => {
  if (!date) return '';
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
---

<ListLayout
  title="Portfolio"
  description={`A collection of ${projects.length} projects spanning software engineering, creative technology, and problem-solving.`}
  watermark="PORTFOLIO"
  filters={filters}
  searchPlaceholder="Search projects by tech, title..."
  layout="grid"
  maxWidth="7xl"
  hasItems={projects.length > 0}
>
  {projects.map((project) => (
    <article
      class="item-card flex flex-col group bg-white dark:bg-gray-900 rounded-[2rem] shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden hover:shadow-2xl hover:border-blue-500/20 transition-all duration-500 hover:-translate-y-2 relative"
      data-filter-type={project.projectType || ''}
      data-filter-status={project.projectStatus || ''}
      data-search={`${project.title} ${project.shortDescription} ${project.tags.map(t => t.label).join(' ')} ${project.techStack.map(s => typeof s === 'string' ? s : s.name).join(' ')}`.toLowerCase()}
    >
      <!-- Cover Image -->
      <div class="relative aspect-[16/10] overflow-hidden">
        {project.coverImage?.url ? (
          <img
            src={project.coverImage.url}
            alt={project.coverImage.alt || project.title}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
            loading="lazy"
          />
        ) : (
          <div class={`w-full h-full bg-gradient-to-br ${getCompanyLogoGradient(project.title)} opacity-90 flex items-center justify-center relative`}>
            <div class="absolute inset-0 bg-black/10"></div>
            <span class="text-6xl font-black text-white/30 select-none tracking-tighter">
              {getCompanyInitials(project.title)}
            </span>
          </div>
        )}
        
        <div class="absolute top-6 left-6 flex flex-col gap-2">
          {project.display === 'featured' && (
            <span class="bg-yellow-400 text-yellow-950 text-[10px] font-black uppercase tracking-[0.2em] px-3 py-1.5 rounded-xl shadow-xl flex items-center gap-1.5">
              <Star size={12} /> Featured
            </span>
          )}
          <span class="bg-black/40 backdrop-blur-md text-white text-[10px] font-black uppercase tracking-[0.2em] px-3 py-1.5 rounded-xl border border-white/10">
            {project.projectType}
          </span>
        </div>
      </div>

      <div class="p-8 flex-1 flex flex-col">
        <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 mb-4">
          <Calendar size={14} />
          {formatProjectDate(project.startDate)} {project.endDate ? `— ${formatProjectDate(project.endDate)}` : '— Present'}
        </div>

        <h3 class="text-2xl font-black text-gray-900 dark:text-white mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight tracking-tighter">
          <a href={`/projects/${project.slug}`}>
            {project.title}
          </a>
        </h3>

        <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 line-clamp-3 leading-relaxed font-medium">
          {project.shortDescription}
        </p>

        <div class="mt-auto space-y-6">
          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5">
            {project.tags.slice(0, 3).map(tag => (
              <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider border ${getTagColorClasses(tag.color)}`}>
                {tag.label}
              </span>
            ))}
            {project.tags.length > 3 && (
              <span class="text-[9px] font-black text-gray-400 py-0.5 uppercase tracking-widest">+ {project.tags.length - 3} more</span>
            )}
          </div>

          <div class="flex items-center justify-between pt-6 border-t border-gray-100 dark:border-gray-800">
            <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-widest border
              ${project.projectStatus === 'Released' || project.projectStatus === 'Completed' ? 'bg-green-50 text-green-700 border-green-100 dark:bg-green-900/20 dark:text-green-400 dark:border-green-900/50' : 'bg-blue-50 text-blue-700 border-blue-100 dark:bg-blue-900/20 dark:text-blue-400 dark:border-blue-900/50'}
            `}>
              <div class={`w-1 h-1 rounded-full ${project.projectStatus === 'Released' ? 'bg-green-500 animate-pulse' : 'bg-blue-500'}`}></div>
              {project.projectStatus}
            </span>

            <a href={`/projects/${project.slug}`} class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-xs font-black uppercase tracking-widest flex items-center gap-2 group/link">
              Case Study
              <ArrowRight size={16} className="transform group-hover/link:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
      </div>
    </article>
  ))}
</ListLayout>