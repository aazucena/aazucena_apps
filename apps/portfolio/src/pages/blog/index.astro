---
import {
  ArrowRight,
  BookOpen,
  ClockCircle as Clock,
  ExternalLink,
  FileText,
  Star,
} from "@mynaui/icons-react";
import ListLayout from "~/layouts/ListLayout.astro";
import type { FilterConfig } from "~/layouts/ListLayout.astro";
import { getPosts } from "~/lib/api/posts";
import {
  calculateReadTime,
  formatPostDate,
  getPostDateTime,
} from "~/lib/utils/blog";
import { getTagColorClasses } from "~/lib/utils/tagColors";
import { toTitleCase } from "~/lib/utils/text";
import type { BlogPost } from "~/lib/transformers/posts";

// Fetch all posts
let posts: BlogPost[] = [];
try {
  posts = await getPosts(false, 100);
} catch (error) {
  console.error("Error fetching blog posts:", error);
}

// Get unique tags for filtering
const allTags = [
  ...new Set(posts.flatMap((p) => p.tags.map((t: any) => t.label))),
].sort();

const filters: FilterConfig[] = [{ id: "tag", label: "Tag", options: allTags }];
---

<ListLayout
  title="Writings"
  description={`A collection of ${posts.length} articles, tutorials, and deep dives into software engineering, architecture, and creative coding.`}
  watermark="JOURNAL"
  filters={filters}
  searchPlaceholder="Search articles by title or tag..."
  layout="grid"
  maxWidth="7xl"
  hasItems={posts.length > 0}
>
  {
    posts.map((post) => (
      <article
        class="item-card group relative flex flex-col overflow-hidden rounded-[2rem] border border-gray-100 bg-white shadow-sm transition-all duration-500 hover:-translate-y-2 hover:border-blue-500/20 hover:shadow-2xl dark:border-gray-800 dark:bg-gray-900"
        data-filter-tag={post.tags.map((t: any) => t.label).join(",")}
        data-search={`${post.title} ${post.description} ${post.tags.map((t) => t.label).join(" ")}`.toLowerCase()}
      >
        {/* Featured/External Glow */}
        {post.featured && (
          <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-br from-yellow-400/5 to-transparent" />
        )}

        {/* Cover Image */}
        <div class="relative z-10 h-60 overflow-hidden">
          {post.coverImage?.url ? (
            <img
              src={post.coverImage?.url}
              alt={post.coverImage?.alt ?? post?.title}
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
              loading="lazy"
            />
          ) : (
            <div class="relative flex h-full w-full items-center justify-center bg-gradient-to-br from-blue-500/10 to-purple-500/10">
              <div class="absolute inset-0 bg-black/[0.02] dark:bg-white/[0.02]" />
              <FileText
                size={64}
                className="text-blue-500/20 dark:text-blue-400/20"
              />
            </div>
          )}

          {/* Badges Overlay */}
          <div class="absolute top-6 left-6 flex flex-col gap-2">
            {post.featured && (
              <span class="flex items-center gap-1.5 rounded-xl bg-yellow-400 px-3 py-1.5 text-[10px] font-black tracking-[0.2em] text-yellow-950 uppercase shadow-xl">
                <Star size={12} /> Featured
              </span>
            )}
            {post.isExternal && (
              <span class="flex items-center gap-1.5 rounded-xl border border-white/10 bg-black/40 px-3 py-1.5 text-[10px] font-black tracking-[0.2em] text-white uppercase backdrop-blur-md">
                <ExternalLink size={12} /> External
              </span>
            )}
          </div>
        </div>

        <div class="z-10 flex flex-1 flex-col p-8">
          {/* Metadata */}
          <div class="mb-4 flex items-center gap-4 text-[10px] font-black tracking-[0.2em] text-gray-400 uppercase">
            <time
              datetime={getPostDateTime(post)}
              class="flex items-center gap-1.5"
            >
              <Clock size={14} className="text-blue-500/50" />
              {formatPostDate(post)}
            </time>
            <span class="h-1 w-1 rounded-full bg-gray-300 dark:bg-gray-700" />
            <span class="flex items-center gap-1.5">
              <BookOpen size={14} className="text-purple-500/50" />
              {calculateReadTime(post.description)}
            </span>
          </div>

          <h3 class="mb-4 text-2xl leading-tight font-black tracking-tighter text-gray-900 transition-colors group-hover:text-blue-600 md:text-3xl dark:text-white dark:group-hover:text-blue-400">
            <a href={post.url}>{toTitleCase(post.title)}</a>
          </h3>

          <p class="mb-8 line-clamp-3 text-sm leading-relaxed font-medium text-gray-600 dark:text-gray-400">
            {post.description}
          </p>

          <div class="mt-auto space-y-6">
            {/* Tags */}
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag: any) => (
                <span
                  class={`inline-flex items-center rounded-lg border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase ${getTagColorClasses(tag.color)}`}
                >
                  {tag.label}
                </span>
              ))}
            </div>

            <div class="border-t border-gray-100 pt-6 dark:border-gray-800">
              <a
                href={post.url}
                class="group/link flex items-center gap-2 text-xs font-black tracking-[0.2em] text-blue-600 uppercase hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
              >
                Read Article
                <ArrowRight
                  size={16}
                  className="transform group-hover/link:translate-x-1 transition-transform"
                />
              </a>
            </div>
          </div>
        </div>
      </article>
    ))
  }
</ListLayout>
