---
import { cmsTone } from "~/lib/utils/cms-tone";
import {
  ArrowRight,
  BookOpen,
  ClockCircle as Clock,
  ExternalLink,
  FileText,
  Star,
} from "@aazucena/icons";
import ListLayout from "~/layouts/ListLayout.astro";
import type { FilterConfig, SortConfig } from "~/layouts/ListLayout.astro";
import { getPosts } from "@aazucena/api";
import {
  calculateReadTime,
  formatPostDate,
  getPostExcerpt,
} from "@aazucena/utils";
import { getPostDateTime } from "~/lib/utils/blog";
import { toTitleCase } from "@aazucena/utils";
import type { BlogPost } from "@aazucena/types";

// Fetch all posts
let posts: BlogPost[] = [];
try {
  posts = await getPosts(false, 100);
} catch (error) {
  console.error("Error fetching blog posts:", error);
}

// Get unique tags for filtering
const allTags = [
  ...new Set(posts.flatMap((p) => p.tags.map((t: any) => t.label))),
].sort();

const filters: FilterConfig[] = [{ id: "tag", label: "Tag", options: allTags }];

const sortOptions: SortConfig[] = [
  {
    id: "order",
    label: "Sort By",
    options: [
      { value: "date-desc", label: "Newest First" },
      { value: "date-asc", label: "Oldest First" },
      { value: "title-asc", label: "Title A → Z" },
      { value: "title-desc", label: "Title Z → A" },
    ],
  },
];
---

<ListLayout
  title="Writings"
  description={`A collection of ${posts.length} articles, tutorials, and deep dives into software engineering, architecture, and creative coding.`}
  watermark="JOURNAL"
  filters={filters}
  sortOptions={sortOptions}
  searchPlaceholder="Search articles by title or tag..."
  layout="grid"
  maxWidth="7xl"
  hasItems={posts.length > 0}
>
  {posts.map((post) => (
    <article
      class="item-card group linked-card hover-lift bg-panel border-rule rounded-card hover:border-signal focus-within:border-signal relative flex flex-col overflow-hidden border [--transition-also:border-color]"
      data-filter-tag={post.tags.map((t: any) => t.label).join(",")}
      data-sort-title={post.title.toLowerCase()}
      data-sort-date={getPostDateTime(post)}
      data-search={`${post.title} ${getPostExcerpt(post.description, 500)} ${post.tags.map((t) => t.label).join(" ")}`.toLowerCase()}
    >
      <div class="border-rule h-48 overflow-hidden border-b">
        {post.coverImage?.url ? (
          <img
            src={post.coverImage.url}
            alt={post.coverImage.alt ?? post.title}
            class="hover-grow h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <div class="bg-state flex h-full w-full items-center justify-center">
            <FileText
              size={48}
              className="text-muted-foreground"
              aria-hidden="true"
            />
          </div>
        )}
      </div>

      <div class="p-panel flex flex-1 flex-col gap-3">
        {(post.featured || post.isExternal || post.tags.length > 0) && (
          <div class="flex flex-wrap gap-1.5">
            {post.featured && (
              <span class="rounded-badge border-signal/60 micro-label text-signal flex items-center gap-1 border px-2 py-0.5">
                <Star size={10} aria-hidden="true" /> Featured
              </span>
            )}
            {post.isExternal && (
              <span class="rounded-badge border-rule micro-label text-muted-foreground flex items-center gap-1 border px-2 py-0.5">
                <ExternalLink size={10} aria-hidden="true" /> External
              </span>
            )}
            {post.tags.map((tag: any) => (
              <span
                class="rounded-badge border-rule bg-state micro-label text-muted-foreground border px-2 py-0.5"
                style={
                  cmsTone(tag.color)
                    ? `border-color: ${cmsTone(tag.color)}`
                    : undefined
                }
              >
                {tag.label}
              </span>
            ))}
          </div>
        )}

        <h2 class="text-foreground text-lg leading-snug font-semibold tracking-tight">
          <a
            href={post.url}
            target={post.isExternal ? "_blank" : undefined}
            rel={post.isExternal ? "noopener noreferrer" : undefined}
            class="group-hover:text-signal group-has-[:focus-visible]:text-signal motion-safe:transition-[color] after:absolute after:inset-0 focus-visible:outline-none"
          >
            {toTitleCase(post.title)}
          </a>
        </h2>

        <div class="micro-label text-muted-foreground flex items-center gap-3">
          <time
            datetime={getPostDateTime(post)}
            class="flex items-center gap-1.5"
          >
            <Clock size={12} aria-hidden="true" />
            {formatPostDate(post as { publishedAt: string })}
          </time>
          <span aria-hidden="true">//</span>
          <span class="flex items-center gap-1.5">
            <BookOpen size={12} aria-hidden="true" />
            {calculateReadTime(post.description)}
          </span>
        </div>

        <p class="text-muted-foreground line-clamp-3 text-sm leading-relaxed">
          {getPostExcerpt(post.description, 300)}
        </p>

        <span class="micro-label text-signal mt-auto flex items-center gap-1.5 pt-1">
          Read
          <ArrowRight size={12} className="hover-nudge" aria-hidden="true" />
        </span>
      </div>
    </article>
  ))}
</ListLayout>
