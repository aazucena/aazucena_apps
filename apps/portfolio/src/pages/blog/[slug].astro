---
import { BrandLinkedin, Twitter } from "@aazucena/icons";
import { MarkdownRenderer } from "@aazucena/ui";
import { RelatedLinks } from "~/components/ui/RelatedLinks";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getPosts } from "@aazucena/api";
import { calculateReadTime, formatPostDate } from "@aazucena/utils";
import { getPostDateTime } from "~/lib/utils/blog";

export async function getStaticPaths() {
  try {
    const posts = await getPosts(false, 100);
    const internalPosts = posts.filter((p) => !p.isExternal);
    return internalPosts.map((post, index) => {
      const nextPost = index > 0 ? internalPosts[index - 1] : null;
      const prevPost =
        index < internalPosts.length - 1 ? internalPosts[index + 1] : null;
      return {
        params: { slug: post.url.replace("/blog/", "") },
        props: { post, nextPost, prevPost },
      };
    });
  } catch (error) {
    console.error("Error generating blog paths:", error);
    return [];
  }
}

const { post, nextPost, prevPost } = Astro.props;
const seoTitle = post.seo?.title || post.title;
const seoDescription = (post.seo?.description || post.description) as string;
const siteOrigin = "https://aazucena.com";
const postUrl = `${siteOrigin}/blog/${post.slug}`;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Journal", href: "/blog" },
  { label: post.title },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  image: post.coverImage?.url,
  datePublished: post.publishedAt || post.createdAt,
  author: { "@type": "Person", name: "Aldrin Azucena" },
};
---

<DetailLayout
  title={seoTitle}
  description={seoDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="ARTICLE"
  watermarkSize="medium"
  maxWidth="4xl"
  hasSidebar={false}
  prevItem={
    prevPost
      ? { slug: prevPost.url.replace("/blog/", ""), title: prevPost.title }
      : null
  }
  nextItem={
    nextPost
      ? { slug: nextPost.url.replace("/blog/", ""), title: nextPost.title }
      : null
  }
  basePath="/blog"
  prevLabel="Previous"
  nextLabel="Next"
  tocSelector="#article-content"
>
  <!-- Header slot: tags, title, metadata -->
  <div slot="header" class="space-y-6">
    {post.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {post.tags.map((tag: any) => (
          <span class="rounded-badge border-rule bg-state micro-label text-muted-foreground border px-2 py-0.5">
            {tag.label}
          </span>
        ))}
      </div>
    )}

    <h1 class="text-foreground text-4xl leading-none font-semibold tracking-tighter md:text-6xl">
      {post.title}
      <span class="text-signal">.</span>
    </h1>

    <div class="micro-label text-muted-foreground flex flex-wrap items-center gap-3">
      <time datetime={getPostDateTime(post)}>
        {formatPostDate(post as { publishedAt: string })}
      </time>
      <span aria-hidden="true">//</span>
      <span>{calculateReadTime(post.description)}</span>
    </div>
  </div>

  <!-- Content slot: cover image, article, related links, share links -->
  <Fragment slot="content">
    {post.coverImage?.url && (
      <div class="border-rule rounded-card overflow-hidden border">
        <img
          src={post.coverImage?.url}
          alt={post.coverImage?.alt ?? post.title}
          class="h-auto w-full object-cover"
        />
      </div>
    )}

    <article
      id="article-content"
      class="prose prose-lg prose-p:leading-relaxed prose-headings:text-foreground prose-headings:font-semibold prose-headings:tracking-tight prose-p:text-foreground prose-li:text-foreground prose-strong:text-foreground prose-a:text-signal prose-a:underline prose-a:underline-offset-2 prose-blockquote:text-muted-foreground prose-blockquote:border-signal prose-code:text-signal prose-code:before:content-none prose-code:after:content-none max-w-none"
    >
      <MarkdownRenderer content={post.description as string} />
    </article>

    {post.relatedLinks && post.relatedLinks.length > 0 && (
      <RelatedLinks links={post.relatedLinks} title="DEEP DIVES // RESOURCES" />
    )}

    <!-- Share links -->
    <div class="border-rule flex flex-wrap items-center gap-4 border-t pt-6 print:hidden">
      <span class="micro-label text-muted-foreground">Share</span>
      <div class="flex gap-2">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(postUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on X (opens in a new tab)"
          class="border-rule-strong text-muted-foreground hover:text-foreground hover:bg-state rounded-control focus-visible:outline-signal flex size-control items-center justify-center border transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
        >
          <Twitter size={16} aria-hidden="true" />
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on LinkedIn (opens in a new tab)"
          class="border-rule-strong text-muted-foreground hover:text-foreground hover:bg-state rounded-control focus-visible:outline-signal flex size-control items-center justify-center border transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
        >
          <BrandLinkedin size={16} aria-hidden="true" />
        </a>
      </div>
      <button
        type="button"
        id="copy-link"
        data-url={postUrl}
        class="micro-label text-signal hover:text-foreground rounded-control focus-visible:outline-signal px-2 py-1 transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
      >
        Copy link
      </button>
      <a
        href="/rss.xml"
        rel="alternate"
        type="application/rss+xml"
        class="micro-label text-signal hover:text-foreground rounded-control focus-visible:outline-signal px-2 py-1 transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
      >
        RSS
      </a>
      <span
        id="copy-link-status"
        role="status"
        aria-live="polite"
        class="micro-label text-muted-foreground"
      ></span>
    </div>
  </Fragment>
</DetailLayout>

<script>
  const button = document.getElementById("copy-link");
  const status = document.getElementById("copy-link-status");
  let timer: ReturnType<typeof setTimeout> | undefined;
  button?.addEventListener("click", async () => {
    const url = button.dataset.url ?? window.location.href;
    let message = "Link copied";
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      message = "Copy failed";
    }
    if (!status) return;
    status.textContent = message;
    clearTimeout(timer);
    timer = setTimeout(() => {
      status.textContent = "";
    }, 2000);
  });
</script>
