---
/**
 * Contact page - provides a contact form and links to professional social channels.
 * Fetches availability status and social links from the CMS.
 */
import {
  Envelope,
  BrandLinkedin,
  BrandGithub,
  BrandTwitter,
  Send,
  Location,
  Globe,
  MessageDots,
} from "@aazucena/icons";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getPortfolio } from "~/lib/api/portfolio";
import { getAvailabilityIndicator } from "@aazucena/utils";

// Fetch contact info from Portfolio single type
const portfolio = await getPortfolio();

const pageTitle = "Contact";
const pageDescription = `Let's build something together. Currently ${portfolio.availabilityStatus.toLowerCase()} and interesting collaborations.`;

// Get dynamic indicator styles
const statusIndicator = getAvailabilityIndicator(portfolio.availabilityStatus);

// Helper to get local time
const localTime = new Date().toLocaleTimeString("en-US", {
  timeZone: portfolio?.timezone ?? "America/Edmonton", // Placeholder - should ideally come from portfolio.timezone
  hour: "2-digit",
  minute: "2-digit",
  hour12: true,
});

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Contact" }];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  mainEntity: {
    "@type": "Person",
    name: portfolio.fullName,
    email: portfolio.email,
    jobTitle: portfolio.occupation,
  },
};
---

<DetailLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="CONTACT"
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  showReadingProgress={false}
  basePath="/"
  showTableOfContents={false}
>
  <!-- Hero Header Slot -->
  <div slot="header" class="text-center md:text-left">
    <h1
      class="mb-8 text-5xl leading-none font-black tracking-tighter text-gray-900 md:text-8xl dark:text-white"
    >
      Let's build <br class="hidden md:block" /><span
        class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent"
        >together.</span
      >
    </h1>
    <p
      class="max-w-2xl text-xl leading-relaxed font-medium text-gray-600 md:text-2xl dark:text-gray-400"
    >
      {pageDescription}
    </p>
  </div>

  <!-- Main Content Slot: Form -->
  <Fragment slot="content">
    <section id="message" class="space-y-8">
      <h2
        class="flex items-center gap-3 text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white"
      >
        <MessageDots size={24} className="text-blue-600" />
        Send a Message
      </h2>

      <form class="space-y-6">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <label
              for="name"
              class="ml-4 text-[10px] font-black tracking-widest text-gray-400 uppercase"
              >Full Name</label
            >
            <input
              type="text"
              id="name"
              name="name"
              placeholder="John Doe"
              class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
            />
          </div>
          <div class="space-y-2">
            <label
              for="email"
              class="ml-4 text-[10px] font-black tracking-widest text-gray-400 uppercase"
              >Email Address</label
            >
            <input
              type="email"
              id="email"
              name="email"
              placeholder="john@example.com"
              class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
            />
          </div>
        </div>
        <div class="space-y-2">
          <label
            for="subject"
            class="ml-4 text-[10px] font-black tracking-widest text-gray-400 uppercase"
            >Subject</label
          >
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="How can I help?"
            class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
          />
        </div>
        <div class="space-y-2">
          <label
            for="message"
            class="ml-4 text-[10px] font-black tracking-widest text-gray-400 uppercase"
            >Message</label
          >
          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="Tell me about your project..."
            class="w-full resize-none rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
          ></textarea>
        </div>

        <button
          type="submit"
          class="group flex w-full items-center justify-center gap-3 rounded-2xl bg-gray-900 px-12 py-5 text-xs font-black tracking-[0.2em] text-white uppercase shadow-xl transition-all hover:bg-blue-600 active:scale-95 md:w-auto dark:bg-white dark:text-gray-900 dark:hover:bg-blue-50"
        >
          <Send
            size={18}
            className="transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1"
          />
          Send Message
        </button>
      </form>
    </section>
  </Fragment>

  <!-- Sidebar Slot -->
  <Fragment slot="sidebar">
    <!-- Availability -->
    <div
      class="space-y-8 rounded-3xl border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Presence
      </h2>
      <div class="space-y-6">
        <div class="group flex items-center gap-4">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-50 transition-transform group-hover:scale-110 dark:bg-gray-900/20"
          >
            <div class="relative flex h-2 w-2">
              {
                statusIndicator.pulse && (
                  <span
                    class={`absolute inline-flex h-full w-full animate-ping rounded-full ${statusIndicator.color} opacity-75`}
                  />
                )
              }
              <span
                class={`relative inline-flex rounded-full h-2 w-2 ${statusIndicator.color}`}
              ></span>
            </div>
          </div>
          <div>
            <div
              class="text-[10px] font-black tracking-wider text-gray-400 uppercase"
            >
              Status
            </div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              {portfolio.availabilityStatus}
            </div>
          </div>
        </div>

        <div class="group flex items-center gap-4">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/20"
          >
            <Globe size={20} />
          </div>
          <div>
            <div
              class="text-[10px] font-black tracking-wider text-gray-400 uppercase"
            >
              Local Time
            </div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              {localTime} (MST)
            </div>
          </div>
        </div>

        {
          portfolio.location && (
            <div class="group flex items-center gap-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-50 text-purple-600 dark:bg-purple-900/20">
                <Location size={20} />
              </div>
              <div>
                <div class="text-[10px] font-black tracking-wider text-gray-400 uppercase">
                  HQ
                </div>
                <div class="text-sm font-bold text-gray-900 dark:text-white">
                  {portfolio.location}
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>

    <!-- Direct Channels -->
    <div
      class="space-y-8 rounded-3xl border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Direct Channels
      </h2>
      <div class="space-y-4">
        <a
          href={`mailto:${portfolio.email}`}
          class="group flex items-center gap-4 rounded-2xl border border-transparent bg-gray-50/50 p-4 transition-all hover:border-blue-500/20 hover:bg-white dark:bg-gray-800/50 dark:hover:bg-gray-900"
        >
          <div
            class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/20"
          >
            <Envelope size={20} />
          </div>
          <div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              Email
            </div>
            <div
              class="text-[10px] font-black tracking-wider text-gray-400 uppercase"
            >
              Direct Message
            </div>
          </div>
        </a>

        {
          portfolio.socialLinks?.map((link) => (
            <a
              href={link.url}
              target="_blank"
              class="group flex items-center gap-4 rounded-2xl border border-transparent bg-gray-50/50 p-4 transition-all hover:border-blue-500/20 hover:bg-white dark:bg-gray-800/50 dark:hover:bg-gray-900"
            >
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-gray-100 text-gray-600 group-hover:text-blue-600 dark:bg-gray-800 dark:text-gray-400">
                {link.platform === "LinkedIn" && <BrandLinkedin size={20} />}
                {link.platform === "GitHub" && <BrandGithub size={20} />}
                {link.platform === "Twitter" && <BrandTwitter size={20} />}
                {!["LinkedIn", "GitHub", "Twitter"].includes(link.platform) && (
                  <Globe size={20} />
                )}
              </div>
              <div>
                <div class="text-sm font-bold text-gray-900 dark:text-white">
                  {link.platform}
                </div>
                <div class="text-[10px] font-black tracking-wider text-gray-400 uppercase">
                  {link.text || "Professional Profile"}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </Fragment>
</DetailLayout>
