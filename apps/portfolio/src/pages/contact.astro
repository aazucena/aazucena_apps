---
/**
 * Contact page - provides a contact form and links to professional social channels.
 * Fetches availability status and social links from the CMS.
 * SSR: keeps availability status and local time fresh on each request.
 */
export const prerender = false;
import {
  Envelope,
  BrandLinkedin,
  BrandGithub,
  Twitter,
  Send,
  Location,
  Globe,
  MessageDots,
} from "@aazucena/icons";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getPortfolio } from "@aazucena/api";
import { getAvailabilityIndicator } from "@aazucena/utils";

const portfolio = await getPortfolio();

const pageTitle = "Contact";
const pageDescription = `Let's build something together. Currently ${portfolio.availabilityStatus.toLowerCase()} and interesting collaborations.`;

const statusIndicator = getAvailabilityIndicator(portfolio.availabilityStatus);

const localTime = new Date().toLocaleTimeString("en-US", {
  timeZone: portfolio?.timezone ?? "America/Edmonton",
  hour: "2-digit",
  minute: "2-digit",
  hour12: true,
});

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Contact" }];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  mainEntity: {
    "@type": "Person",
    name: portfolio.fullName,
    email: portfolio.email,
    jobTitle: portfolio.occupation,
  },
};
---

<DetailLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="CONTACT"
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  showReadingProgress={false}
  basePath="/"
  showTableOfContents={false}
>
  <!-- Hero Header Slot -->
  <div slot="header" class="text-center md:text-left">
    <h1
      class="mb-8 text-5xl leading-none font-black tracking-tighter text-gray-900 md:text-8xl dark:text-white"
    >
      Let's build <br class="hidden md:block" /><span
        class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent"
        >together.</span
      >
    </h1>
    <p
      class="max-w-2xl text-xl leading-relaxed font-medium text-gray-600 md:text-2xl dark:text-gray-400"
    >
      {pageDescription}
    </p>
  </div>

  <!-- Main Content Slot: Form -->
  <Fragment slot="content">
    <section id="message" class="space-y-8">
      <h2
        class="flex items-center gap-3 text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white"
      >
        <MessageDots size={24} className="text-blue-600" />
        Send a Message
      </h2>

      <div
        id="contact-success"
        hidden
        class="rounded-2xl border border-green-200 bg-green-50 px-6 py-4 text-sm font-semibold text-green-800 dark:border-green-800/40 dark:bg-green-900/20 dark:text-green-300"
      >
        Message sent! I'll get back to you soon.
      </div>

      <div
        id="contact-error"
        hidden
        class="rounded-2xl border border-red-200 bg-red-50 px-6 py-4 text-sm font-semibold text-red-800 dark:border-red-800/40 dark:bg-red-900/20 dark:text-red-300"
      >
        Something went wrong. Please try again or reach out directly via email.
      </div>

      <form id="contact-form" class="space-y-6">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <label
              for="name"
              class="ml-4 block text-[10px] font-black tracking-widest text-gray-400 uppercase"
            >
              Full Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="John Doe"
              required
              autocomplete="name"
              class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
            />
            <p id="name-error" class="ml-4 text-[10px] font-bold text-red-500">
            </p>
          </div>
          <div class="space-y-2">
            <label
              for="email"
              class="ml-4 block text-[10px] font-black tracking-widest text-gray-400 uppercase"
            >
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="john@example.com"
              required
              autocomplete="email"
              class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
            />
            <p id="email-error" class="ml-4 text-[10px] font-bold text-red-500">
            </p>
          </div>
        </div>
        <div class="space-y-2">
          <label
            for="subject"
            class="ml-4 block text-[10px] font-black tracking-widest text-gray-400 uppercase"
          >
            Subject
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="How can I help?"
            required
            autocomplete="off"
            class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
          />
          <p id="subject-error" class="ml-4 text-[10px] font-bold text-red-500">
          </p>
        </div>
        <div class="space-y-2">
          <label
            for="message"
            class="ml-4 block text-[10px] font-black tracking-widest text-gray-400 uppercase"
          >
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="Tell me about your project..."
            required
            minlength="10"
            class="w-full resize-none rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-sm transition-all outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-gray-800 dark:bg-gray-900 dark:text-white"
          ></textarea>
          <p id="message-error" class="ml-4 text-[10px] font-bold text-red-500">
          </p>
        </div>

        <button
          id="contact-submit"
          type="submit"
          class="group flex w-full items-center justify-center gap-3 rounded-2xl bg-gray-900 px-12 py-5 text-xs font-black tracking-[0.2em] text-white uppercase shadow-xl transition-all hover:bg-blue-600 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50 md:w-auto dark:bg-white dark:text-gray-900 dark:hover:bg-blue-50"
        >
          <Send
            size={18}
            className="transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1"
          />
          <span id="contact-submit-label">Send Message</span>
        </button>
      </form>

      <script>
        import { actions, isInputError } from "astro:actions";

        const form = document.getElementById(
          "contact-form",
        ) as HTMLFormElement | null;
        const btn = document.getElementById(
          "contact-submit",
        ) as HTMLButtonElement | null;
        const label = document.getElementById("contact-submit-label");
        const successBanner = document.getElementById("contact-success");
        const errorBanner = document.getElementById("contact-error");

        const FIELDS = ["name", "email", "subject", "message"] as const;

        function setFieldError(field: string, message: string) {
          const input = document.getElementById(field);
          const errorEl = document.getElementById(`${field}-error`);
          input?.classList.add(
            "border-red-400",
            "focus:border-red-500",
            "focus:ring-red-500/20",
          );
          input?.classList.remove(
            "border-gray-100",
            "focus:border-blue-500",
            "focus:ring-blue-500/20",
            "dark:border-gray-800",
          );
          if (errorEl) errorEl.textContent = message;
        }

        function clearErrors() {
          for (const f of FIELDS) {
            const input = document.getElementById(f);
            const errorEl = document.getElementById(`${f}-error`);
            input?.classList.remove(
              "border-red-400",
              "focus:border-red-500",
              "focus:ring-red-500/20",
            );
            input?.classList.add(
              "border-gray-100",
              "focus:border-blue-500",
              "focus:ring-blue-500/20",
              "dark:border-gray-800",
            );
            if (errorEl) errorEl.textContent = "";
          }
          if (successBanner) successBanner.hidden = true;
          if (errorBanner) errorBanner.hidden = true;
        }

        form?.addEventListener("submit", async (e) => {
          e.preventDefault();
          clearErrors();
          if (btn) btn.disabled = true;
          if (label) label.textContent = "Sending…";

          const { data, error } = await actions.contact(new FormData(form!));

          if (data?.success) {
            form!.reset();
            if (successBanner) successBanner.hidden = false;
            successBanner?.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
            });
          } else if (isInputError(error)) {
            for (const [field, messages] of Object.entries(error.fields)) {
              setFieldError(field, String(messages?.[0] ?? ""));
            }
          } else {
            if (errorBanner) errorBanner.hidden = false;
          }

          if (btn) btn.disabled = false;
          if (label) label.textContent = "Send Message";
        });
      </script>
    </section>
  </Fragment>

  <!-- Sidebar Slot -->
  <Fragment slot="sidebar">
    <!-- Availability -->
    <div
      class="space-y-8 rounded-3xl border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Presence
      </h2>
      <div class="space-y-6">
        <div class="group flex items-center gap-4">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-50 transition-transform group-hover:scale-110 dark:bg-gray-900/20"
          >
            <div class="relative flex h-2 w-2">
              {
                statusIndicator.pulse && (
                  <span
                    class={`absolute inline-flex h-full w-full animate-ping rounded-full ${statusIndicator.color} opacity-75`}
                  />
                )
              }
              <span
                class={`relative inline-flex rounded-full h-2 w-2 ${statusIndicator.color}`}
              ></span>
            </div>
          </div>
          <div>
            <div
              class="text-[10px] font-black tracking-wider text-gray-400 uppercase"
            >
              Status
            </div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              {portfolio.availabilityStatus}
            </div>
          </div>
        </div>

        <div class="group flex items-center gap-4">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/20"
          >
            <Globe size={20} />
          </div>
          <div>
            <div
              class="text-[10px] font-black tracking-wider text-gray-400 uppercase"
            >
              Local Time
            </div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              {localTime} (MST)
            </div>
          </div>
        </div>

        {
          portfolio.location && (
            <div class="group flex items-center gap-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-50 text-purple-600 dark:bg-purple-900/20">
                <Location size={20} />
              </div>
              <div>
                <div class="text-[10px] font-black tracking-wider text-gray-400 uppercase">
                  HQ
                </div>
                <div class="text-sm font-bold text-gray-900 dark:text-white">
                  {portfolio.location}
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>

    <!-- Direct Channels -->
    <div
      class="space-y-8 rounded-3xl border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Direct Channels
      </h2>
      <div class="space-y-4">
        <a
          href={`mailto:${portfolio.email}`}
          class="group flex items-center gap-4 rounded-2xl border border-transparent bg-gray-50/50 p-4 transition-all hover:border-blue-500/20 hover:bg-white dark:bg-gray-800/50 dark:hover:bg-gray-900"
        >
          <div
            class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/20"
          >
            <Envelope size={20} />
          </div>
          <div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              Email
            </div>
            <div
              class="text-[10px] font-black tracking-wider text-gray-400 uppercase"
            >
              Direct Message
            </div>
          </div>
        </a>

        {
          portfolio.socialLinks?.map((link) => (
            <a
              href={link.url}
              target="_blank"
              class="group flex items-center gap-4 rounded-2xl border border-transparent bg-gray-50/50 p-4 transition-all hover:border-blue-500/20 hover:bg-white dark:bg-gray-800/50 dark:hover:bg-gray-900"
            >
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-gray-100 text-gray-600 group-hover:text-blue-600 dark:bg-gray-800 dark:text-gray-400">
                {link.platform === "LinkedIn" && <BrandLinkedin size={20} />}
                {link.platform === "GitHub" && <BrandGithub size={20} />}
                {link.platform === "Twitter" && <Twitter size={20} />}
                {!["LinkedIn", "GitHub", "Twitter"].includes(link.platform) && (
                  <Globe size={20} />
                )}
              </div>
              <div>
                <div class="text-sm font-bold text-gray-900 dark:text-white">
                  {link.platform}
                </div>
                <div class="text-[10px] font-black tracking-wider text-gray-400 uppercase">
                  {link.text || "Professional Profile"}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </Fragment>
</DetailLayout>
