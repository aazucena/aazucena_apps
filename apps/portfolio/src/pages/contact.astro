---
/**
 * Contact page - provides a contact form and links to professional social channels.
 * Fetches availability status and social links from the CMS.
 * SSR: keeps availability status and local time fresh on each request.
 */
export const prerender = false;
import {
  Envelope,
  Send,
  ArrowRight,
  ClockCircle as Clock,
  Location,
  MessageDots,
} from "@aazucena/icons";
import { Button, Input, Label, Textarea } from "@aazucena/ui";
import DetailLayout from "~/layouts/DetailLayout.astro";
import PanelBox from "~/components/common/PanelBox.astro";
import StatRow from "~/components/common/StatRow.astro";
import PlatformIcon from "~/components/common/PlatformIcon.astro";
import { getPortfolio } from "@aazucena/api";
import { getAvailabilityIndicator } from "@aazucena/utils";
import AvailabilityIndicator from "~/components/common/AvailabilityIndicator.astro";

const portfolio = await getPortfolio();

const pageTitle = "Contact";
const pageDescription = `Let's build something together. Currently ${portfolio.availabilityStatus.toLowerCase()} and interesting collaborations.`;

// Availability: same marker treatment as the Footer (mono line, status tone)
const availability = getAvailabilityIndicator(portfolio.availabilityStatus);

const localTime = new Date().toLocaleTimeString("en-US", {
  timeZone: portfolio?.timezone ?? "America/Edmonton",
  hour: "2-digit",
  minute: "2-digit",
  hour12: true,
});

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Contact" }];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  mainEntity: {
    "@type": "Person",
    name: portfolio.fullName,
    email: portfolio.email,
    jobTitle: portfolio.occupation,
  },
};
---

<DetailLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="CONTACT"
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  showReadingProgress={false}
  basePath="/"
  showTableOfContents={false}
>
  <!-- Hero Header Slot -->
  <div slot="header" class="text-center md:text-left">
    <h1 class="text-foreground mb-6 text-5xl leading-none font-bold tracking-[-0.02em] md:text-[56px]">
      Let's build <br class="hidden md:block" />
      <span class="text-signal">together.</span>
    </h1>
    <p class="text-muted-foreground max-w-2xl text-lg leading-relaxed">
      {pageDescription}
    </p>
  </div>

  <!-- Main Content Slot: Form -->
  <Fragment slot="content">
    <section id="message" class="space-y-4">
      <h2 class="micro-label text-muted-foreground flex items-center gap-2">
        <MessageDots size={14} aria-hidden="true" />
        SEND // A MESSAGE
      </h2>
      <PanelBox>
        <div
          id="contact-success"
          role="status"
          hidden
          class="border-rule text-success rounded-control mb-4 border px-4 py-3 text-sm"
        >
          OK Message sent! I'll get back to you soon.
        </div>

        <div
          id="contact-error"
          role="alert"
          hidden
          class="border-alert text-alert rounded-control mb-4 border px-4 py-3 text-sm"
        >
          ▲ Something went wrong. Please try again or reach out directly via
          email.
        </div>

        <form id="contact-form" class="flex flex-col gap-4">
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="flex flex-col gap-2">
              <Label
                htmlFor="name"
                className="micro-label text-muted-foreground"
              >
                Full Name
              </Label>
              <Input
                type="text"
                id="name"
                name="name"
                placeholder="Jane Doe"
                required
                autoComplete="name"
                aria-describedby="name-error"
              />
              <p
                id="name-error"
                role="alert"
                class="text-alert micro-label"
              ></p>
            </div>
            <div class="flex flex-col gap-2">
              <Label
                htmlFor="email"
                className="micro-label text-muted-foreground"
              >
                Email Address
              </Label>
              <Input
                type="email"
                id="email"
                name="email"
                placeholder="jane@example.com"
                required
                autoComplete="email"
                aria-describedby="email-error"
              />
              <p
                id="email-error"
                role="alert"
                class="text-alert micro-label"
              ></p>
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <Label
              htmlFor="subject"
              className="micro-label text-muted-foreground"
            >
              Subject
            </Label>
            <Input
              type="text"
              id="subject"
              name="subject"
              placeholder="How can I help?"
              required
              autoComplete="off"
              aria-describedby="subject-error"
            />
            <p
              id="subject-error"
              role="alert"
              class="text-alert micro-label"
            ></p>
          </div>
          <div class="flex flex-col gap-2">
            <Label
              htmlFor="message"
              className="micro-label text-muted-foreground"
            >
              Message
            </Label>
            <Textarea
              id="message"
              name="message"
              rows={5}
              placeholder="Tell me about your project..."
              required
              minLength={10}
              aria-describedby="message-error"
              className="resize-none"
            />
            <p
              id="message-error"
              role="alert"
              class="text-alert micro-label"
            ></p>
          </div>

          <div>
            <Button id="contact-submit" type="submit" className="press group">
              <Send
                size={16}
                className="hover-nudge [--nudge-x:4px] [--nudge-y:-4px]"
                aria-hidden="true"
              />
              <span id="contact-submit-label">Send Message</span>
            </Button>
          </div>
        </form>
      </PanelBox>

      <script>
        import { actions, isInputError } from "astro:actions";

        const form = document.getElementById(
          "contact-form",
        ) as HTMLFormElement | null;
        const btn = document.getElementById(
          "contact-submit",
        ) as HTMLButtonElement | null;
        const label = document.getElementById("contact-submit-label");
        const successBanner = document.getElementById("contact-success");
        const errorBanner = document.getElementById("contact-error");

        const FIELDS = ["name", "email", "subject", "message"] as const;

        function setFieldError(field: string, message: string) {
          const input = document.getElementById(field);
          const errorEl = document.getElementById(`${field}-error`);
          input?.setAttribute("aria-invalid", "true");
          if (errorEl) errorEl.textContent = `▲ ${message}`;
        }

        function clearErrors() {
          for (const f of FIELDS) {
            const input = document.getElementById(f);
            const errorEl = document.getElementById(`${f}-error`);
            input?.removeAttribute("aria-invalid");
            if (errorEl) errorEl.textContent = "";
          }
          if (successBanner) successBanner.hidden = true;
          if (errorBanner) errorBanner.hidden = true;
        }

        form?.addEventListener("submit", async (e) => {
          e.preventDefault();
          clearErrors();
          if (btn) btn.disabled = true;
          if (label) label.textContent = "Sending…";

          const { data, error } = await actions.contact(new FormData(form!));

          if (data?.success) {
            form!.reset();
            if (successBanner) successBanner.hidden = false;
            successBanner?.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
            });
          } else if (isInputError(error)) {
            for (const [field, messages] of Object.entries(error.fields)) {
              setFieldError(field, String(messages?.[0] ?? ""));
            }
          } else {
            if (errorBanner) errorBanner.hidden = false;
          }

          if (btn) btn.disabled = false;
          if (label) label.textContent = "Send Message";
        });
      </script>
    </section>
  </Fragment>

  <!-- Sidebar Slot -->
  <Fragment slot="sidebar">
    <!-- Availability -->
    <PanelBox label="PRESENCE">
      <dl class="flex flex-col gap-3">
        <StatRow label="STATUS">
          <AvailabilityIndicator
            slot="tile"
            tone={availability.tone}
            marker={availability.marker}
            pulse={availability.pulse}
          />
          {portfolio.availabilityStatus}
        </StatRow>
        <StatRow label="LOCAL TIME" tileClass="text-signal">
          <Clock slot="tile" size={16} />
          {localTime} (MST)
        </StatRow>
        {portfolio.location && (
          <StatRow label="HQ" tileClass="text-signal">
            <Location slot="tile" size={16} />
            {portfolio.location}
          </StatRow>
        )}
      </dl>
    </PanelBox>

    <!-- Direct Channels -->
    <PanelBox
      label="DIRECT // CHANNELS"
      meta={String((portfolio.socialLinks?.length ?? 0) + 1)}
    >
      <ul class="-m-panel flex flex-col">
        <li>
          <a
            href={`mailto:${portfolio.email}`}
            class="group hover:bg-state border-rule px-panel focus-visible:outline-signal flex items-center justify-between gap-3 border-b py-3 transition-colors focus-visible:outline-1 focus-visible:-outline-offset-2"
          >
            <span class="flex items-center gap-3">
              <span class="hover-grow text-muted-foreground" aria-hidden="true">
                <Envelope size={18} />
              </span>
              <span>
                <span class="text-foreground block text-sm font-semibold">
                  Email
                </span>
                <span class="micro-label text-muted-foreground">
                  DIRECT MESSAGE
                </span>
              </span>
            </span>
            <ArrowRight
              size={14}
              className="hover-nudge text-signal"
              aria-hidden="true"
            />
          </a>
        </li>
        {portfolio.socialLinks?.map((link) => (
          <li class="border-rule border-b last:border-b-0">
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group hover:bg-state px-panel focus-visible:outline-signal flex items-center justify-between gap-3 py-3 transition-colors focus-visible:outline-1 focus-visible:-outline-offset-2"
            >
              <span class="flex items-center gap-3">
                <span
                  class="hover-grow text-muted-foreground"
                  aria-hidden="true"
                >
                  <PlatformIcon platform={link.platform} size={18} />
                </span>
                <span>
                  <span class="text-foreground block text-sm font-semibold">
                    {link.platform}
                  </span>
                  <span class="micro-label text-muted-foreground">
                    {link.text || "Professional Profile"}
                  </span>
                </span>
              </span>
              <ArrowRight
                size={14}
                className="hover-nudge text-signal"
                aria-hidden="true"
              />
            </a>
          </li>
        ))}
      </ul>
    </PanelBox>
  </Fragment>
</DetailLayout>
