---
import {
  ArrowRight,
  Briefcase,
  Location,
  Zap
} from '@mynaui/icons-react';
import ListLayout from '~/layouts/ListLayout.astro';
import type { FilterConfig } from '~/layouts/ListLayout.astro';
import { getExperiences } from '~/lib/api/experiences';
import { calculateDuration, getCompanyLogoGradient, getCompanyInitials } from '~/lib/utils/experienceHelpers';
import type { Experience } from '~/lib/transformers/experiences';

// Fetch all experiences
let experiences: Experience[] = [];
try {
  experiences = await getExperiences();
} catch (error) {
  console.error('Error fetching experiences:', error);
}

// Extract unique companies and employment types for filters
const companies = [...new Set(experiences.map(e => e.company))].sort();
const employmentTypes = [...new Set(experiences.map(e => e.employmentType))].filter(Boolean).sort() as string[];

const filters: FilterConfig[] = [
  { id: 'company', label: 'Company', options: companies },
  { id: 'type', label: 'Employment Type', options: employmentTypes }
];

// Helper to extract the first metric found in achievements
function getTopMetric(experience: Experience) {
  const metric = (experience.achievements || []).find(a => /([$+]?[\d\.,]+(?:%|\+|x|k|M|B)?)/.test(a.title));
  if (!metric) return null;
  const match = metric.title.match(/([$+]?[\d\.,]+(?:%|\+|x|k|M|B)?)/);
  return match ? { value: match[0], label: metric.title.replace(match[0], '').trim() } : null;
}
---

<ListLayout
  title="Experience"
  description={`A chronological timeline of my professional journey, showcasing ${experiences.length} positions and the impact I've delivered.`}
  watermark="JOURNEY"
  filters={filters}
  searchPlaceholder="Search by skills, company, or result..."
  layout="timeline"
  maxWidth="5xl"
  hasItems={experiences.length > 0}
>
  {experiences.map((experience, index) => {
    const topMetric = getTopMetric(experience);
    
    return (
      <div
        class="item-card group relative flex flex-col md:flex-row items-center"
        data-filter-company={experience.company}
        data-filter-type={experience.employmentType || ''}
        data-search={`${experience.company} ${experience.position} ${experience.skills.map(s => s.name).join(' ')} ${experience.location || ''}`.toLowerCase()}
      >
        <!-- Timeline Node -->
        <div class="absolute left-0 md:left-1/2 w-5 h-5 rounded-full bg-white dark:bg-gray-950 border-4 border-blue-600 dark:border-blue-400 transform md:-translate-x-1/2 z-20 group-hover:scale-125 transition-transform duration-500 shadow-xl shadow-blue-500/20"></div>

        <!-- Content Card Wrapper -->
        <div class={`timeline-content-wrapper w-full md:w-1/2 ml-8 md:ml-0 ${index % 2 === 0 ? 'md:mr-auto md:pr-16' : 'md:ml-auto md:pl-16'}`}>
          <div class="bg-white dark:bg-gray-900 rounded-[2rem] shadow-sm border border-gray-100 dark:border-gray-800 p-8 hover:shadow-xl hover:border-blue-300 dark:hover:border-blue-500/50 transition-all duration-500 group/card relative overflow-hidden">
            
            <!-- Hover Gradient Background -->
            <div class={`absolute inset-0 bg-gradient-to-br ${getCompanyLogoGradient(experience.company)} opacity-0 group-hover/card:opacity-[0.02] dark:group-hover/card:opacity-[0.05] transition-opacity duration-700 pointer-events-none`}></div>

            <!-- Duration Badge -->
            <div class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-[0.2em] bg-gray-50 dark:bg-gray-800 text-gray-400 dark:text-gray-500 mb-6 border border-gray-100 dark:border-gray-700">
              {calculateDuration(experience.startDate, experience.endDate, !experience.endDate)}
            </div>

            <!-- Company Info -->
            <div class="flex items-start gap-5 mb-8">
              <div class={`flex-shrink-0 w-16 h-16 rounded-2xl bg-gradient-to-br ${getCompanyLogoGradient(experience.company)} flex items-center justify-center text-white font-black text-xl shadow-xl group-hover/card:scale-110 transition-transform duration-700`}>
                {experience.companyLogo?.url ? (
                  <img src={experience.companyLogo.url} alt={experience.company} class="w-full h-full object-cover rounded-2xl" />
                ) : (
                  getCompanyInitials(experience.company)
                )}
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white mb-1 leading-tight tracking-tighter">
                  <a href={`/experiences/${experience.slug}`} class="group-hover/card:text-blue-600 dark:group-hover/card:text-blue-400 transition-colors">
                    {experience.position}
                  </a>
                </h3>
                <div class="text-sm font-bold text-blue-600 dark:text-blue-400 flex items-center gap-2">
                  {experience.company}
                </div>
                {experience.employmentType && (
                  <div class="text-[10px] text-gray-400 dark:text-gray-500 font-black uppercase tracking-widest mt-1 flex items-center gap-1.5">
                    <Briefcase size={12} />
                    {experience.employmentType}
                  </div>
                )}
              </div>
            </div>

            <!-- Impact Highlight -->
            {topMetric && (
              <div class="mb-8 p-4 bg-blue-50/50 dark:bg-blue-900/10 rounded-2xl border border-blue-100 dark:border-blue-800/50 flex items-center gap-4 group/metric">
                <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400">
                  <Zap size={20} className="animate-pulse" />
                </div>
                <div>
                  <div class="text-[10px] font-black text-blue-900/40 dark:text-blue-200/40 uppercase tracking-widest">Key Outcome</div>
                  <div class="text-base text-blue-900 dark:text-blue-100 font-bold leading-tight">
                    <span class="text-blue-600 dark:text-blue-400">{topMetric.value}</span> {topMetric.label}
                  </div>
                </div>
              </div>
            )}

            <!-- Skills -->
            <div class="flex flex-wrap gap-2 mb-8">
              {experience.skills.slice(0, 5).map(skill => (
                <span class="px-2.5 py-1 bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-[10px] font-bold uppercase tracking-wider rounded-lg border border-gray-100 dark:border-gray-700 hover:border-blue-500/20 transition-colors">
                  {skill.name}
                </span>
              ))}
              {experience.skills.length > 5 && (
                <span class="px-2.5 py-1 text-gray-400 dark:text-gray-500 text-[10px] font-bold uppercase tracking-widest">
                  +{experience.skills.length - 5}
                </span>
              )}
            </div>

            <!-- Bottom Actions -->
            <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100 dark:border-gray-800">
              <div class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">
                {experience.location && (
                  <span class="flex items-center gap-1.5">
                    <Location size={14} />
                    {experience.location}
                  </span>
                )}
              </div>
              
              <a
                href={`/experiences/${experience.slug}`}
                class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-xs font-black uppercase tracking-widest group/link"
              >
                Case Study
                <ArrowRight size={16} className="transform group-hover/link:translate-x-1 transition-transform" />
              </a>
            </div>
          </div>
        </div>
      </div>
    );
  })}
</ListLayout>
