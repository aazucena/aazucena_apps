---
import { ArrowRight, Briefcase, Location, Zap } from "@aazucena/icons";
import ListLayout from "~/layouts/ListLayout.astro";
import type { FilterConfig } from "~/layouts/ListLayout.astro";
import { getExperiences } from "@aazucena/api";
import { calculateDuration, getCompanyInitials } from "@aazucena/utils";
import { toTitleCase } from "@aazucena/utils";
import type { Experience } from "@aazucena/types";
import { getTopMetric } from "~/lib/utils/experience-metric";

// Fetch all experiences
let experiences: Experience[] = [];
try {
  experiences = await getExperiences();
} catch (error) {
  console.error("Error fetching experiences:", error);
}

// Extract unique companies and employment types for filters
const companies = [...new Set(experiences.map((e) => e.company))].sort();
const employmentTypes = [...new Set(experiences.map((e) => e.employmentType))]
  .filter(Boolean)
  .sort() as string[];

const filters: FilterConfig[] = [
  { id: "company", label: "Company", options: companies },
  { id: "type", label: "Employment Type", options: employmentTypes },
];
---

<ListLayout
  title="Experience"
  description={`A chronological timeline of my professional journey, showcasing ${experiences.length} positions and the impact I've delivered.`}
  watermark="JOURNEY"
  filters={filters}
  searchPlaceholder="Search by skills, company, or result..."
  layout="timeline"
  maxWidth="5xl"
  hasItems={experiences.length > 0}
>
  {experiences.map((experience) => {
    const isCurrent = experience.isCurrent || !experience.endDate;
    const topMetric = getTopMetric(experience);
    return (
      <div
        class="item-card group linked-card relative pl-12"
        data-filter-company={experience.company}
        data-filter-type={experience.employmentType || ""}
        data-search={`${experience.company} ${experience.position} ${experience.skills.map((s) => s.name).join(" ")} ${experience.location || ""}`.toLowerCase()}
      >
        {/* Timeline Node */}
        <div
          class:list={[
            "hover-grow absolute top-1/2 left-1 z-10 size-[11px] -translate-y-1/2 rounded-full border-2 [--grow:1.25] [--transition-also:border-color]",
            isCurrent
              ? "border-signal bg-signal"
              : "border-rule-strong bg-background group-hover:border-signal",
          ]}
          aria-hidden="true"
        />

        <article class="bg-panel border-rule rounded-card hover:border-signal focus-within:border-signal relative flex flex-col border transition-[border-color]">
          <div class="p-panel flex items-start gap-4">
            {/* Company mark: CMS logos keep their own colours */}
            <div
              class:list={[
                "hover-grow rounded-control border-rule flex size-10 shrink-0 items-center justify-center overflow-hidden border font-mono text-xs",
                experience.companyLogo?.url
                  ? "bg-(--logo-plate)"
                  : "bg-state text-signal",
              ]}
            >
              {experience.companyLogo?.url ? (
                <img
                  src={experience.companyLogo.url}
                  alt=""
                  class="h-full w-full object-contain p-1"
                />
              ) : (
                <span aria-hidden="true">
                  {getCompanyInitials(experience.company)}
                </span>
              )}
            </div>

            <div class="min-w-0 flex-1">
              <h3 class="text-foreground text-base font-semibold tracking-tight">
                <a
                  href={`/experiences/${experience.slug}`}
                  class="group-hover:text-signal group-has-[:focus-visible]:text-signal motion-safe:transition-[color] after:absolute after:inset-0 focus-visible:outline-none"
                >
                  {toTitleCase(experience.position)}
                </a>
              </h3>
              {/* Where: company and location together, so the footer keeps one shape */}
              <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-sm">
                <span class="text-signal flex items-center gap-1.5">
                  <Briefcase size={12} aria-hidden="true" />
                  {toTitleCase(experience.company)}
                </span>
                {experience.location && (
                  <span class="text-muted-foreground flex items-center gap-1.5">
                    <Location size={12} aria-hidden="true" />
                    {experience.location}
                  </span>
                )}
              </div>
            </div>

            <div class="flex shrink-0 flex-col items-end gap-1.5">
              {isCurrent && (
                <span class="rounded-badge border-signal/60 bg-signal-faint micro-label text-signal border px-2 py-0.5">
                  ● Current
                </span>
              )}
              <span class="text-foreground font-mono text-xs">
                {calculateDuration(
                  experience.startDate,
                  experience.endDate,
                  !experience.endDate,
                )}
              </span>
              {experience.employmentType && (
                <span class="rounded-badge border-rule micro-label text-muted-foreground border px-2 py-0.5">
                  {experience.employmentType}
                </span>
              )}
            </div>
          </div>

          {topMetric && (
            <div class="border-rule px-panel flex items-center gap-3 border-t py-2.5">
              <span class="text-signal shrink-0" aria-hidden="true">
                <Zap size={16} />
              </span>
              <div class="min-w-0">
                <div class="micro-label text-muted-foreground">KEY OUTCOME</div>
                <div class="text-foreground text-sm leading-tight font-semibold">
                  <span class="text-signal">{topMetric.value}</span>{" "}
                  {topMetric.label}
                </div>
              </div>
            </div>
          )}

          <div class="border-rule px-panel flex flex-col gap-2 border-t py-2.5 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
            <div class="flex min-w-0 flex-1 flex-wrap gap-1.5">
              {experience.skills.slice(0, 5).map((skill) => (
                <span class="rounded-badge border-rule bg-state micro-label text-muted-foreground border px-2 py-0.5 whitespace-nowrap">
                  {skill.name}
                </span>
              ))}
              {experience.skills.length > 5 && (
                <span class="micro-label text-muted-foreground py-0.5">
                  +{experience.skills.length - 5}
                </span>
              )}
            </div>
            {/* Same box as a tag, so it lines up with the first tag row; below the tags on phones */}
            <span class="micro-label text-signal flex shrink-0 items-center gap-1.5 border border-transparent py-0.5">
              Case Study
              <ArrowRight
                size={12}
                className="hover-nudge"
                aria-hidden="true"
              />
            </span>
          </div>
        </article>
      </div>
    );
  })}
</ListLayout>
