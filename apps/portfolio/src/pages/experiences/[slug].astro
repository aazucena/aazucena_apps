---
import { IconRenderer } from "@aazucena/ui";
import type { IconComponent } from "@aazucena/types";
import {
  ArrowRight,
  Briefcase,
  Calendar,
  Globe,
  Location,
} from "@aazucena/icons";
import { BlocksRenderer } from "@strapi/blocks-react-renderer";
import { defaultBlockRenderers } from "~/components/blocks/BlockRenderers";
import { MarkdownRenderer } from "@aazucena/ui";
import PanelBox from "~/components/common/PanelBox.astro";
import { RelatedLinks } from "~/components/ui/RelatedLinks";
import { TechStackDistribution } from "~/components/ui/TechStackDistribution";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getExperiences } from "@aazucena/api";
import { calculateDuration, getCompanyInitials } from "@aazucena/utils";

// Generate static paths for all experiences and pass data via props
export async function getStaticPaths() {
  try {
    const experiences = await getExperiences();

    return experiences.map((experience, index) => {
      const nextExperience = index > 0 ? experiences[index - 1] : null;
      const prevExperience =
        index < experiences.length - 1 ? experiences[index + 1] : null;

      return {
        params: { slug: experience.slug },
        props: {
          experience,
          nextExperience,
          prevExperience,
        },
      };
    });
  } catch (error) {
    console.error("Error generating experience paths:", error);
    return [];
  }
}

const { experience, nextExperience, prevExperience } = Astro.props;

if (!experience) {
  return Astro.redirect("/404");
}

// Extract Impact Metrics
const extractedMetrics = (experience.achievements || [])
  .filter((achievement) =>
    /([$+]?[\d.,]+(?:%|\+|x|k|M|B)?)/.test(achievement.title),
  )
  .map((achievement) => {
    const match = achievement.title.match(/([$+]?[\d.,]+(?:%|\+|x|k|M|B)?)/);
    if (!match) return null;
    const value = match[0];
    let label = achievement.title.replace(value, "").trim();
    // Anchored at ^ so no backtracking risk; safe-regex flags it as a false positive
    // eslint-disable-next-line security/detect-unsafe-regex
    const labelPrefixRe =
      /^(?:increased?|decreased?|reduction|growth|boosted?)(?:\s+(?:by|in|of))?\s*/i;
    label = label.replace(labelPrefixRe, "");
    if (label.length < 2) label = achievement.title;

    return {
      value,
      label,
      description: achievement.description,
      icon: achievement.icon as IconComponent | undefined,
    };
  })
  .filter(Boolean);

const isCurrent = experience.isCurrent || !experience.endDate;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: "Aldrin Azucena",
      worksFor: { "@type": "Organization", name: experience.company },
      jobTitle: experience.position,
      startDate: experience.startDate,
      endDate: experience.endDate || undefined,
    },
  ],
};

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Journey", href: "/experiences" },
  { label: experience.company },
];
---

<DetailLayout
  title={`${experience.position} | ${experience.company}`}
  description={experience.description as string}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="EXPERIENCE"
  watermarkSize="medium"
  hideWatermarkOnMobile
  maxWidth="5xl"
  hasSidebar={true}
  prevItem={
    prevExperience
      ? { slug: prevExperience.slug, title: prevExperience.position }
      : null
  }
  nextItem={
    nextExperience
      ? { slug: nextExperience.slug, title: nextExperience.position }
      : null
  }
  basePath="/experiences"
  prevLabel="Previous Role"
  nextLabel="Next Role"
  tocSelector="#case-study-content"
>
  <!-- Header slot: company mark, position, meta summary grid -->
  <Fragment slot="header">
    {isCurrent && (
      <span class="rounded-badge border-signal/60 bg-signal-faint micro-label text-signal mb-3 inline-block border px-2 py-0.5">
        ● Current role
      </span>
    )}
    <div class="flex flex-col gap-6 md:flex-row md:items-start">
      <div
        class:list={[
          "rounded-card border-rule flex size-16 shrink-0 items-center justify-center overflow-hidden border font-mono text-lg",
          experience.companyLogo?.url
            ? "bg-(--logo-plate)"
            : "bg-state text-signal",
        ]}
      >
        {experience.companyLogo?.url ? (
          <img
            src={experience.companyLogo.url}
            alt={experience.company}
            class="h-full w-full object-contain p-2"
          />
        ) : (
          <span aria-hidden="true">
            {getCompanyInitials(experience.company)}
          </span>
        )}
      </div>
      <div class="flex-1 space-y-2">
        <!-- prettier-ignore -->
        <h1 class="text-foreground text-4xl leading-none font-bold tracking-[-0.02em] md:text-[48px] md:leading-[normal]">{experience.position}<span class="text-signal">.</span></h1>
        <div class="text-signal text-xl tracking-tight">
          {experience.company}
        </div>
      </div>
    </div>

    <!-- Meta Summary Grid -->
    <dl class="bg-panel border-rule rounded-card mt-10 grid grid-cols-2 border md:grid-cols-4">
      {[
        {
          label: "Duration",
          value: calculateDuration(
            experience.startDate,
            experience.endDate,
            !experience.endDate,
          ),
          icon: Calendar,
        },
        { label: "Location", value: experience.location, icon: Location },
        {
          label: "Engagement",
          value: experience.employmentType,
          icon: Briefcase,
        },
        { label: "Environment", value: experience.workMode, icon: Globe },
      ].map((stat) => (
        <div class="border-rule p-panel flex flex-col gap-1 border-r last:border-r-0 max-md:nth-[2n]:border-r-0">
          <dt class="micro-label text-muted-foreground flex items-center gap-1.5">
            <stat.icon size={12} aria-hidden="true" />
            {stat.label}
          </dt>
          <dd
            class:list={[
              "font-mono text-sm",
              stat.value ? "text-foreground" : "text-muted-foreground",
            ]}
          >
            {stat.value || "—"}
          </dd>
        </div>
      ))}
    </dl>
  </Fragment>

  <!-- Content slot: overview, impact, responsibilities, projects -->
  <Fragment slot="content">
    <!-- Overview -->
    <section id="overview" class="space-y-6">
      <h2 class="text-foreground text-2xl font-semibold tracking-tight">
        Mission Overview
      </h2>
      <article class="prose prose-lg dark:prose-invert prose-p:leading-relaxed max-w-none">
        <MarkdownRenderer content={experience.description as string} />
      </article>
    </section>

    <!-- Impact -->
    {extractedMetrics.length > 0 && (
      <section id="impact" class="space-y-4">
        <h2 class="micro-label text-muted-foreground">CORE IMPACT</h2>
        <PanelBox
          label="IMPACT"
          meta={`${extractedMetrics.length} ${extractedMetrics.length === 1 ? "OUTCOME" : "OUTCOMES"}`}
        >
          <ul class="flex flex-col">
            {extractedMetrics.map((metric) => (
              <li class="border-rule flex items-baseline gap-5 border-b py-3 last:border-b-0">
                <span class="text-signal w-16 shrink-0 font-mono text-lg">
                  {metric!.value}
                </span>
                {metric!.icon && (
                  <span class="text-signal shrink-0 self-center">
                    <IconRenderer client:only="react" icon={metric!.icon} />
                  </span>
                )}
                <span class="flex flex-col gap-1">
                  <span class="text-foreground text-sm">{metric!.label}</span>
                  {metric!.description && (
                    <span class="text-muted-foreground text-xs leading-relaxed">
                      {metric!.description}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </PanelBox>
      </section>
    )}

    <!-- Responsibilities -->
    {experience.responsibilities && (
      <section id="responsibilities" class="space-y-4">
        <h2 class="micro-label text-muted-foreground">
          ARCHITECTURE // RESPONSIBILITIES
        </h2>
        <PanelBox label="RESPONSIBILITIES">
          <div class="prose prose-md dark:prose-invert max-w-none">
            <BlocksRenderer
              content={
                experience.responsibilities as import("@strapi/blocks-react-renderer").BlocksContent
              }
              blocks={defaultBlockRenderers}
            />
          </div>
        </PanelBox>
      </section>
    )}

    <!-- Projects -->
    {experience.projects && experience.projects.length > 0 && (
      <section id="projects" class="space-y-4">
        <h2 class="micro-label text-muted-foreground">FEATURED // WORK</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {experience.projects.map((project) => (
            <a
              href={`/projects/${project.slug}`}
              class="group bg-panel border-rule rounded-card hover:border-signal focus-visible:outline-signal p-panel flex h-full flex-col gap-2 border transition-[border-color] focus-visible:outline-1"
            >
              <h3 class="text-foreground text-base font-semibold">
                {project.title}
              </h3>
              <p class="text-muted-foreground line-clamp-2 flex-grow text-sm">
                {project.shortDescription}
              </p>
              <div class="micro-label text-signal flex items-center gap-1.5">
                View Study
                <ArrowRight size={12} aria-hidden="true" />
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </Fragment>

  <!-- Sidebar slot: tech distribution, company info, related links -->
  <Fragment slot="sidebar">
    <PanelBox label="TECHNOLOGY // DNA">
      {experience.skills && experience.skills.length > 0 ? (
        <TechStackDistribution skills={experience.skills} client:visible />
      ) : (
        <p class="text-muted-foreground text-xs">
          Focus distribution appears once the role has skills logged in the CMS.
        </p>
      )}
    </PanelBox>

    {[
      experience.industry,
      experience.companySize,
      experience.companyWebsite,
      experience.companyLinkedIn,
    ].some(Boolean) && (
      <PanelBox label="THE // ORGANIZATION">
        <dl class="flex flex-col gap-3">
          {[
            { label: "Industry", value: experience.industry },
            { label: "Company Size", value: experience.companySize },
            {
              label: "Website",
              value: experience.companyWebsite,
              isLink: true,
            },
            {
              label: "LinkedIn",
              value: experience.companyLinkedIn,
              isLink: true,
            },
          ].map(
            (item) =>
              item.value && (
                <div class="flex items-center justify-between gap-3">
                  <dt class="micro-label text-muted-foreground">
                    {item.label}
                  </dt>
                  <dd class="text-foreground min-w-0 text-right font-mono text-xs capitalize">
                    {item.isLink ? (
                      <a
                        href={item.value}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-signal focus-visible:outline-signal inline-flex max-w-full items-center gap-1.5 truncate normal-case hover:underline focus-visible:outline-1"
                      >
                        {new URL(item.value).hostname}
                        <ArrowRight size={12} aria-hidden="true" />
                      </a>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ),
          )}
        </dl>
      </PanelBox>
    )}

    <RelatedLinks links={experience.relatedLinks} />
  </Fragment>
</DetailLayout>
