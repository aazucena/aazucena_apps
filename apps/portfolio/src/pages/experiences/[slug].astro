---
import {
  ArrowRight,
  Briefcase,
  Calendar,
  Globe,
  Location,
} from "@aazucena/icons";
import { BlocksRenderer } from "@strapi/blocks-react-renderer";
import { defaultBlockRenderers } from "~/components/blocks/BlockRenderers";
import { MarkdownRenderer } from "~/components/blocks/MarkdownRenderer";
import { MetricCard } from "~/components/ui/MetricCard";
import { RelatedLinks } from "~/components/ui/RelatedLinks";
import { TechStackDistribution } from "~/components/ui/TechStackDistribution";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getExperiences } from "~/lib/api/experiences";
import {
  calculateDuration,
  getCompanyInitials,
  getCompanyLogoGradient,
} from "@aazucena/utils";

// Generate static paths for all experiences and pass data via props
export async function getStaticPaths() {
  try {
    const experiences = await getExperiences();

    return experiences.map((experience, index) => {
      const nextExperience = index > 0 ? experiences[index - 1] : null;
      const prevExperience =
        index < experiences.length - 1 ? experiences[index + 1] : null;

      return {
        params: { slug: experience.slug },
        props: {
          experience,
          nextExperience,
          prevExperience,
        },
      };
    });
  } catch (error) {
    console.error("Error generating experience paths:", error);
    return [];
  }
}

const { experience, nextExperience, prevExperience } = Astro.props;

if (!experience) {
  return Astro.redirect("/404");
}

// Extract Impact Metrics
const extractedMetrics = (experience.achievements || [])
  .filter((achievement) =>
    /([$+]?[\d\.,]+(?:%|\+|x|k|M|B)?)/.test(achievement.title),
  )
  .map((achievement) => {
    const match = achievement.title.match(/([$+]?[\d\.,]+(?:%|\+|x|k|M|B)?)/);
    if (!match) return null;
    const value = match[0];
    let label = achievement.title.replace(value, "").trim();
    label = label.replace(
      /^(increase(d)?|decrease(d)?|reduction|growth|boost(ed)?)(\s+(by|in|of))?\s*/i,
      "",
    );
    if (label.length < 2) label = achievement.title;

    return {
      value,
      label,
      description: achievement.description,
      icon: achievement.icon,
    };
  })
  .filter(Boolean)
  .slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: "Aldrin Azucena",
      worksFor: { "@type": "Organization", name: experience.company },
      jobTitle: experience.position,
      startDate: experience.startDate,
      endDate: experience.endDate || undefined,
    },
  ],
};

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Journey", href: "/experiences" },
  { label: experience.company },
];
---

<DetailLayout
  title={`${experience.position} | ${experience.company}`}
  description={experience.description}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText="EXPERIENCE"
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  prevItem={nextExperience
    ? { slug: nextExperience.slug, title: nextExperience.position }
    : null}
  nextItem={prevExperience
    ? { slug: prevExperience.slug, title: prevExperience.position }
    : null}
  basePath="/experiences"
  prevLabel="Next Role"
  nextLabel="Previous Role"
  tocSelector="#case-study-content"
>
  <!-- Header slot: company logo, position, meta summary grid -->
  <Fragment slot="header">
    <div class="flex flex-col gap-8 md:flex-row md:items-start">
      <div
        class={`flex-shrink-0 w-24 h-24 rounded-[2rem] bg-gradient-to-br ${getCompanyLogoGradient(experience.company)} flex items-center justify-center text-white font-black text-3xl shadow-2xl overflow-hidden`}
      >
        {
          experience.companyLogo?.url ? (
            <img
              src={experience.companyLogo.url}
              alt={experience.company}
              class="h-full w-full object-cover"
            />
          ) : (
            getCompanyInitials(experience.company)
          )
        }
      </div>
      <div class="flex-1 space-y-4 text-center md:text-left">
        <h1
          class="text-4xl leading-none font-black tracking-tighter text-gray-900 md:text-6xl dark:text-white"
        >
          {experience.position}<span class="text-blue-600">.</span>
        </h1>
        <div
          class="text-2xl font-bold tracking-tight text-blue-600 dark:text-blue-400"
        >
          {experience.company}
        </div>
      </div>
    </div>

    <!-- Meta Summary Grid -->
    <div
      class="mt-12 grid grid-cols-2 gap-6 rounded-[2rem] border border-gray-100 bg-gray-50 p-8 md:grid-cols-4 dark:border-gray-800 dark:bg-gray-900/50"
    >
      {
        [
          {
            label: "Duration",
            value: calculateDuration(
              experience.startDate,
              experience.endDate,
              !experience.endDate,
            ),
            icon: Calendar,
          },
          { label: "Location", value: experience.location, icon: Location },
          {
            label: "Engagement",
            value: experience.employmentType,
            icon: Briefcase,
          },
          { label: "Environment", value: experience.workMode, icon: Globe },
        ].map((stat) => (
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-[9px] font-black tracking-widest text-gray-400 uppercase">
              <stat.icon size={12} className="text-blue-500" />
              {stat.label}
            </div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              {stat.value}
            </div>
          </div>
        ))
      }
    </div>
  </Fragment>

  <!-- Content slot: overview, impact, responsibilities, projects -->
  <Fragment slot="content">
    <!-- Overview -->
    <section id="overview" class="space-y-8">
      <h2
        class="text-3xl font-black tracking-tighter text-gray-900 dark:text-white"
      >
        Mission Overview
      </h2>
      <article
        class="prose prose-lg dark:prose-invert prose-p:leading-relaxed max-w-none"
      >
        <MarkdownRenderer content={experience.description} />
      </article>
    </section>

    <!-- Impact -->
    {
      extractedMetrics.length > 0 && (
        <section id="impact" class="space-y-10">
          <h2 class="text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white">
            Core Impact
          </h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {extractedMetrics.map((metric) => (
              <MetricCard client:visible {...metric} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Responsibilities -->
    {
      experience.responsibilities && (
        <section id="responsibilities" class="space-y-10">
          <h2 class="text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white">
            Architecture & Responsibilities
          </h2>
          <div class="prose prose-md dark:prose-invert max-w-none rounded-[2.5rem] border border-gray-100 bg-gray-50 p-10 dark:border-gray-800 dark:bg-gray-900/30">
            <BlocksRenderer
              content={experience.responsibilities}
              blocks={defaultBlockRenderers}
            />
          </div>
        </section>
      )
    }

    <!-- Projects -->
    {
      experience.projects && experience.projects.length > 0 && (
        <section id="projects" class="space-y-10">
          <div class="flex items-center gap-4">
            <h2 class="text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white">
              Featured Work
            </h2>
            <div class="h-px flex-grow bg-gray-100 dark:bg-gray-800" />
          </div>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {experience.projects.map((project) => (
              <a
                href={`/projects/${project.slug}`}
                class="group flex h-full flex-col rounded-[2rem] border border-gray-100 bg-white p-8 transition-all duration-500 hover:border-blue-500/20 hover:shadow-2xl dark:border-gray-800 dark:bg-gray-900"
              >
                <h3 class="mb-2 text-xl font-bold text-gray-900 transition-colors group-hover:text-blue-600 dark:text-white">
                  {project.title}
                </h3>
                <p class="mb-6 line-clamp-2 flex-grow text-sm text-gray-500 dark:text-gray-400">
                  {project.shortDescription}
                </p>
                <div class="flex items-center gap-2 text-xs font-black tracking-widest text-blue-600 uppercase dark:text-blue-400">
                  View Study{" "}
                  <ArrowRight
                    size={14}
                    className="group-hover:translate-x-1 transition-transform"
                  />
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </Fragment>

  <!-- Sidebar slot: tech distribution, company info, related links -->
  <Fragment slot="sidebar">
    <!-- Tech Distribution -->
    <div
      class="space-y-8 rounded-[2rem] border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Technology DNA
      </h2>
      <TechStackDistribution skills={experience.skills} client:visible />
    </div>

    <!-- Company Info -->
    <div
      class="space-y-8 rounded-[2rem] border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        The Organization
      </h2>
      <div class="space-y-6">
        {
          [
            { label: "Industry", value: experience.industry },
            { label: "Company Size", value: experience.companySize },
            {
              label: "Website",
              value: experience.companyWebsite,
              isLink: true,
            },
            {
              label: "LinkedIn",
              value: experience.companyLinkedIn,
              isLink: true,
            },
          ].map(
            (item) =>
              item.value && (
                <div>
                  <div class="mb-1 text-[9px] font-black tracking-widest text-gray-400 uppercase">
                    {item.label}
                  </div>
                  {item.isLink ? (
                    <a
                      href={item.value}
                      target="_blank"
                      class="flex items-center gap-1.5 truncate text-sm font-bold text-blue-600 hover:underline"
                    >
                      {new URL(item.value).hostname} <ArrowRight size={12} />
                    </a>
                  ) : (
                    <div class="text-sm font-bold text-gray-900 capitalize dark:text-white">
                      {item.value}
                    </div>
                  )}
                </div>
              ),
          )
        }
      </div>
    </div>

    <RelatedLinks links={experience.relatedLinks} />
  </Fragment>
</DetailLayout>
