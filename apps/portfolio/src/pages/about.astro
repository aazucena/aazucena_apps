---
/**
 * About page - displays personal biography, focus areas, interests, and education.
 * Dynamic content is fetched from Strapi CMS.
 */
import {
BookOpen,
Download,
Globe,
LayersOne as Layers,
Location,
SmileSquare,
Wrench,
} from '@mynaui/icons-react';
import { BlocksRenderer } from '@strapi/blocks-react-renderer';
import { defaultBlockRenderers } from '~/components/blocks/BlockRenderers';
import { IconRenderer } from '~/components/blocks/IconRenderer';
import { MarkdownRenderer } from '~/components/blocks/MarkdownRenderer';
import { EducationItem } from '~/components/ui/EducationItem';
import { WorkingStyleSection } from '~/components/ui/WorkingStyleSection';
import DetailLayout from '~/layouts/DetailLayout.astro';
import { getAbout } from '~/lib/api/about';
import { fetchEducation } from '~/lib/api/education';
import { getPortfolio } from '~/lib/api/portfolio';
import { getColorClass, getGradientClass } from '~/lib/utils/about';
import { getAvailabilityIndicator } from '~/lib/utils/availability';
import type { InterestItem, Language, MasteryItem, RootItem, WorkflowTool } from '~/types/about';

// Fetch data in parallel
let about = null;
let portfolio = null;
let education = [];

try {
  [about, portfolio, education] = await Promise.all([
    getAbout(),
    getPortfolio(),
    fetchEducation()
  ]);
} catch (error) {
  console.error('Error fetching data for about page:', error);
  return Astro.redirect('/404');
}

if (!about || !portfolio) {
  return Astro.redirect('/404');
}

const pageTitle = `About | ${portfolio.fullName}`;
const pageDescription = about.tagline;

// Get dynamic indicator styles
const statusIndicator = getAvailabilityIndicator(portfolio.availabilityStatus);

// Sort education by start date descending
const sortedEducation = [...education].sort((a, b) => {
  return new Date(b.startDate).getTime() - new Date(a.startDate).getTime();
});

// Map CMS data using utility helpers
const mastery: MasteryItem[] = (about.focusAreas || []).map(item => ({
  name: item.title,
  exp: item.experience,
  description: item.description,
  color: getGradientClass(item.variant)
}));

const roots: RootItem[] = (about.roots || []).map(item => ({
  title: item.title,
  desc: item.description,
  icon: item.icon,
}));

const interests: InterestItem[] = (about.interests || []).map(item => ({
  title: item.title,
  desc: item.description,
  icon: item.icon,
  color: getColorClass(item.variant)
}));

const workflow: WorkflowTool[] = (about.workflow || []).map(item => ({
  name: item.name,
  detail: item.detail
}));

const languages: Language[] = (about.languages || []).map(item => ({
  name: item.name,
  level: item.level
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "mainEntity": {
    "@type": "Person",
    "name": portfolio.fullName,
    "jobTitle": portfolio.occupation,
    "description": about.tagline
  }
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About' }
];
const [ firstName, /*lastName*/ ] = portfolio.fullName.split(' ');
---

<DetailLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText={portfolio.fullName}
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  basePath="/"
>
  <!-- Hero Section Slot -->
  <div slot="header" class="flex flex-col md:flex-row items-center md:items-start gap-12">
    <!-- Profile Image -->
    {portfolio.profileImage?.url && (
      <div class="flex-shrink-0 relative group">
        <div class="absolute inset-0 bg-gradient-to-tr from-blue-600 to-purple-600 rounded-3xl blur-2xl opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
        <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-3xl overflow-hidden border-2 border-white dark:border-gray-800 shadow-2xl">
          <img
            src={portfolio.profileImage.url}
            alt={portfolio.fullName}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
        </div>
      </div>
    )}
    
    <div class="flex-1 text-center md:text-left space-y-6">
      <div>
        <h1 class="text-5xl md:text-7xl font-black text-gray-900 dark:text-white tracking-tighter leading-none mb-4">
          Hi, I'm <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">{firstName}</span>.
        </h1>
        <p class="text-2xl md:text-3xl font-bold text-gray-400 dark:text-gray-500 tracking-tight">
          {portfolio.occupation}
        </p>
      </div>
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium max-w-2xl leading-relaxed">
        {about.tagline}
      </p>
    </div>
  </div>

  <!-- Main Narrative Content Slot -->
  <Fragment slot="content">
    <!-- 1. Biography -->
    <section id="biography" class="relative">
      <h2 class="text-3xl font-black text-gray-900 dark:text-white mb-8 tracking-tight">
        The Story So Far
      </h2>
      <article class="prose prose-lg dark:prose-invert max-w-none prose-p:leading-relaxed prose-headings:font-black">
        {portfolio.bio ? (
          <MarkdownRenderer content={portfolio.bio} />
        ) : (
          <BlocksRenderer content={about.descriptions} blocks={defaultBlockRenderers} />
        )}
      </article>
    </section>

    <!-- 1.5 Narrative Roots (The Origins) -->
    <section id="roots" class="space-y-10">
      <h2 class="text-xs font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em]">
        Narrative Roots
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {roots.map((root) => (
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-gray-900 flex items-center justify-center text-gray-400 dark:text-gray-600 border border-gray-100 dark:border-gray-800">
              <IconRenderer icon={root.icon} client:load />
            </div>
            <div>
              <h3 class="font-bold text-gray-900 dark:text-white text-sm mb-1">{root.title}</h3>
              <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{root.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Core Competencies -->
    <section id="mastery" class="space-y-12">
      <h2 class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-[0.2em] flex items-center gap-3">
        <Layers size={24} className="text-blue-600" />
        Focus Areas
      </h2>
      <div class="grid grid-cols-1 gap-6">
        {mastery.map((item) => (
          <div class="p-8 rounded-3xl bg-gray-50/50 dark:bg-gray-900/30 border border-gray-100 dark:border-gray-800 flex flex-col md:flex-row gap-8 items-start hover:border-blue-500/20 transition-all group">
            <div class="flex-shrink-0">
              <div class={`w-16 h-1 bg-gradient-to-r ${item.color} rounded-full mb-4`}></div>
              <div class="text-2xl font-black text-gray-900 dark:text-white">{item.exp}</div>
              <div class="text-[10px] font-black uppercase tracking-widest text-gray-400">Experience</div>
            </div>
            <div class="space-y-3">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{item.name}</h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Working Style -->
    <section id="working-style" class="space-y-12">
      <h2 class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-[0.2em]">
        How I Think
      </h2>
      <WorkingStyleSection client:only="react" workingStyle={about.workingStyle} />
    </section>

    <!-- 4. Beyond the Screen -->
    <section id="interests" class="space-y-10">
      <h2 class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-[0.2em] flex items-center gap-3">
        <SmileSquare size={24} className="text-orange-500" />
        Beyond the Screen
      </h2>
      <div class="prose prose-lg dark:prose-invert max-w-none bg-gray-50/50 dark:bg-gray-900/30 p-8 rounded-3xl border border-gray-100 dark:border-gray-800">
        <p>
          My creative life often feels like it's coming full circle. I'm finding that my fascination with <strong>emergent systems</strong> and <strong>expressive rules</strong> translates perfectly between the keyboard and the soundboard.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8 not-prose">
          {interests.map(interest => (
            <div class="p-6 rounded-2xl bg-white dark:bg-gray-950 border border-gray-100 dark:border-gray-800 space-y-4">
              <div class={`w-10 h-10 rounded-xl flex items-center justify-center ${interest.color}`}>
                <IconRenderer icon={interest.icon} client:load />
              </div>
              <div>
                <h3 class="font-bold text-gray-900 dark:text-white text-sm mb-1">{interest.title}</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{interest.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Education -->
    {sortedEducation && sortedEducation.length > 0 && (
      <section id="education" class="space-y-10">
        <h2 class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-[0.2em] flex items-center gap-3">
          <BookOpen size={24} className="text-blue-600" />
          Academic Background
        </h2>
        <div class="space-y-12 px-3">
          {sortedEducation.map((edu) => (
            <EducationItem edu={edu} client:visible />
          ))}
        </div>
      </section>
    )}
  </Fragment>

  <!-- Sidebar Slot -->
  <Fragment slot="sidebar">
    <!-- CV Action -->
    <div class="bg-gray-900 dark:bg-white rounded-3xl p-8 text-white dark:text-gray-900 shadow-2xl relative overflow-hidden group">
      <div class="absolute top-0 right-0 p-4 opacity-10 rotate-12 group-hover:rotate-0 transition-transform duration-700">
        <Download size={80} />
      </div>
      <h3 class="text-xl font-bold mb-4 relative z-10">Curriculum Vitae</h3>
      <p class="text-gray-400 dark:text-gray-500 text-sm mb-8 leading-relaxed relative z-10">
        Need a copy for your records? Grab the full technical breakdown here.
      </p>
      {portfolio.resumeUrl && (
        <a
          href={portfolio.resumeUrl}
          target="_blank"
          class="flex items-center justify-center gap-3 w-full py-4 bg-blue-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-blue-500 transition-all shadow-lg active:scale-95 relative z-10"
        >
          <Download size={18} />
          Download PDF
        </a>
      )}
    </div>

    <!-- Professional Meta -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 p-8 space-y-8">
      <h2 class="text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em] border-b border-gray-100 dark:border-gray-800 pb-4">
        Vital Stats
      </h2>
      <div class="space-y-6">
        {portfolio.location && (
          <div class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-blue-600 group-hover:scale-110 transition-transform">
              <Location size={20} />
            </div>
            <div>
              <div class="text-[10px] font-black uppercase tracking-wider text-gray-400">Based in</div>
              <div class="text-sm font-bold text-gray-900 dark:text-white">{portfolio.location}</div>
            </div>
          </div>
        )}
        <div class="flex items-center gap-4 group">
          <div class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-gray-900/20 flex items-center justify-center group-hover:scale-110 transition-transform">
            <div class="relative flex h-2 w-2">
              {statusIndicator.pulse && (
                <span class={`animate-ping absolute inline-flex h-full w-full rounded-full ${statusIndicator.color} opacity-75`}></span>
              )}
              <span class={`relative inline-flex rounded-full h-2 w-2 ${statusIndicator.color}`}></span>
            </div>
          </div>
          <div>
            <div class="text-[10px] font-black uppercase tracking-wider text-gray-400">Availability</div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">{portfolio.availabilityStatus}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Professional Workflow -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 p-8 space-y-8">
      <h2 class="text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em] border-b border-gray-100 dark:border-gray-800 pb-4">
        Modern Workflow
      </h2>
      <div class="space-y-6">
        {workflow.map(item => (
          <div class="group">
            <div class="flex items-center justify-between mb-1">
              <div class="text-sm font-bold text-gray-900 dark:text-white">{item.name}</div>
              <Wrench size={14} className="text-gray-300 dark:text-gray-700 group-hover:text-blue-500 transition-colors" />
            </div>
            <div class="text-[10px] text-gray-400 dark:text-gray-500 italic">{item.detail}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Human Languages -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 p-8 space-y-8">
      <h2 class="text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em] border-b border-gray-100 dark:border-gray-800 pb-4">
        Communication
      </h2>
      <div class="space-y-6">
        {languages.map(lang => (
          <div class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-900/20 flex items-center justify-center text-indigo-600 group-hover:scale-110 transition-transform">
              <Globe size={20} />
            </div>
            <div>
              <div class="text-[10px] font-black uppercase tracking-wider text-gray-400">{lang.name}</div>
              <div class="text-sm font-bold text-gray-900 dark:text-white">{lang.level}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Fragment>
</DetailLayout>