---
/**
 * About page - displays personal biography, focus areas, interests, and education.
 * Dynamic content is fetched from Strapi CMS.
 */
import {
  BookOpen,
  Download,
  Globe,
  LayersOne as Layers,
  Location,
  SmileSquare,
  Wrench,
} from "@aazucena/icons";
import { BlocksRenderer } from "@strapi/blocks-react-renderer";
import { defaultBlockRenderers } from "~/components/blocks/BlockRenderers";
import { IconRenderer } from "@aazucena/ui";
import { MarkdownRenderer } from "@aazucena/ui";
import { EducationItem } from "~/components/ui/EducationItem";
import { ServiceTabs } from "~/components/ui/ServiceTabs";
import { WorkingStyleSection } from "~/components/ui/WorkingStyleSection";
import DetailLayout from "~/layouts/DetailLayout.astro";
import { getAbout } from "@aazucena/api";
import { fetchEducation } from "@aazucena/api";
import { getPortfolio } from "@aazucena/api";
import { getServices } from "@aazucena/api";
import { cn } from "@aazucena/utils";
import { getColorClass, getGradientClass } from "@aazucena/utils";
import { getAvailabilityIndicator } from "@aazucena/utils";
import type {
  InterestItem,
  Language,
  MasteryItem,
  RootItem,
  ServicesData,
  WorkflowTool,
} from "@aazucena/types";

// Fetch data in parallel
let about = null;
let portfolio = null;
let education = [];
let servicesData: ServicesData = { services: [] };

try {
  [about, portfolio, education, servicesData] = await Promise.all([
    getAbout(),
    getPortfolio(),
    fetchEducation(),
    getServices(),
  ]);
} catch (error) {
  console.error("Error fetching data for about page:", error);
  return Astro.redirect("/404");
}

if (!about || !portfolio) {
  return Astro.redirect("/404");
}

const pageTitle = `About | ${portfolio.fullName}`;
const pageDescription = about.tagline;

// Get dynamic indicator styles
const statusIndicator = getAvailabilityIndicator(portfolio.availabilityStatus);

// Sort education by start date descending
const sortedEducation = [...education].sort((a, b) => {
  return new Date(b.startDate).getTime() - new Date(a.startDate).getTime();
});

// Map CMS data using utility helpers
const mastery: MasteryItem[] = (about.focusAreas || []).map((item: any) => ({
  name: item.title,
  exp: item.experience,
  description: item.description,
  color: getGradientClass(item.variant),
}));

const roots: RootItem[] = (about.roots || []).map((item: any) => ({
  title: item.title,
  desc: item.description,
  icon: item.icon,
}));
const interests: InterestItem[] = (about.interests || []).map((item: any) => ({
  title: item.title,
  desc: item.description,
  icon: item.icon,
  color: getColorClass(item.variant),
}));

const workflow: WorkflowTool[] = (about.workflow || []).map((item: any) => ({
  name: item.name,
  detail: item.detail,
}));

const languages: Language[] = (about.languages || []).map((item: any) => ({
  name: item.name,
  level: item.level,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  mainEntity: {
    "@type": "Person",
    name: portfolio.fullName,
    jobTitle: portfolio.occupation,
    description: about.tagline,
  },
};

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "About" }];
const [firstName /*lastName*/] = portfolio.fullName.split(" ");
---

<DetailLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText={portfolio.fullName}
  watermarkSize="medium"
  maxWidth="5xl"
  hasSidebar={true}
  basePath="/"
>
  <!-- Hero Section Slot -->
  <div
    slot="header"
    class="flex flex-col items-center gap-12 md:flex-row md:items-start"
  >
    <!-- Profile Image -->
    {
      portfolio.profileImage?.url && (
        <div class="group relative flex-shrink-0">
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-tr from-blue-600 to-purple-600 opacity-20 blur-2xl transition-opacity duration-500 group-hover:opacity-40" />
          <div class="relative h-48 w-48 overflow-hidden rounded-3xl border-2 border-white shadow-2xl md:h-64 md:w-64 dark:border-gray-800">
            <img
              src={portfolio.profileImage.url}
              alt={portfolio.fullName}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
          </div>
        </div>
      )
    }

    <div
      class={cn(
        "flex-1 text-center md:text-left space-y-6",
        portfolio.profileImage?.url && "my-auto",
      )}
    >
      <div>
        <h1
          class="mb-4 text-5xl leading-none font-black tracking-tighter text-gray-900 md:text-7xl dark:text-white"
        >
          Hi, I'm <span
            class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent"
            >{firstName}</span
          >.
        </h1>
        <p
          class="text-2xl font-bold tracking-tight text-gray-400 md:text-3xl dark:text-gray-500"
        >
          {portfolio.occupation}
        </p>
      </div>
      <p
        class="max-w-2xl text-xl leading-relaxed font-medium text-gray-600 md:text-2xl dark:text-gray-400"
      >
        {about.tagline}
      </p>
    </div>
  </div>

  <!-- Main Narrative Content Slot -->
  <Fragment slot="content">
    <!-- 1. Biography -->
    <section id="biography" class="relative">
      <h2
        class="mb-8 text-3xl font-black tracking-tight text-gray-900 dark:text-white"
      >
        The Story So Far
      </h2>
      <article
        class="prose prose-lg dark:prose-invert prose-p:leading-relaxed prose-headings:font-black max-w-none"
      >
        {
          portfolio.bio ? (
            <MarkdownRenderer content={portfolio.bio as string} />
          ) : (
            <BlocksRenderer
              content={
                about.descriptions as import("@strapi/blocks-react-renderer").BlocksContent
              }
              blocks={defaultBlockRenderers}
            />
          )
        }
      </article>
    </section>

    <!-- 1.5 Narrative Roots (The Origins) -->
    <section id="roots" class="space-y-10">
      <h2
        class="text-xs font-black tracking-[0.3em] text-gray-400 uppercase dark:text-gray-500"
      >
        Narrative Roots
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          roots.map((root) => (
            <div class="space-y-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-gray-100 bg-gray-50 text-gray-400 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-600">
                <IconRenderer client:only="react" icon={root.icon} />
              </div>
              <div>
                <h3 class="mb-1 text-sm font-bold text-gray-900 dark:text-white">
                  {root.title}
                </h3>
                <p class="text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                  {root.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 2. Core Competencies -->
    <section id="mastery" class="space-y-12">
      <h2
        class="flex items-center gap-3 text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white"
      >
        <Layers size={24} className="text-blue-600" />
        Focus Areas
      </h2>
      <div class="grid grid-cols-1 gap-6">
        {
          mastery.map((item) => (
            <div class="group flex flex-col items-start gap-8 rounded-3xl border border-gray-100 bg-gray-50/50 p-8 transition-all hover:border-blue-500/20 md:flex-row dark:border-gray-800 dark:bg-gray-900/30">
              <div class="flex-shrink-0">
                <div
                  class={`h-1 w-16 bg-gradient-to-r ${item.color} mb-4 rounded-full`}
                />
                <div class="text-2xl font-black text-gray-900 dark:text-white">
                  {item.exp}
                </div>
                <div class="text-[10px] font-black tracking-widest text-gray-400 uppercase">
                  Experience
                </div>
              </div>
              <div class="space-y-3">
                <h3 class="text-xl font-bold text-gray-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                  {item.name}
                </h3>
                <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 3. Services -->
    {
      servicesData.services.length > 0 && (
        <section id="services" class="space-y-10">
          <h2 class="flex items-center gap-3 text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white">
            <Wrench size={24} className="text-cyan-600" />
            What I Offer
            <span class="rounded-full bg-cyan-500/10 px-3 py-1 text-sm font-bold tracking-normal text-cyan-600 normal-case dark:bg-cyan-500/20 dark:text-cyan-400">
              {servicesData.services.length} services
            </span>
          </h2>
          <ServiceTabs services={servicesData.services} client:visible />
        </section>
      )
    }

    <!-- 4. Working Style -->
    <section id="working-style" class="space-y-12">
      <h2
        class="text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white"
      >
        How I Think
      </h2>
      <WorkingStyleSection
        client:only="react"
        workingStyle={about.workingStyle}
      />
    </section>

    <!-- 5. Beyond the Screen -->
    <section id="interests" class="space-y-10">
      <h2
        class="flex items-center gap-3 text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white"
      >
        <SmileSquare size={24} className="text-orange-500" />
        Beyond the Screen
      </h2>
      <div
        class="prose prose-lg dark:prose-invert max-w-none rounded-3xl border border-gray-100 bg-gray-50/50 p-8 dark:border-gray-800 dark:bg-gray-900/30"
      >
        <p>
          My creative life often feels like it's coming full circle. I'm finding
          that my fascination with <strong>emergent systems</strong> and <strong
            >expressive rules</strong
          > translates perfectly between the keyboard and the soundboard.
        </p>
        <div class="not-prose mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            interests.map((interest) => (
              <div class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 dark:border-gray-800 dark:bg-gray-950">
                <div
                  class={`flex h-10 w-10 items-center justify-center rounded-xl ${interest.color}`}
                >
                  <IconRenderer client:only="react" icon={interest.icon} />
                </div>
                <div>
                  <h3 class="mb-1 text-sm font-bold text-gray-900 dark:text-white">
                    {interest.title}
                  </h3>
                  <p class="text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                    {interest.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 6. Education -->
    {
      sortedEducation && sortedEducation.length > 0 && (
        <section id="education" class="space-y-10">
          <h2 class="flex items-center gap-3 text-2xl font-black tracking-[0.2em] text-gray-900 uppercase dark:text-white">
            <BookOpen size={24} className="text-blue-600" />
            Academic Background
          </h2>
          <div class="flex flex-col gap-6 px-3">
            {sortedEducation.map((edu) => (
              <EducationItem edu={edu} client:visible />
            ))}
          </div>
        </section>
      )
    }
  </Fragment>

  <!-- Sidebar Slot -->
  <Fragment slot="sidebar">
    <!-- CV Action -->
    <div
      class="group relative overflow-hidden rounded-3xl bg-gray-900 p-8 text-white shadow-2xl dark:bg-white dark:text-gray-900"
    >
      <div
        class="absolute top-0 right-0 rotate-12 p-4 opacity-10 transition-transform duration-700 group-hover:rotate-0"
      >
        <Download size={80} />
      </div>
      <h3 class="relative z-10 mb-4 text-xl font-bold">Curriculum Vitae</h3>
      <p
        class="relative z-10 mb-8 text-sm leading-relaxed text-gray-400 dark:text-gray-500"
      >
        Need a copy for your records? Grab the full technical breakdown here.
      </p>
      {
        portfolio.resumeUrl && (
          <a
            href={portfolio.resumeUrl}
            target="_blank"
            class="relative z-10 flex w-full items-center justify-center gap-3 rounded-2xl bg-blue-600 py-4 text-xs font-black tracking-widest text-white uppercase shadow-lg transition-all hover:bg-blue-500 active:scale-95"
          >
            <Download size={18} />
            Download PDF
          </a>
        )
      }
    </div>

    <!-- Professional Meta -->
    <div
      class="space-y-8 rounded-2xl border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Vital Stats
      </h2>
      <div class="space-y-6">
        {
          portfolio.location && (
            <div class="group flex items-center gap-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition-transform group-hover:scale-110 dark:bg-blue-900/20">
                <Location size={20} />
              </div>
              <div>
                <div class="text-[10px] font-black tracking-wider text-gray-400 uppercase">
                  Based in
                </div>
                <div class="text-sm font-bold text-gray-900 dark:text-white">
                  {portfolio.location}
                </div>
              </div>
            </div>
          )
        }
        <div class="group flex items-center gap-4">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-50 transition-transform group-hover:scale-110 dark:bg-gray-900/20"
          >
            <div class="relative flex h-2 w-2">
              {
                statusIndicator.pulse && (
                  <span
                    class={`absolute inline-flex h-full w-full animate-ping rounded-full ${statusIndicator.color} opacity-75`}
                  />
                )
              }
              <span
                class={`relative inline-flex rounded-full h-2 w-2 ${statusIndicator.color}`}
              ></span>
            </div>
          </div>
          <div>
            <div
              class="text-[10px] font-black tracking-wider text-gray-400 uppercase"
            >
              Availability
            </div>
            <div class="text-sm font-bold text-gray-900 dark:text-white">
              {portfolio.availabilityStatus}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Professional Workflow -->
    <div
      class="space-y-8 rounded-2xl border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Modern Workflow
      </h2>
      <div class="space-y-6">
        {
          workflow.map((item) => (
            <div class="group">
              <div class="mb-1 flex items-center justify-between">
                <div class="text-sm font-bold text-gray-900 dark:text-white">
                  {item.name}
                </div>
                <Wrench
                  size={14}
                  className="text-gray-300 dark:text-gray-700 group-hover:text-blue-500 transition-colors"
                />
              </div>
              <div class="text-[10px] text-gray-400 italic dark:text-gray-500">
                {item.detail}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Human Languages -->
    <div
      class="space-y-8 rounded-2xl border border-gray-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900"
    >
      <h2
        class="border-b border-gray-100 pb-4 text-[10px] font-black tracking-[0.3em] text-gray-400 uppercase dark:border-gray-800 dark:text-gray-500"
      >
        Communication
      </h2>
      <div class="space-y-6">
        {
          languages.map((lang) => (
            <div class="group flex items-center gap-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 transition-transform group-hover:scale-110 dark:bg-indigo-900/20">
                <Globe size={20} />
              </div>
              <div>
                <div class="text-[10px] font-black tracking-wider text-gray-400 uppercase">
                  {lang.name}
                </div>
                <div class="text-sm font-bold text-gray-900 dark:text-white">
                  {lang.level}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Fragment>
</DetailLayout>
