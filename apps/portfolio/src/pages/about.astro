---
/**
 * About page - displays personal biography, focus areas, interests, and education.
 * Dynamic content is fetched from Strapi CMS.
 */
import {
  BookOpen,
  Download,
  Globe,
  LayersOne as Layers,
  Location,
  SmileSquare,
  Wrench,
} from "@aazucena/icons";
import { cmsTone } from "~/lib/utils/cms-tone";
import AvailabilityIndicator from "~/components/common/AvailabilityIndicator.astro";
import { BlocksRenderer } from "@strapi/blocks-react-renderer";
import { defaultBlockRenderers } from "~/components/blocks/BlockRenderers";
import { IconRenderer } from "@aazucena/ui";
import { MarkdownRenderer } from "@aazucena/ui";
import { EducationItem } from "~/components/ui/EducationItem";
import { ServiceTabs } from "~/components/ui/ServiceTabs";
import { WorkingStyleSection } from "~/components/ui/WorkingStyleSection";
import DetailLayout from "~/layouts/DetailLayout.astro";
import PanelBox from "~/components/common/PanelBox.astro";
import { getAbout } from "@aazucena/api";
import { fetchEducation } from "@aazucena/api";
import { getPortfolio } from "@aazucena/api";
import { getServices } from "@aazucena/api";
import { getAvailabilityIndicator } from "@aazucena/utils";
import type {
  Language,
  RootItem,
  ServicesData,
  WorkflowTool,
} from "@aazucena/types";

// Fetch data in parallel
let about = null;
let portfolio = null;
let education = [];
let servicesData: ServicesData = { services: [] };

try {
  [about, portfolio, education, servicesData] = await Promise.all([
    getAbout(),
    getPortfolio(),
    fetchEducation(),
    getServices(),
  ]);
} catch (error) {
  console.error("Error fetching data for about page:", error);
  return Astro.redirect("/404");
}

if (!about || !portfolio) {
  return Astro.redirect("/404");
}

const pageTitle = "About";
const pageDescription = about.tagline;

// Availability: same marker treatment as the Footer (mono line, status tone)
const availability = getAvailabilityIndicator(portfolio.availabilityStatus);

// Sort education by start date descending
const sortedEducation = [...education].sort((a, b) => {
  return new Date(b.startDate).getTime() - new Date(a.startDate).getTime();
});

// Map CMS data using utility helpers
const mastery = (about.focusAreas || []).map((item: any) => ({
  name: item.title,
  exp: item.experience,
  description: item.description,
  tone: cmsTone(item.variant),
}));

const roots: RootItem[] = (about.roots || []).map((item: any) => ({
  title: item.title,
  desc: item.description,
  icon: item.icon,
}));
const interests = (about.interests || []).map((item: any) => ({
  title: item.title,
  desc: item.description,
  icon: item.icon,
  tone: cmsTone(item.variant),
}));

const workflow: WorkflowTool[] = (about.workflow || []).map((item: any) => ({
  name: item.name,
  detail: item.detail,
}));

const languages: Language[] = (about.languages || []).map((item: any) => ({
  name: item.name,
  level: item.level,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  mainEntity: {
    "@type": "Person",
    name: portfolio.fullName,
    jobTitle: portfolio.occupation,
    description: about.tagline,
  },
};

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "About" }];
const [firstName /*lastName*/] = portfolio.fullName.split(" ");
---

<DetailLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText={firstName || portfolio.fullName}
  watermarkSize="medium"
  hideWatermarkOnMobile
  maxWidth="5xl"
  hasSidebar={true}
  basePath="/"
>
  <!-- Hero Section Slot -->
  <div
    slot="header"
    class="flex flex-col items-center gap-8 md:flex-row md:items-start"
  >
    {portfolio.profileImage?.url && (
      <div class="group border-rule-strong rounded-card h-48 w-48 flex-shrink-0 overflow-hidden border md:h-56 md:w-56">
        <img
          src={portfolio.profileImage.url}
          alt={portfolio.fullName}
          class="hover-grow h-full w-full object-cover"
        />
      </div>
    )}

    <div
      class:list={[
        "flex-1 space-y-4 text-center md:text-left",
        portfolio.profileImage?.url && "my-auto",
      ]}
    >
      <h1 class="text-foreground text-5xl leading-none font-bold tracking-[-0.02em] md:text-[56px] md:leading-[1.05]">
        Hi, I'm <span class="text-signal">{firstName}</span>.
      </h1>
      <p class="text-muted-foreground text-2xl font-semibold tracking-tight">
        {portfolio.occupation}
      </p>
      <p class="text-foreground max-w-2xl text-lg leading-relaxed">
        {about.tagline}
      </p>
    </div>
  </div>

  <!-- Main Narrative Content Slot -->
  <Fragment slot="content">
    <!-- 1. Biography -->
    <section id="biography" class="relative">
      <h2 class="text-foreground mb-6 text-2xl font-bold tracking-tight">
        The Story So Far
      </h2>
      <article class="prose prose-lg dark:prose-invert prose-p:leading-relaxed max-w-none">
        {portfolio.bio ? (
          <MarkdownRenderer content={portfolio.bio as string} />
        ) : (
          <BlocksRenderer
            content={
              about.descriptions as import("@strapi/blocks-react-renderer").BlocksContent
            }
            blocks={defaultBlockRenderers}
          />
        )}
      </article>
    </section>

    <!-- 1.5 Narrative Roots (The Origins) -->
    <section id="roots" class="space-y-4">
      <h2
        data-toc-label="Narrative roots"
        class="micro-label text-muted-foreground"
      >
        NARRATIVE // ROOTS
      </h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {roots.map((root) => (
          <PanelBox label={root.title.toUpperCase()}>
            {root.icon && (
              <div class="text-signal">
                <IconRenderer client:only="react" icon={root.icon} />
              </div>
            )}
            <p class="text-muted-foreground text-sm leading-relaxed">
              {root.desc}
            </p>
          </PanelBox>
        ))}
      </div>
    </section>

    <!-- 2. Core Competencies -->
    <section id="mastery" class="space-y-4">
      <h2
        data-toc-label="Focus areas"
        class="micro-label text-muted-foreground flex items-center gap-2"
      >
        <Layers size={14} aria-hidden="true" />
        FOCUS // AREAS
      </h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {mastery.map((item) => (
          <PanelBox label="EXPERIENCE" class="group">
            <div
              class="text-signal text-3xl font-light"
              style={item.tone ? `color: ${item.tone}` : undefined}
            >
              {item.exp}
            </div>
            <h3 class="text-foreground group-hover:text-signal text-base font-semibold motion-safe:transition-[color]">
              {item.name}
            </h3>
            <p class="text-muted-foreground text-xs leading-relaxed">
              {item.description}
            </p>
          </PanelBox>
        ))}
      </div>
    </section>

    <!-- 3. Services -->
    {servicesData.services.length > 0 && (
      <section id="services" class="space-y-4">
        <h2
          data-toc-label="WHAT I OFFER"
          class="micro-label text-muted-foreground flex items-center gap-3"
        >
          <span class="flex items-center gap-2">
            <Wrench size={14} aria-hidden="true" />
            WHAT I OFFER
          </span>
          <span class="text-signal">
            ● {servicesData.services.length} SERVICES
          </span>
        </h2>
        <ServiceTabs services={servicesData.services} client:visible />
      </section>
    )}

    <!-- 4. Working Style -->
    <section id="working-style" class="space-y-4">
      <h2 class="micro-label text-muted-foreground">HOW I THINK</h2>
      <WorkingStyleSection
        client:only="react"
        workingStyle={about.workingStyle}
      />
    </section>

    <!-- 5. Beyond the Screen -->
    <section id="interests" class="space-y-4">
      <h2 class="micro-label text-muted-foreground flex items-center gap-2">
        <SmileSquare size={14} aria-hidden="true" />
        BEYOND // THE SCREEN
      </h2>
      <PanelBox label="INTERESTS">
        <p class="text-foreground text-sm leading-relaxed">
          My creative life often feels like it's coming full circle. I'm finding
          that my fascination with <strong>emergent systems</strong> and{" "}
          <strong>expressive rules</strong> translates perfectly between the
          keyboard and the soundboard.
        </p>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {interests.map((interest) => (
            <div class="border-rule rounded-card flex flex-col gap-2 border p-4">
              <div
                class="text-signal"
                style={interest.tone ? `color: ${interest.tone}` : undefined}
              >
                <IconRenderer client:only="react" icon={interest.icon} />
              </div>
              <h3 class="text-foreground text-sm font-semibold">
                {interest.title}
              </h3>
              <p class="text-muted-foreground text-xs leading-relaxed">
                {interest.desc}
              </p>
            </div>
          ))}
        </div>
      </PanelBox>
    </section>

    <!-- 6. Education -->
    {sortedEducation && sortedEducation.length > 0 && (
      <section id="education" class="space-y-4">
        <h2 class="micro-label text-muted-foreground flex items-center gap-2">
          <BookOpen size={14} aria-hidden="true" />
          ACADEMIC // BACKGROUND
        </h2>
        <div class="flex flex-col gap-4">
          {sortedEducation.map((edu) => (
            <EducationItem edu={edu} client:visible />
          ))}
        </div>
      </section>
    )}
  </Fragment>

  <!-- Sidebar Slot -->
  <Fragment slot="sidebar">
    <!-- CV Action -->
    <PanelBox
      label="RESUME // DOWNLOAD"
      meta="PDF"
      class="group linked-card relative overflow-hidden"
    >
      <span
        class="hover-spin text-rule pointer-events-none absolute top-12 right-3 rotate-12 [--spin:0deg]"
        aria-hidden="true"
      >
        <Download size={48} />
      </span>
      <h3 class="text-foreground pr-16 text-lg font-semibold">
        Curriculum Vitae
      </h3>
      <p class="text-muted-foreground mb-3 pr-16 text-sm leading-relaxed">
        Need a copy for your records? Grab the full technical breakdown here.
      </p>
      {portfolio.resumeUrl && (
        <a
          href={portfolio.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="press bg-signal text-signal-foreground h-control rounded-control hover:bg-signal/90 focus-visible:outline-signal flex w-full items-center justify-center gap-2 px-4 text-sm font-medium transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
        >
          <Download size={16} />
          Download PDF
        </a>
      )}
    </PanelBox>

    <!-- Professional Meta -->
    <PanelBox label="VITAL // STATS">
      {/* Tile on the left, label above value, as on main: the sidebar is too narrow to put a
          location like "Alberta, Canada" beside its label. The tile sits inside the dt so the
          list stays valid HTML. */}
      <dl class="flex flex-col gap-3">
        {portfolio.location && (
          <div class="group relative flex min-h-8 flex-col justify-center pl-10.5">
            <dt class="micro-label text-muted-foreground">
              <span
                class="hover-grow bg-state text-signal rounded-control absolute top-1/2 left-0 flex size-8 -translate-y-1/2 items-center justify-center"
                aria-hidden="true"
              >
                <Location size={16} />
              </span>
              BASED IN
            </dt>
            <dd class="text-foreground font-mono text-sm">
              {portfolio.location}
            </dd>
          </div>
        )}
        <div class="group relative flex min-h-8 flex-col justify-center pl-10.5">
          <dt class="micro-label text-muted-foreground">
            <span
              class="hover-grow bg-state rounded-control absolute top-1/2 left-0 flex size-8 -translate-y-1/2 items-center justify-center"
              aria-hidden="true"
            >
              <AvailabilityIndicator
                tone={availability.tone}
                marker={availability.marker}
                pulse={availability.pulse}
              />
            </span>
            AVAILABILITY
          </dt>
          <dd class="text-foreground font-mono text-sm">
            {portfolio.availabilityStatus}
          </dd>
        </div>
      </dl>
    </PanelBox>

    <!-- Professional Workflow -->
    {workflow.length > 0 && (
      <PanelBox label="MODERN // WORKFLOW" meta={`${workflow.length} TOOLS`}>
        <ul class="flex flex-col gap-3">
          {workflow.map((item) => (
            <li class="group">
              <div class="text-foreground flex items-center justify-between gap-3 text-sm font-semibold">
                {item.name}
                <Wrench
                  size={14}
                  className="text-muted-foreground group-hover:text-signal motion-safe:transition-[color]"
                  aria-hidden="true"
                />
              </div>
              <div class="text-muted-foreground text-xs">{item.detail}</div>
            </li>
          ))}
        </ul>
      </PanelBox>
    )}

    <!-- Human Languages -->
    {languages.length > 0 && (
      <PanelBox label="COMMUNICATION">
        <dl class="flex flex-col gap-3">
          {languages.map((lang) => (
            <div class="group flex items-center justify-between gap-3">
              <dt class="micro-label text-muted-foreground flex shrink-0 items-center gap-2.5 whitespace-nowrap">
                <span
                  class="hover-grow bg-state text-signal rounded-control flex size-8 shrink-0 items-center justify-center"
                  aria-hidden="true"
                >
                  <Globe size={16} />
                </span>
                {lang.name}
              </dt>
              <dd class="text-foreground min-w-0 text-right font-mono text-sm">
                {lang.level}
              </dd>
            </div>
          ))}
        </dl>
      </PanelBox>
    )}
  </Fragment>
</DetailLayout>
