---
import { MarkdownRenderer } from '~/components/blocks/MarkdownRenderer';
import { TableOfContents } from '~/components/ui/TableOfContents';
import PageLayout from '~/layouts/PageLayout.astro';
import { getPages } from '~/lib/api/pages';

/**
 * Generate static paths for all CMS-driven pages
 */
export async function getStaticPaths() {
  const pages = await getPages();
  
  // Filter out any pages that might conflict with reserved static routes
  const reservedSlugs = ['projects', 'blog', 'experiences', 'about', 'contact', 'skills', 'journey', 'maintenance'];
  const filteredPages = pages.filter(p => !reservedSlugs.includes(p.slug));

  return filteredPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

if (!page) {
  return Astro.redirect('/404');
}

const seoTitle = page.seo?.metaTitle || page.title;
const seoDescription = page.seo?.metaDescription;

const siteOrigin = "https://aazucena.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": page.title,
      "description": seoDescription,
      "url": `${siteOrigin}/${page.slug}`,
      "dateModified": page.lastUpdated
    }
  ]
};
---

<PageLayout title={seoTitle} description={seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="min-h-screen bg-white dark:bg-gray-950">
    <div class="h-1 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 print:hidden" aria-hidden="true"></div>

    <!-- Editorial Header -->
    <header class={`bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 relative overflow-hidden ${page.template === 'landing' ? 'py-24 md:py-40' : 'py-20 md:py-32'}`}>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <h1 class="text-5xl md:text-8xl font-black text-gray-900 dark:text-white tracking-tighter mb-8 leading-none">
          {page.title}<span class="text-blue-600">.</span>
        </h1>
        
        {page.template === 'legal' && (
          <div class="inline-flex items-center gap-3 px-4 py-2 bg-gray-50 dark:bg-gray-800/50 rounded-full border border-gray-100 dark:border-gray-800 shadow-sm">
            <div class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">
              Revised: {new Date(page.lastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
          </div>
        )}
      </div>

      <!-- Background Watermark -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none opacity-[0.02] dark:opacity-[0.05] whitespace-nowrap z-0">
        <span class="text-[15rem] md:text-[25rem] font-black uppercase tracking-tighter italic">
          {page.slug.split('-')[0]}
        </span>
      </div>
    </header>

    {page.showTableOfContents && <TableOfContents containerSelector="#dynamic-content" client:idle />}

    <!-- Page Content -->
    <div class={`max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 ${page.template === 'landing' ? 'py-0' : 'py-20 md:py-32'}`}>
      <article id="dynamic-content" class="prose prose-lg dark:prose-invert max-w-none prose-p:leading-relaxed prose-headings:font-black prose-a:text-blue-600 print:prose-sm">
        <MarkdownRenderer content={page.content} />
      </article>

      <!-- Editorial Navigation Footer -->
      {page.template === 'legal' && (
        <div class="mt-20 pt-12 border-t border-gray-100 dark:border-gray-900 flex justify-center">
          <a 
            href="/" 
            class="group flex items-center gap-3 text-xs font-black uppercase tracking-[0.3em] text-gray-400 hover:text-blue-600 transition-all"
          >
            <div class="w-8 h-8 rounded-full bg-gray-50 dark:bg-gray-900 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </div>
            Back to Home
          </a>
        </div>
      )}
    </div>
  </main>

  <style>
    @media print {
      @page { margin: 1.5cm; }
      nav, footer, .print\:hidden, .absolute { display: none !important; }
      header { background: white !important; padding: 2rem 0 !important; border: none !important; }
      header .z-10 { color: black !important; }
      h1 { color: black !important; font-size: 3rem !important; }
      main { background: white !important; }
      article { color: #1f2937 !important; }
    }
  </style>
</PageLayout>
