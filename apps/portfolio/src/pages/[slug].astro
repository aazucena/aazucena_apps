---
/**
 * Dynamic Page Router
 *
 * This router delegates to specialized template components based on CMS configuration.
 * It handles SEO metadata, breadcrumbs, and JSON-LD computation, then passes clean props
 * to the appropriate template component for rendering.
 *
 * Supported Templates:
 * - legal: Legal documents with revision badges (privacy, terms)
 * - default: Editorial content (articles, documentation)
 * - landing: Marketing pages (campaigns, product launches)
 *
 * @route /[slug]
 */

import { getPages } from "@aazucena/api";
import EditorialTemplate from "~/templates/EditorialTemplate.astro";
import LandingTemplate from "~/templates/LandingTemplate.astro";
import LegalTemplate from "~/templates/LegalTemplate.astro";

/**
 * Generate static paths for all CMS-driven pages
 */
export async function getStaticPaths() {
  const pages = await getPages();

  // Filter out reserved static routes to prevent conflicts
  const reservedSlugs = [
    "projects",
    "blog",
    "experiences",
    "about",
    "contact",
    "skills",
    "journey",
    "maintenance",
    "support",
  ];
  const filteredPages = pages.filter((p) => !reservedSlugs.includes(p.slug));

  return filteredPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

// 404 fallback if page doesn't exist
if (!page) {
  return Astro.redirect("/404");
}

// Compute SEO metadata
const seoTitle = page.seo?.title || page.title;
const seoDescription = page.seo?.description!;

// Build JSON-LD schema for SEO
const siteOrigin = "https://aazucena.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: page.title,
      description: seoDescription,
      url: `${siteOrigin}/${page.slug}`,
      dateModified: page.lastUpdated,
    },
  ],
};

// Build breadcrumb navigation
const breadcrumbs = [{ label: "Home", href: "/" }, { label: page.title }];

// Normalize template type (handle unknown templates)
const templateType = ["legal", "default", "landing"].includes(page.template)
  ? page.template
  : "default";

// Warn about unknown templates
if (templateType !== page.template) {
  console.warn(
    `Unknown template: "${page.template}" for page "${page.slug}". Falling back to editorial template.`,
  );
}

// Build shared props for all templates
const sharedProps = {
  title: page.title,
  content: page.content as string,
  seoTitle,
  seoDescription,
  jsonLd,
  breadcrumbs,
  watermarkText: page.slug.split("-")[0]!.toUpperCase(),
  watermarkSize: "small" as const,
  showTableOfContents: page.showTableOfContents,
  tocSelector: "#dynamic-content",
  slug: page.slug,
};
---

<!-- Render the appropriate template component -->{
  templateType === "legal" ? (
    <LegalTemplate {...sharedProps} lastUpdated={page.lastUpdated} />
  ) : templateType === "landing" ? (
    <LandingTemplate {...sharedProps} />
  ) : (
    <EditorialTemplate {...sharedProps} />
  )
}
