---
/**
 * Legal Template
 *
 * Specialized layout for legal documents (privacy policy, terms of service, etc.)
 * with document-specific features and print optimization.
 *
 * Features:
 * - Revision badge with formatted "last updated" date and animated pulse indicator
 * - Back-to-home navigation button
 * - Print-optimized styles (clean headers, hidden navigation)
 * - Prose-styled content with legal document formatting
 *
 * Usage:
 * This template is automatically selected for pages with template='legal' in CMS.
 *
 * @component
 */

import { MarkdownRenderer } from "@aazucena/ui";
import DetailLayout from "~/layouts/DetailLayout.astro";
import type { LegalTemplateProps } from "./index";

interface Props extends LegalTemplateProps {}

const {
  title,
  content,
  seoTitle,
  seoDescription,
  jsonLd,
  breadcrumbs,
  watermarkText,
  watermarkSize = "small",
  showTableOfContents,
  tocSelector = "#dynamic-content",
  lastUpdated,
} = Astro.props;

// Format the last updated date for display
const formattedDate = new Date(lastUpdated).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<DetailLayout
  title={seoTitle}
  description={seoDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText={watermarkText}
  watermarkSize={watermarkSize}
  maxWidth="4xl"
  hasSidebar={false}
  showTableOfContents={showTableOfContents}
  tocSelector={tocSelector}
  basePath="/"
>
  <!-- Legal Header: Title + Revision Badge -->
  <div slot="header" class="space-y-8 text-center">
    <!-- prettier-ignore -->
    <h1 class="text-foreground text-5xl leading-none font-black tracking-tighter md:text-8xl">{title}<span class="text-signal">.</span></h1>

    <!-- Revision Badge with Pulse Indicator -->
    <div class="border-rule bg-panel rounded-control mx-auto inline-flex items-center justify-center gap-3 border px-3 py-1.5">
      <div class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></div>
      <p class="micro-label text-muted-foreground">Revised: {formattedDate}</p>
    </div>
  </div>

  <!-- Legal Content + Back Button -->
  <Fragment slot="content">
    <!-- Prose-styled Article -->
    <article
      id="dynamic-content"
      class="prose prose-lg dark:prose-invert prose-p:leading-relaxed prose-headings:font-black prose-a:text-signal print:prose-sm max-w-none"
    >
      <MarkdownRenderer content={content} />
    </article>

    <!-- Back to Home Button -->
    <div class="border-rule mt-16 flex justify-center border-t pt-8">
      <a
        href="/"
        class="group micro-label text-muted-foreground hover:text-signal focus-visible:outline-signal flex items-center gap-3 transition-colors focus-visible:outline-1 focus-visible:outline-offset-2"
      >
        <div class="bg-panel border-rule rounded-control group-hover:bg-state flex h-8 w-8 items-center justify-center border transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </div>
        Back to Home
      </a>
    </div>
  </Fragment>
</DetailLayout>

<!-- Print Optimization Styles -->
<style>
  @media print {
    /* Page setup */
    @page {
      margin: 1.5cm;
    }

    /* Hide navigation elements */
    nav,
    footer,
    .print\:hidden,
    .absolute {
      display: none !important;
    }

    /* Clean header */
    header {
      background: white !important;
      padding: 2rem 0 !important;
      border: none !important;
    }

    header .z-10 {
      color: black !important;
    }

    h1 {
      color: black !important;
      font-size: 3rem !important;
    }

    /* Clean content */
    main {
      background: white !important;
    }

    article {
      color: black !important;
    }
  }
</style>
