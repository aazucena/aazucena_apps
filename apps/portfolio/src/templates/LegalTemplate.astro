---
/**
 * Legal Template
 *
 * Specialized layout for legal documents (privacy policy, terms of service, etc.)
 * with document-specific features and print optimization.
 *
 * Features:
 * - Revision badge with formatted "last updated" date and animated pulse indicator
 * - Back-to-home navigation button
 * - Print-optimized styles (clean headers, hidden navigation)
 * - Prose-styled content with legal document formatting
 *
 * Usage:
 * This template is automatically selected for pages with template='legal' in CMS.
 *
 * @component
 */

import { MarkdownRenderer } from "~/components/blocks/MarkdownRenderer";
import DetailLayout from "~/layouts/DetailLayout.astro";
import type { LegalTemplateProps } from "./index";

interface Props extends LegalTemplateProps {}

const {
  title,
  content,
  seoTitle,
  seoDescription,
  jsonLd,
  breadcrumbs,
  watermarkText,
  watermarkSize = "small",
  showTableOfContents,
  tocSelector = "#dynamic-content",
  lastUpdated,
} = Astro.props;

// Format the last updated date for display
const formattedDate = new Date(lastUpdated).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<DetailLayout
  title={seoTitle}
  description={seoDescription}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  watermarkText={watermarkText}
  watermarkSize={watermarkSize}
  maxWidth="4xl"
  hasSidebar={false}
  showTableOfContents={showTableOfContents}
  tocSelector={tocSelector}
  basePath="/"
>
  <!-- Legal Header: Title + Revision Badge -->
  <div slot="header" class="space-y-8 text-center">
    <h1
      class="text-5xl leading-none font-black tracking-tighter text-gray-900 md:text-8xl dark:text-white"
    >
      {title}<span class="text-blue-600">.</span>
    </h1>

    <!-- Revision Badge with Pulse Indicator -->
    <div
      class="mx-auto inline-flex items-center justify-center gap-3 rounded-full border border-gray-100 bg-gray-50 px-4 py-2 shadow-sm dark:border-gray-800 dark:bg-gray-800/50"
    >
      <div class="h-1.5 w-1.5 animate-pulse rounded-full bg-blue-500"></div>
      <p
        class="text-[10px] font-black tracking-[0.2em] text-gray-400 uppercase dark:text-gray-500"
      >
        Revised: {formattedDate}
      </p>
    </div>
  </div>

  <!-- Legal Content + Back Button -->
  <Fragment slot="content">
    <!-- Prose-styled Article -->
    <article
      id="dynamic-content"
      class="prose prose-lg dark:prose-invert prose-p:leading-relaxed prose-headings:font-black prose-a:text-blue-600 print:prose-sm max-w-none"
    >
      <MarkdownRenderer content={content} />
    </article>

    <!-- Back to Home Button -->
    <div
      class="mt-20 flex justify-center border-t border-gray-100 pt-12 dark:border-gray-900"
    >
      <a
        href="/"
        class="group flex items-center gap-3 text-xs font-black tracking-[0.3em] text-gray-400 uppercase transition-all hover:text-blue-600"
      >
        <div
          class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-50 transition-all group-hover:bg-blue-600 group-hover:text-white dark:bg-gray-900"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </div>
        Back to Home
      </a>
    </div>
  </Fragment>
</DetailLayout>

<!-- Print Optimization Styles -->
<style>
  @media print {
    /* Page setup */
    @page {
      margin: 1.5cm;
    }

    /* Hide navigation elements */
    nav,
    footer,
    .print\:hidden,
    .absolute {
      display: none !important;
    }

    /* Clean header */
    header {
      background: white !important;
      padding: 2rem 0 !important;
      border: none !important;
    }

    header .z-10 {
      color: black !important;
    }

    h1 {
      color: black !important;
      font-size: 3rem !important;
    }

    /* Clean content */
    main {
      background: white !important;
    }

    article {
      color: #1f2937 !important;
    }
  }
</style>
