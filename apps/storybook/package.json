{
  "name": "@aazucena/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "dev": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "preview": "serve storybook-static",
    "chromatic": "chromatic",
    "test": "vitest run",
    "test:ci": "STORYBOOK_VITEST=1 NODE_OPTIONS='--max-old-space-size=6144' vitest run",
    "test:storybook": "vitest --project=storybook"
  },
  "peerDependencies": {
    "storybook": "^10.3.6"
  },
  "dependencies": {
    "@aazucena/animations": "workspace:*",
    "@aazucena/constants": "workspace:*",
    "@aazucena/context": "workspace:*",
    "@aazucena/design-system": "workspace:*",
    "@aazucena/forms": "workspace:*",
    "@aazucena/hooks": "workspace:*",
    "@aazucena/icons": "workspace:*",
    "@aazucena/layouts": "workspace:*",
    "@aazucena/ui": "workspace:*",
    "@aazucena/utils": "workspace:*",
    "@aazucena/visualizations": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@aazucena/config": "workspace:*",
    "@aazucena/types": "workspace:*",
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-styling-webpack": "^3.0.1",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/builder-vite": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "chromatic": "^11.21.0",
    "eslint": "^9.39.4",
    "eslint-plugin-storybook": "^10.6.7",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "remark-gfm": "^4.0.1",
    "serve": "^14.2.7",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.2"
  }
}
