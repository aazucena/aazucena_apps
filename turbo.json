{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "release": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e": {
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "dependsOn": ["^build"]
    },
    "build:storybook": {
      "dependsOn": ["^build:storybook"],
      "outputs": ["storybook-static/**"]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "**/*",
        "!test/**/*",
        "!e2e/**/*",
        "!performance/**/*",
        "!.astro/**/*",
        "!.cache/**/*",
        "!mod.js",
        "!mod.js.map"
      ],
      "passThroughEnv": [
        "STRAPI_API_ENDPOINT",
        "STRAPI_URL",
        "STRAPI_TOKEN",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": true
    },
    "format:check": {
      "cache": true
    },
    "type-check": {
      "dependsOn": [
        "^type-check"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
