{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "release": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e": {
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "dependsOn": ["^build"]
    },
    "build:storybook": {
      "dependsOn": ["^build", "^build:storybook"],
      "outputs": ["storybook-static/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "**/*",
        "!test/**/*",
        "!e2e/**/*",
        "!performance/**/*",
        "!.astro/**/*",
        "!.cache/**/*",
        "!mod.js",
        "!mod.js.map"
      ],
      "passThroughEnv": [
        "STRAPI_API_ENDPOINT", "STRAPI_URL", "STRAPI_TOKEN", "SENTRY_AUTH_TOKEN",
        "INTEL_ENGINE_URL", "INTEL_ENGINE_API_KEY",
        "MAINTENANCE_MODE", "PREVIEW_TOKEN",
        "PUBLIC_SENTRY_DSN", "PUBLIC_SENTRY_PROJECT", "PUBLIC_SENTRY_ORG",
        "PUBLIC_PLAUSIBLE_DOMAIN", "PUBLIC_PLAUSIBLE_API_HOST"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": true
    },
    "format:check": {
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
