{
  "name": "aazucena",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "web:dev": "pnpm dev --filter *portfolio*",
    "cms:dev": "pnpm dev --filter *cms*",
    "analytics:dev": "pnpm dev --filter *analytics*",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,md,json,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "turbo": "^2.4.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry-internal/node-cpu-profiler",
      "core-js-pure",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "react-reconciler": "0.34.0-canary-71b3a03c-20251021"
    }
  }
}
