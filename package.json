{
  "name": "aazucena",
  "private": true,
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "build": "turbo build",
    "dev": "turbo dev",
    "type-check": "turbo type-check",
    "type-check:packages": "turbo type-check --filter=\"./packages/*\"",
    "web:dev": "pnpm dev --filter *portfolio*",
    "cms:dev": "pnpm dev --filter *cms*",
    "storybook:dev": "pnpm dev --filter *storybook*",
    "analytics:dev": "pnpm dev --filter *analytics*",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "format:packages": "pnpm format --filter=\"./packages/*\"",
    "format:check:packages": "turbo format:check --filter=\"./packages/*\"",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:packages": "pnpm lint --filter=\"./packages/*\"",
    "prepare": "husky",
    "pre-commit": "turbo lint type-check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mjsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,md,json,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
