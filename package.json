{
  "name": "aazucena",
  "private": true,
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "build": "turbo build",
    "dev": "turbo dev",
    "type-check": "turbo type-check",
    "type-check:packages": "turbo type-check --filter=\"./packages/*\"",
    "web:dev": "pnpm dev --filter *portfolio*",
    "cms:dev": "pnpm dev --filter *cms*",
    "storybook:dev": "pnpm dev --filter *storybook*",
    "analytics:dev": "pnpm dev --filter *analytics*",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "format:packages": "pnpm format --filter=\"./packages/*\"",
    "format:check:packages": "turbo format:check --filter=\"./packages/*\"",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:packages": "pnpm lint --filter=\"./packages/*\"",
    "changelog": "git-cliff --output CHANGELOG.md",
    "prepare": "husky",
    "pre-commit": "turbo lint type-check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mjsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,md,json,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.10.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry-internal/node-cpu-profiler",
      "core-js-pure",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react-reconciler": "0.34.0-canary-71b3a03c-20251021",
      "@strapi/design-system": "2.2.0",
      "esbuild": "^0.27.0",
      "path-to-regexp@>=6.0.0 <6.3.0": "^6.3.0",
      "lodash@<4.18.0": "^4.18.0",
      "@babel/plugin-transform-modules-systemjs@>=7.0.0 <7.29.4": "^7.29.4",
      "devalue@>=5.0.0 <5.9.3": "^5.9.3",
      "brace-expansion@<1.1.20": "^1.1.20",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "ip-address@>=10.0.0 <10.3.1": "^10.3.1",
      "svgo@>=4.0.0 <4.1.0": "^4.1.0",
      "smol-toml@<1.7.1": "^1.7.1",
      "proxy-addr@<2.0.8": "^2.0.8",
      "compression@<1.8.2": "^1.8.2",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "dompurify@>=3.0.0 <3.4.17": "^3.4.17",
      "ckeditor5@<48.5.1": "^48.5.1",
      "@ckeditor/ckeditor5-engine@<48.5.1": "^48.5.1",
      "@apollo/server@<5.5.0": "^5.5.0"
    }
  }
}
